<div class="container-fluid">
  <div class="card">
    <div class="card-header bg-primary d-flex align-items-center">
      <h4 class="text-white mb-0"><i class="fa fa-adjust me-2"></i> Ajustes de Comissão</h4>
      <div class="ms-auto d-flex gap-2">
        <%= link_to detect_cancelled_collaborators_backoffice_commission_adjustments_path,
            method: :post, class: "btn btn-warning",
            data: { confirm: 'Verificar vendas canceladas e criar ajustes automáticos?' } do %>
          <i class="fa fa-search me-1"></i> Detectar Cancelamentos
        <% end %>
        <%= link_to new_collaborators_backoffice_commission_adjustment_path, class: "btn btn-light" do %>
          <i class="fa fa-plus me-1"></i> Ajuste Manual
        <% end %>
      </div>
    </div>
    <div class="card-body">

  <!-- Filtros -->
  <div class="card shadow-sm mb-3">
    <div class="card-body py-2">
      <%= form_with(url: collaborators_backoffice_commission_adjustments_path, method: :get, local: true) do |f| %>
        <div class="row g-2 align-items-end">
          <div class="col-md-3">
            <%= f.label :cod_funcionario, "Vendedor", class: "form-label small mb-0" %>
            <%= f.select :cod_funcionario,
                  @funcionarios.map { |func| [func.pessoa_nome || func.usuario, func.cod_funcionario] },
                  { include_blank: 'Todos', selected: params[:cod_funcionario] },
                  class: "form-select form-select-sm" %>
          </div>
          <div class="col-md-2">
            <%= f.label :status, "Status", class: "form-label small mb-0" %>
            <%= f.select :status,
                  [['Pendente', 'pending'], ['Aplicado', 'applied'], ['Cancelado', 'cancelled']],
                  { include_blank: 'Todos', selected: params[:status] },
                  class: "form-select form-select-sm" %>
          </div>
          <div class="col-md-2 d-flex gap-1 align-items-end">
            <%= f.submit "Filtrar", class: "btn btn-sm btn-outline-primary" %>
            <%= link_to "Limpar", collaborators_backoffice_commission_adjustments_path, class: "btn btn-sm btn-outline-secondary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <% if @adjustments.any? %>
    <div class="card shadow-sm">
      <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Vendedor</th>
              <th>Tipo</th>
              <th>Motivo</th>
              <th class="text-end">Valor</th>
              <th class="text-center">Direção</th>
              <th class="text-center">Status</th>
              <th class="text-center">Data</th>
              <th class="text-center">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @adjustments.each do |adj| %>
              <tr>
                <td><%= adj.funcionario_nome %></td>
                <td>
                  <% case adj.adjustment_type %>
                  <% when 'cancelled_sale' %>
                    <span class="badge bg-danger">Venda Cancelada</span>
                  <% when 'manual' %>
                    <span class="badge bg-secondary">Manual</span>
                  <% when 'sale_change' %>
                    <span class="badge bg-warning text-dark">Alteração</span>
                  <% end %>
                </td>
                <td class="small"><%= truncate(adj.reason, length: 50) %></td>
                <td class="text-end fw-bold"><%= number_to_currency(adj.amount, unit: 'R$ ', separator: ',', delimiter: '.') %></td>
                <td class="text-center">
                  <span class="badge bg-<%= adj.debit? ? 'danger' : 'success' %>">
                    <%= adj.debit? ? 'Débito' : 'Crédito' %>
                  </span>
                </td>
                <td class="text-center">
                  <% case adj.status %>
                  <% when 'pending' %>
                    <span class="badge bg-warning text-dark">Pendente</span>
                  <% when 'applied' %>
                    <span class="badge bg-success">Aplicado</span>
                  <% when 'cancelled' %>
                    <span class="badge bg-secondary">Cancelado</span>
                  <% end %>
                </td>
                <td class="text-center"><%= adj.created_at.strftime('%d/%m/%Y') %></td>
                <td class="text-center">
                  <% if adj.pending? %>
                    <%= link_to cancel_collaborators_backoffice_commission_adjustment_path(adj),
                        method: :post, class: "btn btn-sm btn-outline-danger",
                        data: { confirm: 'Cancelar este ajuste?' } do %>
                      <i class="fa fa-times"></i>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="mt-3 d-flex justify-content-center">
      <%= paginate @adjustments %>
    </div>
  <% else %>
    <div class="text-center py-5 text-muted">
      <i class="fa fa-adjust fa-3x mb-3"></i>
      <p>Nenhum ajuste encontrado.</p>
    </div>
  <% end %>
    </div>
  </div>
</div>
