<div class="container-fluid mt-3">

  <%# ---- Cabecalho + filtro de periodo ---- %>
  <div class="d-flex flex-wrap align-items-center mb-3 gap-2">
    <h3 class="mb-0"><i class="fa fa-file-invoice me-2"></i>Painel Fiscal</h3>
    <% if @homologacao %>
      <span class="badge bg-warning text-dark ms-2">
        <i class="fa fa-triangle-exclamation me-1"></i> Ambiente de HOMOLOGAÇÃO (notas sem valor fiscal)
      </span>
    <% end %>
    <%= form_with url: collaborators_backoffice_fiscal_dashboard_path, method: :get, local: true,
                  class: "ms-auto d-flex align-items-end gap-2" do %>
      <div>
        <label class="form-label mb-0 small">Início</label>
        <%= date_field_tag :inicio, @inicio, class: "form-control form-control-sm" %>
      </div>
      <div>
        <label class="form-label mb-0 small">Fim</label>
        <%= date_field_tag :fim, @fim, class: "form-control form-control-sm" %>
      </div>
      <button type="submit" class="btn btn-sm btn-primary"><i class="fa fa-filter me-1"></i>Filtrar</button>
    <% end %>
  </div>

  <%# ---- Cartoes de resumo (clicaveis -> relatorios filtrados) ---- %>
  <%
    di_br = @inicio.strftime('%d/%m/%Y'); df_br = @fim.strftime('%d/%m/%Y')
    di_iso = @inicio.strftime('%Y-%m-%d'); df_iso = @fim.strftime('%Y-%m-%d')
  %>
  <div class="row g-3 mb-3">
    <div class="col-md-3">
      <%= link_to collaborators_backoffice_notas_avulsas_path(tipo: 55, status: 'autorizada', dataInicial: di_br, dataFinal: df_br),
                  class: "text-decoration-none" do %>
        <div class="card border-start border-4 border-success h-100">
          <div class="card-body">
            <div class="text-muted small">NF-e autorizadas</div>
            <div class="h3 mb-0">R$ <%= number_with_precision(@valor_nfe, precision: 2, separator: ",", delimiter: ".") %></div>
            <div class="small text-muted"><%= @qtd_nfe %> nota(s)</div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="col-md-3">
      <%= link_to collaborators_backoffice_notas_avulsas_path(tipo: 65, status: 'autorizada', dataInicial: di_br, dataFinal: df_br),
                  class: "text-decoration-none" do %>
        <div class="card border-start border-4 border-info h-100">
          <div class="card-body">
            <div class="text-muted small">NFC-e autorizadas</div>
            <div class="h3 mb-0">R$ <%= number_with_precision(@valor_nfce, precision: 2, separator: ",", delimiter: ".") %></div>
            <div class="small text-muted"><%= @qtd_nfce %> nota(s)</div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="col-md-3">
      <%# Um unico cartao com duas metades clicaveis: Todas | Faturadas (ja viraram compra). %>
      <div class="card border-start border-4 border-warning h-100">
        <div class="card-body">
          <div class="text-muted small">Notas recebidas no período</div>
          <div class="d-flex justify-content-between gap-2">
            <%= link_to collaborators_backoffice_notas_recebidas_path(inicio: di_iso, fim: df_iso, tipo: ''),
                        class: "text-decoration-none text-reset", title: "Ver todas as notas recebidas" do %>
              <div class="h4 mb-0">R$ <%= number_with_precision(@valor_compras_nf, precision: 2, separator: ",", delimiter: ".") %></div>
              <div class="small text-muted"><%= @qtd_compras_nf %> todas</div>
            <% end %>
            <%= link_to collaborators_backoffice_notas_recebidas_path(inicio: di_iso, fim: df_iso, tipo: '', integrado: '1'),
                        class: "text-decoration-none text-reset text-end", title: "Ver só as faturadas (já viraram compra)" do %>
              <div class="h4 mb-0">R$ <%= number_with_precision(@valor_receb_faturadas, precision: 2, separator: ",", delimiter: ".") %></div>
              <div class="small text-muted"><%= @qtd_receb_faturadas %> faturadas</div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <%= link_to collaborators_backoffice_notas_avulsas_path(status: 'problema', dataInicial: di_br, dataFinal: df_br),
                  class: "text-decoration-none" do %>
        <div class="card border-start border-4 border-danger h-100">
          <div class="card-body">
            <div class="text-muted small">Rejeitadas / erro</div>
            <div class="h3 mb-0"><%= @qtd_problema %></div>
            <div class="small text-muted"><%= @qtd_cancel %> cancelada(s) no período</div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="row g-3">
    <%# ---- Grafico ---- %>
    <div class="col-lg-8">
      <div class="card h-100">
        <div class="card-header">
          <strong>Emissões / Recebimentos por dia</strong>
          <span class="small text-muted">
            (<%= l @inicio, format: :long rescue @inicio %> a <%= l @fim, format: :long rescue @fim %>) —
            emitido: R$ <%= number_with_precision(@valor_autorizado, precision: 2, separator: ",", delimiter: ".") %> ·
            recebido (faturadas): R$ <%= number_with_precision(@valor_recebido_faturadas, precision: 2, separator: ",", delimiter: ".") %>
          </span>
        </div>
        <div class="card-body">
          <canvas id="graficoEmissoes" height="110"></canvas>
        </div>
      </div>
    </div>

    <%# ---- Status SEFAZ ---- %>
    <div class="col-lg-4">
      <div class="card h-100">
        <div class="card-header d-flex align-items-center">
          <strong><i class="fa fa-tower-broadcast me-2"></i>Status da SEFAZ</strong>
          <div class="ms-auto d-flex gap-2">
            <select id="statusModelo" class="form-select form-select-sm" style="width:auto;">
              <option value="55">NF-e</option>
              <option value="65">NFC-e</option>
            </select>
            <button id="btnStatusSefaz" type="button" class="btn btn-sm btn-outline-primary">Verificar</button>
          </div>
        </div>
        <div class="card-body">
          <div id="statusSefazResultado" class="text-muted small">
            Clique em <em>Verificar</em> para consultar a disponibilidade (produção).
          </div>
          <hr>
          <div class="d-grid gap-2">
            <%= link_to new_collaborators_backoffice_notas_avulsa_path(modelo: 55), class: "btn btn-sm btn-outline-success" do %>
              <i class="fa fa-file-circle-plus me-1"></i> Emitir NF avulsa
            <% end %>
            <% if access_control.can_view?('notas_recebidas') %>
              <%= link_to collaborators_backoffice_notas_recebidas_path, class: "btn btn-sm btn-outline-warning" do %>
                <i class="fa fa-inbox me-1"></i> Notas Recebidas
              <% end %>
            <% end %>
            <% if access_control.can_view?('fiscal_estoque') %>
              <%= link_to collaborators_backoffice_report_estoque_fiscal_index_path, class: "btn btn-sm btn-outline-primary" do %>
                <i class="fa fa-boxes-stacked me-1"></i> Relatório de estoque fiscal
              <% end %>
            <% end %>
            <%= link_to collaborators_backoffice_pacotes_fiscais_path, class: "btn btn-sm btn-outline-secondary" do %>
              <i class="fa fa-box-archive me-1"></i> Pacotes XML
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ---- Alertas: pendencias e problemas ---- %>
  <% if @pendentes.any? || @com_problema.any? %>
    <div class="row g-3 mt-1">
      <% if @pendentes.any? %>
        <div class="col-md-6">
          <div class="card border-warning">
            <div class="card-header bg-warning-subtle">
              <strong><i class="fa fa-clock me-1"></i> Em processamento há mais de 30 min (<%= @pendentes.size %>)</strong>
            </div>
            <ul class="list-group list-group-flush">
              <% @pendentes.each do |d| %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                  <span>
                    <%= d.modelo_nome %> <%= d.numero.present? ? "nº #{d.numero}" : "(sem número)" %>
                    <span class="badge bg-secondary"><%= d.status %></span>
                    <small class="text-muted d-block"><%= l d.created_at, format: :short rescue d.created_at %></small>
                  </span>
                  <% if d.cod_venda.present? %>
                    <%= button_to "Atualizar", reconciliar_collaborators_backoffice_venda_documento_fiscal_path(d.cod_venda, d),
                                  method: :post, class: "btn btn-sm btn-outline-secondary", form: { class: "d-inline" } %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
      <% if @com_problema.any? %>
        <div class="col-md-6">
          <div class="card border-danger">
            <div class="card-header bg-danger-subtle">
              <strong><i class="fa fa-circle-exclamation me-1"></i> Com rejeição/erro (<%= @com_problema.size %>)</strong>
            </div>
            <ul class="list-group list-group-flush">
              <% @com_problema.each do |d| %>
                <li class="list-group-item">
                  <div class="d-flex justify-content-between">
                    <span>
                      <%= d.modelo_nome %> <%= d.numero.present? ? "nº #{d.numero}" : "" %>
                      <span class="badge bg-danger"><%= d.status %></span>
                    </span>
                    <small class="text-muted"><%= l d.created_at, format: :short rescue d.created_at %></small>
                  </div>
                  <% if d.mensagem_sefaz.present? %>
                    <small class="text-muted d-block" style="white-space: normal;"><%= d.mensagem_sefaz %></small>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ---- Ultimos documentos ---- %>
  <div class="card mt-3">
    <div class="card-header"><strong>Últimos documentos</strong></div>
    <div class="table-responsive">
      <table class="table table-sm table-striped mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>Modelo</th><th>Número</th><th>Natureza</th><th>Origem</th>
            <th class="text-end">Valor</th><th>Status</th><th>Emitido</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% @ultimos.each do |d| %>
            <%# Linha clicavel: em elaboracao (rascunho/erro) abre o editor; %>
            <%# demais abrem a visualizacao. %>
            <% abrir_url = %w[rascunho erro].include?(d.status) ?
                 edit_collaborators_backoffice_notas_avulsa_path(d) :
                 collaborators_backoffice_notas_avulsa_path(d) %>
            <tr class="doc-row" style="cursor:pointer;" data-href="<%= abrir_url %>">
              <td><%= d.modelo_nome %></td>
              <td><%= d.numero %></td>
              <td><%= d.natureza_operacao %></td>
              <td>
                <% if d.cod_venda.present? %>Venda #<%= d.venda&.cod_vendaempresa || d.cod_venda %>
                <% elsif d.cod_compra.present? %>Devol. compra #<%= d.cod_compra %>
                <% else %>Avulsa<% end %>
              </td>
              <td class="text-end">R$ <%= number_with_precision(d.valor_total, precision: 2, separator: ",", delimiter: ".") %></td>
              <td>
                <% cls = { "autorizada" => "success", "cancelada" => "dark", "rejeitada" => "danger",
                           "erro" => "danger", "denegada" => "danger", "enviada" => "info", "rascunho" => "secondary" }[d.status] || "secondary" %>
                <span class="badge bg-<%= cls %>"><%= d.status %></span>
              </td>
              <td><%= (l(d.emitido_em || d.created_at, format: :short) rescue (d.emitido_em || d.created_at)) %></td>
              <%# Dropdown de acoes (nao propaga o clique da linha). %>
              <td class="text-end" onclick="event.stopPropagation();">
                <div class="dropdown">
                  <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                          data-bs-toggle="dropdown" aria-expanded="false">Ações</button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                      <%= link_to "Visualizar NF", collaborators_backoffice_notas_avulsa_path(d),
                                  class: "dropdown-item" %>
                    </li>
                    <% if %w[rascunho erro].include?(d.status) %>
                      <li>
                        <%= link_to "Editar", edit_collaborators_backoffice_notas_avulsa_path(d),
                                    class: "dropdown-item" %>
                      </li>
                    <% end %>
                    <% if d.autorizada? && d.danfe_base64.present? %>
                      <li>
                        <%= link_to "DANFE", danfe_collaborators_backoffice_notas_avulsa_path(d),
                                    target: "_blank", class: "dropdown-item" %>
                      </li>
                    <% end %>
                  </ul>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @ultimos.empty? %>
            <tr><td colspan="8" class="text-center text-muted py-3">Nenhum documento fiscal ainda.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
  (function () {
    // ---- Grafico de emissoes por dia (empilhado por status) ----
    var dados = <%= raw({ labels: @serie[:labels], autorizada: @serie[:autorizada],
                          cancelada: @serie[:cancelada], problema: @serie[:problema],
                          recebida: @serie[:recebida], recebida_valor: @serie[:recebida_valor],
                          dias_br: @serie[:dias_br] }.to_json) %>;
    var REPORT_BUY_URL = "<%= collaborators_backoffice_report_buy_path %>";
    var IDX_RECEBIDAS = 3; // posicao do dataset "Recebidas (faturadas)" abaixo
    function brl(v) { return 'R$ ' + Number(v || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
    var ctx = document.getElementById('graficoEmissoes');
    if (ctx && window.Chart) {
      new Chart(ctx, {
        type: 'bar',
        data: {
          labels: dados.labels,
          datasets: [
            { label: 'Autorizadas', data: dados.autorizada, backgroundColor: '#198754' },
            { label: 'Canceladas',  data: dados.cancelada,  backgroundColor: '#212529' },
            { label: 'Rejeit./erro', data: dados.problema,  backgroundColor: '#dc3545' },
            // Recebimentos (faturadas, no dia da compra): valores NEGATIVOS para
            // as barras irem para baixo do eixo; o rotulo/tooltip mostram o valor absoluto.
            { label: 'Recebidas (faturadas)', data: dados.recebida.map(function (v) { return -v; }), backgroundColor: '#fd7e14' }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: { stacked: true, grid: { display: false } }, // sem linhas verticais
            y: { stacked: true, beginAtZero: true,
                 ticks: { precision: 0, callback: function (v) { return Math.abs(v); } },
                 // Linha divisoria no zero: separa emissoes (cima) de recebimentos (baixo).
                 grid: {
                   color: function (ctx) { return ctx.tick && ctx.tick.value === 0 ? '#adb5bd' : 'rgba(0,0,0,0.08)'; },
                   lineWidth: function (ctx) { return ctx.tick && ctx.tick.value === 0 ? 2 : 1; }
                 } }
          },
          // Cursor de "link" ao passar sobre a barra de recebidas.
          onHover: function (evt, els) {
            var sobreRecebida = els.length && els[0].datasetIndex === IDX_RECEBIDAS;
            evt.native.target.style.cursor = sobreRecebida ? 'pointer' : 'default';
          },
          // Clique na barra de recebidas: abre o report_buy filtrado naquele dia.
          onClick: function (evt, els) {
            if (!els.length || els[0].datasetIndex !== IDX_RECEBIDAS) return;
            var dia = dados.dias_br[els[0].index];
            if (!dia) return;
            window.location.href = REPORT_BUY_URL + '?dataInicial=' + encodeURIComponent(dia) +
                                   '&dataFinal=' + encodeURIComponent(dia);
          },
          plugins: {
            legend: { position: 'bottom' },
            tooltip: {
              callbacks: {
                label: function (c) {
                  if (c.datasetIndex === IDX_RECEBIDAS) {
                    // quantidade + valor das compras do dia (faturadas)
                    return c.dataset.label + ': ' + Math.abs(c.parsed.y) + ' nota(s) · ' + brl(dados.recebida_valor[c.dataIndex]);
                  }
                  return c.dataset.label + ': ' + Math.abs(c.parsed.y);
                },
                footer: function (items) {
                  var r = items.find(function (i) { return i.datasetIndex === IDX_RECEBIDAS; });
                  return r ? 'Clique para ver as compras do dia' : '';
                }
              }
            }
          }
        }
      });
    }

    // ---- Status SEFAZ (reusa o endpoint JSON da config fiscal) ----
    var btn = document.getElementById('btnStatusSefaz');
    var sel = document.getElementById('statusModelo');
    var out = document.getElementById('statusSefazResultado');
    var url = "<%= status_sefaz_collaborators_backoffice_fiscal_config_path %>";
    if (btn) {
      btn.addEventListener('click', function () {
        btn.disabled = true;
        out.className = 'text-muted small';
        out.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> Consultando...';
        fetch(url + '?modelo=' + encodeURIComponent(sel.value), { headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            var badge = d.operante
              ? '<span class="badge bg-success">Operante</span>'
              : '<span class="badge bg-danger">Indisponível</span>';
            out.className = 'small';
            out.innerHTML = badge + ' ' + [d.mensagem, d.uf].filter(Boolean).join(' — ');
          })
          .catch(function () { out.className = 'text-danger small'; out.textContent = 'Falha ao consultar.'; })
          .finally(function () { btn.disabled = false; });
      });
    }

    // ---- Linha de documento clicavel: abre o editor (rascunho) ou a NF ----
    document.querySelectorAll('.doc-row').forEach(function (row) {
      row.addEventListener('click', function () {
        var href = row.getAttribute('data-href');
        if (href) window.location.href = href;
      });
    });
  })();
</script>
