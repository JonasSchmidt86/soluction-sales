<%# Widget: Top Produtos (Mês) %>
<% data = @dashboard_data.fetch('top_produtos') %>
<% cor = local_assigns.fetch(:cor, 'success') %>
<% produtos = data[:produtos].to_a %>
<div class="card bg-light h-100 border-<%= cor %>">
  <div class="card-body">
    <h6 class="card-title text-<%= cor %> text-center mb-3">
      <%= link_to collaborators_backoffice_report_mais_vendidos_path, class: "text-#{cor} text-decoration-none", title: "Ver produtos mais vendidos" do %>
        <i class="fa fa-ranking-star"></i> Produtos Mais Vendidos (Mês)
      <% end %>
    </h6>
    <% if produtos.any? %>
      <div class="list-group list-group-flush widget-scroll">
        <% produtos.each_with_index do |produto, index| %>
          <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0 bg-transparent">
            <span class="text-truncate" style="max-width: 78%;">
              <span class="badge bg-<%= ['primary', 'success', 'info', 'warning', 'danger'][index] || 'secondary' %> me-2"><%= index + 1 %></span>
              <%= truncate(produto.nome, length: 30) %>
            </span>
            <span class="badge bg-light text-dark text-nowrap"><%= produto.total_vendido.to_i %> un.</span>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center mt-3">
        <p class="text-muted mb-0">Sem vendas no mês</p>
      </div>
    <% end %>
  </div>
</div>
