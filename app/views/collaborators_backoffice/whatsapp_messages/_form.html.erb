<div class="card mt-3 shadow">
  <div class="card-header bg-primary text-white d-flex align-items-center">
    <h4 class="mb-0">
      <i class="fab fa-whatsapp"></i>
      <%= @whatsapp_message.new_record? ? "Nova Mensagem" : "Editando Mensagem" %>
    </h4>
    <%= link_to 'Voltar', collaborators_backoffice_whatsapp_messages_path, class: 'btn btn-light ms-auto' %>
  </div>

  <div class="card-body">
    <% if @whatsapp_message.errors.any? %>
      <div class="alert alert-danger">
        <strong>Não foi possível salvar:</strong>
        <ul class="mb-0">
          <% @whatsapp_message.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @whatsapp_message,
                  url: (@whatsapp_message.new_record? ?
                        collaborators_backoffice_whatsapp_messages_path :
                        collaborators_backoffice_whatsapp_message_path(@whatsapp_message)),
                  method: (@whatsapp_message.new_record? ? :post : :patch),
                  local: true do |f| %>

      <div class="row g-3">
        <div class="col-md-8">
          <label class="form-label">Título <span class="text-danger">*</span></label>
          <%= f.text_field :titulo, class: "form-control",
                           placeholder: "Ex.: Feliz aniversário com desconto" %>
          <div class="form-text">Nome curto que aparece no menu ao clicar no ícone do WhatsApp.</div>
        </div>

        <div class="col-md-2">
          <label class="form-label">Ordem</label>
          <%= f.number_field :ordem, class: "form-control", min: 0 %>
          <div class="form-text">Ordem no menu.</div>
        </div>

        <div class="col-md-2 d-flex align-items-center">
          <div class="form-check mt-4">
            <%= f.check_box :ativo, class: "form-check-input" %>
            <label class="form-check-label" for="whatsapp_message_ativo">Ativa</label>
          </div>
        </div>

        <div class="col-12">
          <label class="form-label">Mensagem <span class="text-danger">*</span></label>
          <%= f.text_area :mensagem, class: "form-control", rows: 12,
                          placeholder: "Digite a mensagem. Pode usar emojis 🎉 e quebras de linha." %>
          <div class="form-text">
            Marcadores disponíveis (são trocados automaticamente ao enviar):
            <% WhatsappMessage::PLACEHOLDERS.each do |chave, descricao| %>
              <code class="ms-1">&#123;&#123;<%= chave %>&#125;&#125;</code>
              <span class="text-muted small">= <%= descricao %>;</span>
            <% end %>
          </div>
        </div>
      </div>

      <div class="mt-4 d-flex gap-2">
        <%= f.submit (@whatsapp_message.new_record? ? "Criar mensagem" : "Salvar alterações"), class: "btn btn-primary" %>
        <%= link_to 'Cancelar', collaborators_backoffice_whatsapp_messages_path, class: 'btn btn-outline-secondary' %>
      </div>
    <% end %>
  </div>
</div>
