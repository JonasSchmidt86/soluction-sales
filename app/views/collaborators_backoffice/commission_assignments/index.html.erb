<div class="container-fluid">
  <div class="card">
    <div class="card-header bg-primary d-flex align-items-center">
      <h4 class="text-white mb-0"><i class="fa fa-link me-2"></i> Atribuições de Regras</h4>
      <div class="ms-auto">
        <%= link_to new_collaborators_backoffice_commission_assignment_path, class: "btn btn-light" do %>
          <i class="fa fa-plus me-1"></i> Nova Atribuição
        <% end %>
      </div>
    </div>
    <div class="card-body">

  <!-- Filtro -->
  <div class="card shadow-sm mb-3">
    <div class="card-body py-2">
      <%= form_with(url: collaborators_backoffice_commission_assignments_path, method: :get, local: true) do |f| %>
        <div class="row g-2 align-items-end">
          <div class="col-md-4">
            <%= f.label :cod_funcionario, "Vendedor", class: "form-label small mb-0" %>
            <%= f.select :cod_funcionario,
                  @funcionarios.map { |func| [func.pessoa_nome || func.usuario, func.cod_funcionario] },
                  { include_blank: 'Todos', selected: params[:cod_funcionario] },
                  class: "form-select form-select-sm" %>
          </div>
          <div class="col-md-2 d-flex gap-1 align-items-end">
            <%= f.submit "Filtrar", class: "btn btn-sm btn-outline-primary" %>
            <%= link_to "Limpar", collaborators_backoffice_commission_assignments_path, class: "btn btn-sm btn-outline-secondary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <% if @assignments.any? %>
    <div class="card shadow-sm">
      <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Vendedor</th>
              <th>Regra</th>
              <th class="text-center">Início</th>
              <th class="text-center">Fim</th>
              <th class="text-center">Status</th>
              <th class="text-center">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @assignments.each do |assign| %>
              <tr>
                <td><%= assign.funcionario_nome %></td>
                <td>
                  <%= link_to assign.commission_rule.name, 
                      collaborators_backoffice_commission_rule_path(assign.commission_rule),
                      class: "text-decoration-none" %>
                </td>
                <td class="text-center"><%= assign.start_date.strftime('%d/%m/%Y') %></td>
                <td class="text-center"><%= assign.end_date ? assign.end_date.strftime('%d/%m/%Y') : '—' %></td>
                <td class="text-center">
                  <span class="badge bg-<%= assign.end_date.nil? ? 'success' : 'secondary' %>">
                    <%= assign.end_date.nil? ? 'Vigente' : 'Encerrada' %>
                  </span>
                </td>
                <td class="text-center">
                  <% if assign.end_date.nil? %>
                    <%= link_to collaborators_backoffice_commission_assignment_path(assign),
                        method: :delete,
                        data: { confirm: 'Deseja encerrar esta atribuição?' },
                        class: "btn btn-sm btn-outline-danger" do %>
                      <i class="fa fa-stop me-1"></i> Encerrar
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="text-center py-5 text-muted">
      <i class="fa fa-link fa-3x mb-3"></i>
      <p>Nenhuma atribuição encontrada.</p>
    </div>
  <% end %>
    </div>
  </div>
</div>
