<div class="card-body">
  <%= form_with(model: [ :collaborators_backoffice, (@produto.nil? ? Produto.new : @produto) ], local: true) do |form| %>

    <%= hidden_field_tag :action_message, local_assigns[:action_message] || '' %>


    <div class="row mb-2">
      <div class="col-md-3">
        <div class="form-floating mb-md-0">
          <%= form.text_field :cod_produto, disabled: true, class: "text form-control", placeholder:"Codigo", id:"text" %>
          <%= form.label :cod_produto, class:"" %>
        </div>
      </div>
      <div class="col-md-3">
        <div class="form-floating mb-3 mb-md-0">
          <%= form.text_field :ucom, class: "text form-control", placeholder:"Unidade", id: "modal_ucom" %>
          <%= form.label :ucom, "Unidade", class:"" %>
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-floating">
          <%= form.collection_select(:cod_margem, Parametro.all.order(:descricao), :cod_parametro, :descricao,
                        {:prompt => 'Selecione uma Margem'}, class: "form-control") %>
          <%= form.label :cod_margem, "Margem", class:"" %>
        </div>
      </div>
    </div>

    <div class="form-floating mb-2">
      <%= form.text_field :nome, class: "text form-control", placeholder:"Produto", id: "modal_nome" %>
      <%= form.label :nome, "Nome", class:"" %>
    </div>

    <div class="row mb-2">
      <div class="col-md-6">
        <div class="form-floating mb-3 mb-md-0">
          <%= form.collection_select(:marca, getBrands("%"), :cod_marca, :nome,
                {:prompt => 'Selecione uma Marca'}, class: "form-control", id:"modal_brands") %>
          <%= form.label :marca, "Marca", class:"" %>
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-floating">
          <%= form.collection_select(:grupo, Grupo.all.order(:nomegrupo), :cod_grupo, :nomegrupo,
                        {:prompt => 'Selecione um Grupo'}, class: "form-control") %>
          <%= form.label :grupo, "Grupo", class:"" %>
        </div>
      </div>
    </div>

    <%# ===== Dados Fiscais ===== %>
    <h6 class="text-uppercase text-muted fw-bold border-bottom pb-2 mb-2 mt-4">
      <i class="fa fa-file-invoice me-1"></i> Dados Fiscais
    </h6>

    <%# Perfil Tributario: define CFOP/CSOSN/tributos por operacao na emissao.
        Visivel apenas quando o modulo fiscal esta liberado (super_admin). %>
    <% if access_control.can_view?("fiscal_perfis") %>
      <div class="row mb-3">
        <div class="col-md-9">
          <div class="form-floating">
            <%= form.select :cod_perfil_tributario,
                  options_from_collection_for_select(PerfilTributario.ativos.order(:nome), :cod_perfil_tributario, :nome, @produto&.cod_perfil_tributario),
                  { include_blank: "Sem perfil (usa campos abaixo)" },
                  class: "form-control", id: "modal_perfil_tributario" %>
            <%= form.label :cod_perfil_tributario, "Perfil Tributário" %>
          </div>
        </div>
        <div class="col-md-3 d-flex align-items-center">
          <%= link_to collaborators_backoffice_perfis_tributarios_path, target: "_blank", class: "btn btn-outline-primary w-100" do %>
            <i class="fa fa-plus me-1"></i> Perfis
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="row mb-2">
      <div class="col-md-3">
        <div class="form-floating mb-md-0">
          <%= form.text_field :ncm, class: "text form-control", placeholder:"NCM", id: "modal_ncm" %>
          <%= form.label :ncm, "NCM", class:"" %>
        </div>
      </div>
      <div class="col-md-3">
        <div class="form-floating mb-3 mb-md-0">
          <%= form.text_field :cest, class: "text form-control", placeholder:"CEST", id:"modal_cest" %>
          <%= form.label :cest, "CEST", class:"" %>
        </div>
      </div>
      <div class="col-md-3">
        <div class="form-floating mb-3 mb-md-0">
          <%= form.select :origem, options_for_select(origens_para_select, @produto&.origem),
                { include_blank: "Origem" },
                class: "form-control", id: "modal_origem" %>
          <%= form.label :origem, "Origem" %>
        </div>
      </div>
      <div class="col-md-3">
        <div class="form-floating">
          <%= form.text_field :gtin, maxlength: 14, class: "text form-control", placeholder:"GTIN/EAN", id:"modal_gtin" %>
          <%= form.label :gtin, "GTIN" %>
        </div>
      </div>
    </div>

    <div class="mt-4 mb-3 text-end">
      <button onclick="salvarProduto()" class="btn btn-success">
        <i class="fa fa-save me-1"></i> Salvar Produto
      </button>
    </div>
  <% end %>
</div>
