<div class="container-fluid">
  <div class="card">
    <div class="card-header bg-primary d-flex align-items-center">
      <h4 class="text-white mb-0"><i class="fa fa-shield me-2"></i> Perfis de Acesso</h4>
      <div class="ms-auto d-flex gap-2">
        <%= link_to individual_permissions_collaborators_backoffice_access_roles_path, class: "btn btn-warning btn-sm" do %>
          <i class="fa fa-user me-1"></i> Permissões Individuais
        <% end %>
        <%= link_to new_collaborators_backoffice_access_role_path, class: "btn btn-light" do %>
          <i class="fa fa-plus me-1"></i> Novo Perfil
        <% end %>
      </div>
    </div>
    <div class="card-body">
      <% if @access_roles.any? %>
        <div class="row">
          <% @access_roles.each do |role| %>
            <div class="col-md-6 col-lg-4 mb-3">
              <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                  <strong><%= role.name %></strong>
                  <span class="badge bg-<%= role.active? ? 'success' : 'secondary' %>">
                    <%= role.active? ? 'Ativo' : 'Inativo' %>
                  </span>
                </div>
                <div class="card-body">
                  <% if role.description.present? %>
                    <p class="text-muted small mb-2"><%= role.description %></p>
                  <% end %>
                  <div class="small mb-2">
                    <i class="fa fa-key me-1 text-muted"></i>
                    <strong><%= role.access_role_permissions.count %></strong> recurso(s) configurado(s)
                  </div>
                  <div class="small">
                    <i class="fa fa-users me-1 text-muted"></i>
                    <strong><%= role.collaborator_access_roles.count %></strong> colaborador(es) atribuído(s)
                  </div>
                </div>
                <div class="card-footer text-end">
                  <%= link_to collaborators_backoffice_access_role_path(role), class: "btn btn-sm btn-outline-primary" do %>
                    <i class="fa fa-eye me-1"></i> Ver
                  <% end %>
                  <%= link_to edit_collaborators_backoffice_access_role_path(role), class: "btn btn-sm btn-outline-warning" do %>
                    <i class="fa fa-pencil me-1"></i> Editar
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="fa fa-shield fa-3x text-muted mb-3"></i>
          <p class="text-muted">Nenhum perfil de acesso cadastrado.</p>
          <p class="text-muted small">Enquanto nenhum perfil for atribuído, todos os colaboradores continuam acessando o sistema normalmente.</p>
          <%= link_to new_collaborators_backoffice_access_role_path, class: "btn btn-primary" do %>
            <i class="fa fa-plus me-1"></i> Criar primeiro perfil
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
