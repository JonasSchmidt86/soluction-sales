<div class="container-fluid">
  <div class="card">
    <div class="card-header bg-primary d-flex align-items-center">
      <h4 class="text-white mb-0"><i class="fa fa-shield me-2"></i> <%= @access_role.name %></h4>
      <div class="ms-auto d-flex gap-2">
        <%= link_to edit_collaborators_backoffice_access_role_path(@access_role), class: "btn btn-warning btn-sm" do %>
          <i class="fa fa-pencil me-1"></i> Editar
        <% end %>
        <%= link_to collaborators_backoffice_access_roles_path, class: "btn btn-light btn-sm" do %>
          <i class="fa fa-arrow-left me-1"></i> Voltar
        <% end %>
      </div>
    </div>
    <div class="card-body">
      <div class="row">
        <!-- Permissões -->
        <div class="col-md-7">
          <div class="card shadow-sm mb-3">
            <div class="card-header">
              <strong>Permissões Configuradas</strong>
            </div>
            <div class="card-body p-0">
              <% if @permissions.any? %>
                <table class="table table-sm table-striped mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Recurso</th>
                      <th class="text-center">Ver</th>
                      <th class="text-center">Criar</th>
                      <th class="text-center">Editar</th>
                      <th class="text-center">Excluir</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @permissions.each do |perm| %>
                      <tr>
                        <td><%= perm.resource_label %></td>
                        <td class="text-center"><%= perm.can_view ? '<i class="fa fa-check text-success"></i>'.html_safe : '<i class="fa fa-times text-danger"></i>'.html_safe %></td>
                        <td class="text-center"><%= perm.can_create ? '<i class="fa fa-check text-success"></i>'.html_safe : '<i class="fa fa-times text-danger"></i>'.html_safe %></td>
                        <td class="text-center"><%= perm.can_edit ? '<i class="fa fa-check text-success"></i>'.html_safe : '<i class="fa fa-times text-danger"></i>'.html_safe %></td>
                        <td class="text-center"><%= perm.can_delete ? '<i class="fa fa-check text-success"></i>'.html_safe : '<i class="fa fa-times text-danger"></i>'.html_safe %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              <% else %>
                <div class="text-center py-3 text-muted">Nenhuma permissão configurada.</div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Colaboradores Atribuídos -->
        <div class="col-md-5">
          <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between">
              <strong>Colaboradores</strong>
              <span class="badge bg-primary"><%= @assigned.count %></span>
            </div>
            <div class="card-body">
              <!-- Atribuir novo -->
              <%= form_with(url: assign_collaborators_backoffice_access_role_path(@access_role), method: :post, local: true, class: "mb-3") do %>
                <div class="input-group input-group-sm">
                  <select name="cod_funcionario" class="form-select form-select-sm" required>
                    <option value="">Selecione...</option>
                    <% @funcionarios.each do |func| %>
                      <option value="<%= func.cod_funcionario %>"><%= func.pessoa_nome || func.usuario %></option>
                    <% end %>
                  </select>
                  <button type="submit" class="btn btn-success btn-sm">
                    <i class="fa fa-plus"></i> Atribuir
                  </button>
                </div>
              <% end %>

              <% if @assigned.any? %>
                <table class="table table-sm mb-0">
                  <tbody>
                    <% @assigned.each do |assignment| %>
                      <tr>
                        <td><%= assignment.funcionario_nome %></td>
                        <td class="text-end">
                          <%= link_to unassign_collaborators_backoffice_access_role_path(@access_role, assignment_id: assignment.id),
                              method: :delete, class: "btn btn-sm btn-outline-danger",
                              data: { confirm: 'Remover este colaborador do perfil?' } do %>
                            <i class="fa fa-times"></i>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              <% else %>
                <div class="text-center text-muted small">Nenhum colaborador atribuído.</div>
              <% end %>
            </div>
          </div>

          <!-- Info -->
          <div class="card shadow-sm">
            <div class="card-body">
              <dl class="row mb-0 small">
                <dt class="col-6">Status</dt>
                <dd class="col-6">
                  <span class="badge bg-<%= @access_role.active? ? 'success' : 'secondary' %>">
                    <%= @access_role.active? ? 'Ativo' : 'Inativo' %>
                  </span>
                </dd>
                <% if @access_role.description.present? %>
                  <dt class="col-6">Descrição</dt>
                  <dd class="col-6"><%= @access_role.description %></dd>
                <% end %>
                <dt class="col-6">Criado em</dt>
                <dd class="col-6"><%= @access_role.created_at.strftime('%d/%m/%Y %H:%M') %></dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
