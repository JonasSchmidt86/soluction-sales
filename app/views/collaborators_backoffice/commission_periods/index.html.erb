<div class="container-fluid">
  <div class="card">
    <div class="card-header bg-primary d-flex align-items-center">
      <h4 class="text-white mb-0"><i class="fa fa-calculator me-2"></i> Apurações de Comissão</h4>
      <div class="ms-auto">
        <% if current_collaborator.funcionario.permissao&.nivel == 1 %>
          <%= link_to new_collaborators_backoffice_commission_period_path, class: "btn btn-light" do %>
            <i class="fa fa-plus me-1"></i> Nova Apuração
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="card-body">

      <!-- Filtro de mês da simulação (sempre visível) -->
      <div class="card shadow-sm mb-3">
        <div class="card-header bg-light">
          <strong><i class="fa fa-calendar me-1 text-primary"></i> Mês da Apuração</strong>
        </div>
        <div class="card-body py-2">
          <%= form_with(url: collaborators_backoffice_commission_periods_path, method: :get, local: true) do |f| %>
            <%= f.hidden_field :cod_funcionario, value: params[:cod_funcionario] %>
            <%= f.hidden_field :status, value: params[:status] %>
            <div class="row g-2 align-items-end">
              <div class="col-auto">
                <label class="form-label small mb-0">Mês</label>
                <%= f.month_field :mes, value: @sim_month, class: "form-control form-control-sm" %>
              </div>
              <div class="col-auto">
                <%= f.submit "Atualizar", class: "btn btn-sm btn-outline-success" %>
              </div>
              <div class="col-auto d-flex gap-1">
                <%= link_to "Mês passado",
                      collaborators_backoffice_commission_periods_path(
                        mes: Date.today.prev_month.strftime('%Y-%m'),
                        cod_funcionario: params[:cod_funcionario],
                        status: params[:status]
                      ),
                      class: "btn btn-sm btn-outline-primary" %>
                <%= link_to "Mês atual",
                      collaborators_backoffice_commission_periods_path(
                        mes: Date.today.strftime('%Y-%m'),
                        cod_funcionario: params[:cod_funcionario],
                        status: params[:status]
                      ),
                      class: "btn btn-sm btn-outline-secondary" %>
              </div>
              <div class="col-auto ms-auto">
                <span class="text-muted small">
                  Período: <%= @sim_start.strftime('%d/%m/%Y') %> — <%= @sim_end.strftime('%d/%m/%Y') %>
                </span>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Simulação em Tempo Real -->
      <% if @simulations.any? %>
        <div class="card shadow-sm mb-3 border-success">
          <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <strong><i class="fa fa-bolt me-1 text-warning"></i> Estimativa do Período</strong>
            <span class="text-muted small"><%= @sim_start.strftime('%d/%m/%Y') %> — <%= @sim_end.strftime('%d/%m/%Y') %></span>
          </div>
          <div class="card-body p-0">
            <table class="table table-sm table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Vendedor</th>
                  <th>Regra</th>
                  <th class="text-center">Vendas</th>
                  <th class="text-end">Total Vendas</th>
                  <th class="text-end">Comissão</th>
                  <th class="text-end">Ajustes</th>
                  <th class="text-end">Líquido</th>
                  <% if current_collaborator.funcionario.permissao&.nivel == 1 %>
                    <th class="text-center">Ação</th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% @simulations.each do |sim| %>
                  <tr>
                    <td><%= sim[:funcionario_nome] %></td>
                    <td class="small text-muted"><%= sim[:rule_name] %></td>
                    <td class="text-center"><%= sim[:sales_count] %></td>
                    <td class="text-end"><%= number_to_currency(sim[:total_sales], unit: 'R$ ', separator: ',', delimiter: '.') %></td>
                    <td class="text-end"><%= number_to_currency(sim[:commission_amount], unit: 'R$ ', separator: ',', delimiter: '.') %></td>
                    <td class="text-end">
                      <% if sim[:adjustments_amount] > 0 %>
                        <span class="text-danger">-<%= number_to_currency(sim[:adjustments_amount], unit: 'R$ ', separator: ',', delimiter: '.') %></span>
                      <% else %>
                        —
                      <% end %>
                    </td>
                    <td class="text-end fw-bold text-success"><%= number_to_currency(sim[:net_commission], unit: 'R$ ', separator: ',', delimiter: '.') %></td>
                    <% if current_collaborator.funcionario.permissao&.nivel == 1 %>
                      <td class="text-center">
                        <%= link_to quick_create_collaborators_backoffice_commission_periods_path(
                              cod_funcionario: sim[:cod_funcionario],
                              start_date: @sim_start,
                              end_date: @sim_end
                            ), method: :post, class: "btn btn-sm btn-success",
                            data: { confirm: "Criar apuração para #{sim[:funcionario_nome]}?" } do %>
                          <i class="fa fa-check me-1"></i> Apurar
                        <% end %>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
              <% if @simulations.size > 1 %>
                <tfoot class="table-light">
                  <tr class="fw-bold">
                    <td colspan="3" class="text-end">Totais:</td>
                    <td class="text-end"><%= number_to_currency(@simulations.sum { |s| s[:total_sales].to_f }, unit: 'R$ ', separator: ',', delimiter: '.') %></td>
                    <td class="text-end"><%= number_to_currency(@simulations.sum { |s| s[:commission_amount].to_f }, unit: 'R$ ', separator: ',', delimiter: '.') %></td>
                    <td class="text-end">
                      <% total_adj = @simulations.sum { |s| s[:adjustments_amount].to_f } %>
                      <% if total_adj > 0 %>
                        <span class="text-danger">-<%= number_to_currency(total_adj, unit: 'R$ ', separator: ',', delimiter: '.') %></span>
                      <% else %>
                        —
                      <% end %>
                    </td>
                    <td class="text-end text-success"><%= number_to_currency(@simulations.sum { |s| s[:net_commission].to_f }, unit: 'R$ ', separator: ',', delimiter: '.') %></td>
                    <% if current_collaborator.funcionario.permissao&.nivel == 1 %>
                      <td></td>
                    <% end %>
                  </tr>
                </tfoot>
              <% end %>
            </table>
          </div>
        </div>
      <% else %>
        <div class="alert alert-info d-flex align-items-center" role="alert">
          <i class="fa fa-info-circle me-2"></i>
          Nenhuma venda encontrada para o período
          <strong class="mx-1"><%= @sim_start.strftime('%d/%m/%Y') %> — <%= @sim_end.strftime('%d/%m/%Y') %></strong>.
          Ajuste o período acima (ex.: clique em "Mês passado") para gerar as comissões.
        </div>
      <% end %>

      <!-- Filtros das apurações existentes -->
      <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
          <%= form_with(url: collaborators_backoffice_commission_periods_path, method: :get, local: true) do |f| %>
            <div class="row g-2 align-items-end">
              <% if current_collaborator.funcionario.permissao&.nivel == 1 %>
                <div class="col-md-3">
                  <%= f.label :cod_funcionario, "Vendedor", class: "form-label small mb-0" %>
                  <%= f.select :cod_funcionario,
                        @funcionarios.map { |func| [func.pessoa_nome || func.usuario, func.cod_funcionario] },
                        { include_blank: 'Todos', selected: params[:cod_funcionario] },
                        class: "form-select form-select-sm" %>
                </div>
              <% end %>
              <div class="col-md-2">
                <%= f.label :status, "Status", class: "form-label small mb-0" %>
                <%= f.select :status,
                      [['Aberta', 'open'], ['Finalizada', 'finalized'], ['Paga', 'paid']],
                      { include_blank: 'Todos', selected: params[:status] },
                      class: "form-select form-select-sm" %>
              </div>
              <div class="col-md-2 d-flex gap-1 align-items-end">
                <%= f.submit "Filtrar", class: "btn btn-sm btn-outline-primary" %>
                <%= link_to "Limpar", collaborators_backoffice_commission_periods_path, class: "btn btn-sm btn-outline-secondary" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Apurações existentes -->
      <% if @periods.any? %>
        <div class="card shadow-sm">
          <div class="card-header"><strong>Apurações Registradas</strong></div>
          <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Vendedor</th>
                  <th class="text-center">Período</th>
                  <th class="text-end">Total Vendas</th>
                  <th class="text-end">Comissão</th>
                  <th class="text-end">Ajustes</th>
                  <th class="text-end">Líquido</th>
                  <th class="text-center">Status</th>
                  <th class="text-center">Ações</th>
                </tr>
              </thead>
              <tbody>
                <% @periods.each do |period| %>
                  <tr>
                    <td><%= period.funcionario_nome %></td>
                    <td class="text-center">
                      <%= period.start_date.strftime('%d/%m/%Y') %> — <%= period.end_date.strftime('%d/%m/%Y') %>
                    </td>
                    <td class="text-end"><%= period.total_sales ? number_to_currency(period.total_sales, unit: 'R$ ', separator: ',', delimiter: '.') : '—' %></td>
                    <td class="text-end"><%= period.commission_amount ? number_to_currency(period.commission_amount, unit: 'R$ ', separator: ',', delimiter: '.') : '—' %></td>
                    <td class="text-end">
                      <% if period.adjustments_amount && period.adjustments_amount > 0 %>
                        <span class="text-danger">-<%= number_to_currency(period.adjustments_amount, unit: 'R$ ', separator: ',', delimiter: '.') %></span>
                      <% else %>
                        —
                      <% end %>
                    </td>
                    <td class="text-end fw-bold"><%= period.net_commission ? number_to_currency(period.net_commission, unit: 'R$ ', separator: ',', delimiter: '.') : '—' %></td>
                    <td class="text-center">
                      <% case period.status %>
                      <% when 'open' %>
                        <span class="badge bg-warning text-dark">Aberta</span>
                      <% when 'finalized' %>
                        <span class="badge bg-info">Finalizada</span>
                      <% when 'paid' %>
                        <span class="badge bg-success">Paga</span>
                      <% end %>
                    </td>
                    <td class="text-center">
                      <%= link_to collaborators_backoffice_commission_period_path(period), class: "btn btn-sm btn-outline-primary" do %>
                        <i class="fa fa-eye"></i>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <div class="mt-3 d-flex justify-content-center">
          <%= paginate @periods %>
        </div>
      <% else %>
        <div class="text-center py-4 text-muted">
          <p>Nenhuma apuração registrada ainda.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
