<div class="container-fluid">
  <h4 class="mb-3">
    <i class="fa fa-plus me-2"></i> Nova Apuração de Comissão
  </h4>

  <div class="card shadow-sm">
    <%= form_with(model: [:collaborators_backoffice, @period], local: true) do |f| %>
      <div class="card-body">
        <% if @period.errors.any? %>
          <div class="alert alert-danger">
            <% @period.errors.full_messages.each do |msg| %>
              <div><%= msg %></div>
            <% end %>
          </div>
        <% end %>

        <div class="row">
          <div class="col-md-4 mb-3">
            <%= f.label :cod_funcionario, 'Vendedor', class: 'form-label' %>
            <%= f.select :cod_funcionario,
                  @funcionarios.map { |func| [func.pessoa_nome || func.usuario, func.cod_funcionario] },
                  { include_blank: 'Selecione...' },
                  class: "form-select" %>
          </div>
          <div class="col-md-4 mb-3">
            <%= f.label :start_date, 'Data Inicial', class: 'form-label' %>
            <%= f.date_field :start_date, class: 'form-control' %>
          </div>
          <div class="col-md-4 mb-3">
            <%= f.label :end_date, 'Data Final', class: 'form-label' %>
            <%= f.date_field :end_date, class: 'form-control' %>
          </div>
        </div>

        <div class="alert alert-info small">
          <i class="fa fa-info-circle me-1"></i>
          O período não precisa ser mensal. Você pode escolher qualquer intervalo de datas.
          Após criar, clique em "Calcular" para processar as vendas do período.
        </div>
      </div>
      <div class="card-footer text-end">
        <%= link_to collaborators_backoffice_commission_periods_path, class: 'btn btn-secondary me-2' do %>
          <i class="fa fa-arrow-left me-1"></i> Cancelar
        <% end %>
        <%= f.submit 'Criar Apuração', class: 'btn btn-primary' %>
      </div>
    <% end %>
  </div>
</div>
