<div class="card mt-3">
  <div class="card-header text-center bg-primary text-white">
    <h4>Orçamentos</h4>
  </div>
  <div class="card-body">
    <%= form_with url: collaborators_backoffice_orcamentos_path, method: :get, local: true, class: 'row g-2 align-items-center mb-3' do %>
      <%= hidden_field_tag :filtrado, '1' %>
      <div class="col-auto" style="max-width: 90px;">
        <%= select_tag :per_page, options_for_select([30, 40, 70, 150, "Todas"], params[:per_page]),
              onchange: 'this.form.submit()', class: 'form-select form-select-md' %>
      </div>
      <div class="col-auto">
        <%= text_field_tag :data_inicio,
              params[:data_inicio],
              class: 'form-control form-control-md datepicker fallback',
              placeholder: 'Data Inicial',
              style: 'max-width: 120px;',
              autocomplete: 'off' %>
      </div>
      <div class="col-auto">
        <%= text_field_tag :data_fim,
              params[:data_fim],
              class: 'form-control form-control-md datepicker fallback',
              placeholder: 'Data Final',
              style: 'max-width: 120px;',
              autocomplete: 'off' %>
      </div>
      <div class="col-auto">
        <%= select_tag :status,
              options_for_select([
                ['Todos', ''],
                ['Pendente', 'pendente'],
                ['Aprovado', 'aprovado'],
                ['Convertido', 'convertido'],
                ['Rejeitado', 'rejeitado']
              ], @status_selecionado),
              class: 'form-select form-select-md', style: 'max-width: 200px;' %>
      </div>
      <div class="col-auto d-flex gap-2">
        <%= submit_tag 'Filtrar', class: 'btn btn-success', style: 'min-width: 115px;' %>
        <%= link_to 'Limpar', collaborators_backoffice_orcamentos_path, class: 'btn btn-outline-secondary' %>
      </div>
      <div class="col ms-auto d-flex justify-content-end">
        <%= link_to new_collaborators_backoffice_orcamento_path, class: 'btn btn-primary' do %>
          <i class="fa fa-plus"></i> Novo Orçamento
        <% end %>
      </div>
    <% end %>
    <div class="table-responsive">
      <table id="orcamentos-table" class="table table-striped table-hover table-bordered table-sm">
        <thead>
          <tr>
            <th>Código</th>
            <th>Cliente</th>
            <th>Criado por</th>
            <th style="text-align: center;">Data</th>
            <th style="text-align: center;">Validade</th>
            <th style="text-align: center;">Valor Total</th>
            <th style="text-align: center;">Acessos</th>
            <th style="width: 100px;">Status</th>
            <th style="text-align: center;">Link</th>
            <th style="text-align: center;">Ações</th>
          </tr>
        </thead>
        <tbody>
          <% @orcamentos.each do |orcamento| %>
            <% cliente_link = orcamento_publico_url(orcamento, nome_cliente: orcamento.pessoa.nome.to_s.parameterize) %>
            <% mensagem_orcamento = "Olá! Aqui está o link do orçamento: #{cliente_link}" %>
            <% mensagem_orcamento += "\nSenha de acesso: #{orcamento.senha_publica}" if orcamento.link_requer_senha? %>
            <% whatsapp_text = CGI.escape(mensagem_orcamento) %>
            <tr>
              <td class="col-acoes" style="text-align: center;"><%= orcamento.cod_orcamento %></td>
              <td><%= orcamento.pessoa.nome %></td>
              <td><%= orcamento.funcionario&.usuario %></td>
              <td class="col-acoes"><%= orcamento.data_orcamento&.strftime('%d/%m/%Y') %></td>
              <td class="col-acoes"><%= orcamento.data_validade ? l(orcamento.data_validade) : '-' %></td>
              <td class="col-acoes"><%= "R$ #{number_to_currency(orcamento.valortotal, separator: ",", delimiter: "", unit:"")}" %></td>
              <td class="col-acoes text-center">
                <span class="badge bg-primary rounded-pill"><%= orcamento.views_count.to_i %></span>
              </td>
              <td>
                <% case orcamento.status %>
                <% when 'pendente' %>
                  <span class="badge bg-warning">Pendente</span>
                <% when 'aprovado' %>
                  <span class="badge bg-success">Aprovado</span>
                <% when 'convertido' %>
                  <span class="badge bg-info">Convertido</span>
                <% when 'rejeitado' %>
                  <span class="badge bg-danger">Rejeitado</span>
                <% end %>
              </td>
              <td class="col-acoes">
                <% if orcamento.tem_fotos? && orcamento.link_publico_disponivel? %>
                  <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm copy-client-link" data-link="<%= cliente_link %>" title="Copiar link">
                      <i class="fa fa-copy"></i>
                    </button>
                    <a href="https://wa.me/?text=<%= whatsapp_text %>" target="_blank" rel="noopener" class="btn btn-success btn-sm" title="Enviar por WhatsApp">
                      <i class="fa fa-whatsapp"></i>
                    </a>
                  </div>
                <% else %>
                  <span class="text-muted small">Sem link</span>
                <% end %>
              </td>
              <td class="col-acoes">
                <%= link_to collaborators_backoffice_orcamento_path(orcamento),
                    class: 'btn btn-info btn-sm btn-acao',
                    title: 'Visualizar' do %>
                  <i class="fa fa-eye"></i>
                <% end %>
                <% unless orcamento.convertido? %>
                  <%= link_to edit_collaborators_backoffice_orcamento_path(orcamento),
                      class: 'btn btn-warning btn-sm btn-acao',
                      title: 'Editar' do %>
                    <i class="fa fa-edit"></i>
                  <% end %>
                  <%= link_to collaborators_backoffice_orcamento_path(orcamento),
                      method: :delete,
                      data: { confirm: 'Tem certeza?' },
                      class: 'btn btn-danger btn-sm btn-acao',
                      title: 'Excluir' do %>
                    <i class="fa fa-trash-can"></i>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="mt-3">
      <% if @orcamentos.respond_to?(:total_pages) %>
        <div class="dataTable-info"><%= page_entries_info @orcamentos, entry_name: 'orçamento' %></div>
        <%= paginate @orcamentos %>
      <% else %>
        <h6>Exibindo <%= @orcamentos.size %> registros</h6>
      <% end %>
    </div>
  </div>
</div>
<style>
  /* Ajuste da coluna de ações no index */
  table {
    table-layout: auto;
  }

  th.col-acoes,
  td.col-acoes {
    text-align: right;
    white-space: nowrap;
    width: 1%;
    padding-left: 18px;
    padding-right: 18px;
  }
</style>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    $('#orcamentos-table').DataTable({
      "paging": false,
      "searching": false,
      "ordering": true,
      "info": false,
      "order": [[0, "desc"]]  // ordena por Código decrescente (maior para o menor)
    });

    document.querySelectorAll('.copy-client-link').forEach(function(button) {
      button.addEventListener('click', async function() {
        const link = button.dataset.link;

        try {
          await navigator.clipboard.writeText(link);
          const originalHtml = button.innerHTML;
          button.classList.remove('btn-outline-secondary');
          button.classList.add('btn-success');
          button.innerHTML = '<i class="fa fa-check"></i>';

          setTimeout(function() {
            button.classList.remove('btn-success');
            button.classList.add('btn-outline-secondary');
            button.innerHTML = originalHtml;
          }, 1200);
        } catch (error) {
          window.prompt('Copie o link do cliente:', link);
        }
      });
    });
  });
</script>