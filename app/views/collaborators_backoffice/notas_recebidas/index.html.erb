<div id="layoutAuthentication_content">
  <main>
    <div class="card mt-3">
      <div class="card-header bg-primary text-white d-flex align-items-center">
        <i class="fa fa-inbox me-2"></i>
        <h4 class="mb-0">Notas Recebidas (fornecedores)</h4>
        <%# Sincronizacao automatica (Buscar na SEFAZ / Atualizar status) OCULTA
            durante o teste em paralelo com o sistema atual (MYRP): ela baixaria
            TODAS as notas do periodo e gravaria NotaRecebida, o que nao queremos
            agora. As rotas sincronizar/sincronizar_status continuam existindo —
            basta re-adicionar os button_to aqui para religar. A consulta e o
            download por chave (manual, sem salvar nada) ficam na secao abaixo. %>
        <% mostrar_sincronizacao = false %>
        <div class="ms-auto d-flex gap-2">
          <%# Ver entradas na SEFAZ: lista AO VIVO (ObterNotasFiscais), so leitura,
              NAO grava NotaRecebida. Mantem o periodo dos filtros. %>
          <%= link_to collaborators_backoffice_notas_recebidas_path(inicio: params[:inicio], fim: params[:fim], ver_entradas: 1),
                class: "btn btn-light btn-sm" do %>
            <i class="fa fa-cloud-arrow-down me-1"></i> Ver entradas na SEFAZ
          <% end %>
          <% if mostrar_sincronizacao %>
            <%= button_to "Buscar na SEFAZ",
                  sincronizar_collaborators_backoffice_notas_recebidas_path(inicio: params[:inicio], fim: params[:fim]),
                  method: :post, class: "btn btn-light btn-sm" %>
            <%= button_to "Atualizar status",
                  sincronizar_status_collaborators_backoffice_notas_recebidas_path(inicio: params[:inicio], fim: params[:fim]),
                  method: :post, class: "btn btn-outline-light btn-sm" %>
          <% end %>
        </div>
      </div>

      <div class="card-body">
        <% if flash[:notice].present? %><div class="alert alert-success py-2"><%= flash[:notice] %></div><% end %>
        <% if flash[:alert].present? %><div class="alert alert-danger py-2"><%= flash[:alert] %></div><% end %>

        <%# Alerta: notas importadas que foram canceladas na SEFAZ %>
        <% if @alertas_canceladas.any? %>
          <div class="alert alert-warning">
            <i class="fa fa-triangle-exclamation me-1"></i>
            <strong><%= @alertas_canceladas.size %></strong> nota(s) já importada(s) como compra foram
            <strong>CANCELADAS na SEFAZ</strong>. Verifique e cancele a compra correspondente:
            <%= @alertas_canceladas.map { |n| "NF #{n.numero}" }.join(", ") %>.
          </div>
        <% end %>

        <%# ===== Consultar NF por chave (manual, sem salvar nada no ERP) ===== %>
        <div class="card border-info mb-3">
          <div class="card-header bg-info-subtle d-flex align-items-center">
            <strong><i class="fa fa-magnifying-glass me-2"></i>Consultar NF por chave</strong>
            <span class="ms-2 small text-muted">consulta e download manual — não importa nem salva no sistema</span>
          </div>
          <div class="card-body">
            <div class="row g-2 align-items-end">
              <div class="col-md-7">
                <label class="form-label small mb-1">Chave de acesso (44 dígitos)</label>
                <input id="nfChave" class="form-control" maxlength="54" inputmode="numeric"
                       placeholder="Cole a chave da NF-e / NFC-e" autocomplete="off">
              </div>
              <div class="col-md-5 d-flex gap-2">
                <button id="btnConsultarChave" type="button" class="btn btn-primary">
                  <i class="fa fa-eye me-1"></i> Consultar
                </button>
                <a id="btnBaixarXml" class="btn btn-outline-secondary disabled" aria-disabled="true">
                  <i class="fa fa-file-code me-1"></i> Baixar XML
                </a>
                <a id="btnBaixarPdf" class="btn btn-outline-secondary disabled" aria-disabled="true">
                  <i class="fa fa-file-pdf me-1"></i> Baixar DANFE
                </a>
              </div>
            </div>
            <div id="nfChaveResultado" class="mt-3 text-muted small">
              Informe a chave para ver a situação da nota na SEFAZ (não grava nada).
            </div>
          </div>
        </div>

        <script>
          (function () {
            var inp = document.getElementById('nfChave');
            var btn = document.getElementById('btnConsultarChave');
            var out = document.getElementById('nfChaveResultado');
            var bx  = document.getElementById('btnBaixarXml');
            var bp  = document.getElementById('btnBaixarPdf');
            if (!inp || !btn) return;
            var urlConsulta = "<%= consultar_chave_collaborators_backoffice_notas_recebidas_path %>";
            var urlBaixar   = "<%= baixar_chave_collaborators_backoffice_notas_recebidas_path %>";

            function soDigitos(v) { return (v || '').replace(/\D/g, ''); }
            function desabilitarDownloads() {
              [bx, bp].forEach(function (a) { a.classList.add('disabled'); a.removeAttribute('href'); });
            }
            function habilitarDownloads(chave) {
              bx.href = urlBaixar + '?tipo=xml&chave=' + encodeURIComponent(chave);
              bp.href = urlBaixar + '?tipo=pdf&chave=' + encodeURIComponent(chave);
              [bx, bp].forEach(function (a) { a.classList.remove('disabled'); });
            }

            inp.addEventListener('input', desabilitarDownloads);

            btn.addEventListener('click', function () {
              var chave = soDigitos(inp.value);
              if (chave.length !== 44) {
                out.className = 'mt-3 text-danger small';
                out.textContent = 'A chave precisa ter 44 dígitos.';
                desabilitarDownloads();
                return;
              }
              btn.disabled = true;
              out.className = 'mt-3 text-muted small';
              out.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> Consultando na SEFAZ...';
              desabilitarDownloads();

              fetch(urlConsulta + '?chave=' + encodeURIComponent(chave), { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                  if (!d.sucesso) {
                    out.className = 'mt-3 text-danger small';
                    out.textContent = d.mensagem || 'Não foi possível consultar.';
                    return;
                  }
                  var mapa = { autorizada: 'success', cancelada: 'danger', denegada: 'dark', rejeitada: 'warning', enviada: 'secondary' };
                  var cor = mapa[d.situacao] || 'secondary';
                  var linhas = [
                    '<span class="badge text-bg-' + cor + '">' + (d.situacao || 'situação indefinida') + '</span>',
                    d.numero ? ('NF <strong>' + d.numero + '</strong>' + (d.serie ? ' série ' + d.serie : '')) : null,
                    d.protocolo ? ('Protocolo: ' + d.protocolo) : null,
                    d.mensagem
                  ].filter(Boolean);
                  out.className = 'mt-3';
                  out.innerHTML = linhas.join(' · ');
                  habilitarDownloads(chave);
                })
                .catch(function () {
                  out.className = 'mt-3 text-danger small';
                  out.textContent = 'Falha ao consultar a nota.';
                })
                .finally(function () { btn.disabled = false; });
            });
          })();
        </script>

        <%# ===== Entradas na SEFAZ (ao vivo, so leitura — nao grava) ===== %>
        <% if params[:ver_entradas] == "1" %>
          <div class="card border-secondary mb-3">
            <div class="card-header bg-light d-flex align-items-center">
              <strong><i class="fa fa-cloud-arrow-down me-2"></i>Entradas na SEFAZ</strong>
              <span class="ms-2 small text-muted">
                período <%= @inicio.strftime("%d/%m/%Y") %> a <%= @fim.strftime("%d/%m/%Y") %> — apenas visualização, nada é salvo
              </span>
              <span class="ms-auto">
                <% if @config&.producao? %>
                  <span class="badge text-bg-danger">Produção</span>
                <% else %>
                  <span class="badge text-bg-warning">Homologação</span>
                <% end %>
              </span>
            </div>
            <div class="card-body">
              <% unless @config&.producao? %>
                <div class="alert alert-warning py-2">
                  <i class="fa fa-triangle-exclamation me-1"></i>
                  A empresa está em <strong>Homologação</strong>. A SEFAZ não distribui notas reais de entrada
                  nesse ambiente, então a lista virá vazia. Para ver as notas recebidas de verdade, mude o
                  ambiente para <strong>Produção</strong> em Configuração Fiscal.
                </div>
              <% end %>
              <% if @entradas_erro.present? %>
                <div class="alert alert-warning py-2 mb-0"><%= @entradas_erro %></div>
              <% elsif @entradas_sefaz.blank? %>
                <p class="text-muted mb-0">Nenhuma nota de entrada encontrada na SEFAZ para o período.</p>
              <% else %>
                <div class="table-responsive">
                  <table class="table table-sm table-bordered table-hover align-middle mb-0">
                    <thead class="table-light">
                      <tr>
                        <th>Emissor</th>
                        <th>NF / Série</th>
                        <th>Modelo</th>
                        <th>Emissão</th>
                        <th class="text-end">Valor</th>
                        <th>Chave</th>
                        <th style="width:160px;">Arquivos</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% @entradas_sefaz.each do |e| %>
                        <tr>
                          <td><%= e[:emissor] %><br><small class="text-muted"><%= e[:cnpj_emissor] %></small></td>
                          <td><%= e[:numero] %><%= " / #{e[:serie]}" if e[:serie].present? %></td>
                          <td><%= e[:modelo] %></td>
                          <td><% if e[:data_emissao].present? %><%= (Time.parse(e[:data_emissao].to_s).strftime("%d/%m/%Y") rescue e[:data_emissao]) %><% end %></td>
                          <td class="text-end"><%= number_to_currency(e[:valor], unit: "R$ ", delimiter: ".", separator: ",") %></td>
                          <td class="text-break"><small><%= e[:chave] %></small></td>
                          <td>
                            <% if e[:chave].present? %>
                              <%= link_to baixar_chave_collaborators_backoffice_notas_recebidas_path(chave: e[:chave], tipo: "xml", origem: "entrada"),
                                    class: "btn btn-outline-secondary btn-sm", title: "Baixar XML" do %>
                                <i class="fa fa-file-code"></i> XML
                              <% end %>
                              <%= link_to baixar_chave_collaborators_backoffice_notas_recebidas_path(chave: e[:chave], tipo: "pdf", origem: "entrada"),
                                    class: "btn btn-outline-secondary btn-sm", title: "Baixar DANFE" do %>
                                <i class="fa fa-file-pdf"></i> PDF
                              <% end %>
                            <% end %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
                <small class="text-muted d-block mt-2">
                  <i class="fa fa-circle-info me-1"></i>
                  Lista obtida direto da SEFAZ (distribuição DF-e). Não grava nada no sistema.
                  Notas de compra (NF-e 55) só aparecem após manifestação/ciência na conta da Brasil NFe.
                </small>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# Filtros %>
        <%= form_with url: collaborators_backoffice_notas_recebidas_path, method: :get, local: true, class: "row g-2 mb-3 align-items-end" do %>
          <div class="col-md-2">
            <label class="form-label small mb-0">De</label>
            <%= text_field_tag :inicio, params[:inicio] || Date.today.beginning_of_month.strftime("%Y-%m-%d"), type: "date", class: "form-control form-control-sm" %>
          </div>
          <div class="col-md-2">
            <label class="form-label small mb-0">Até</label>
            <%= text_field_tag :fim, params[:fim] || Date.today.strftime("%Y-%m-%d"), type: "date", class: "form-control form-control-sm" %>
          </div>
          <div class="col-md-2">
            <label class="form-label small mb-0">Status SEFAZ</label>
            <%= select_tag :status, options_for_select([["Todos", ""], ["Autorizada","autorizada"], ["Cancelada","cancelada"], ["Denegada","denegada"]], params[:status]), class: "form-select form-select-sm" %>
          </div>
          <div class="col-md-2">
            <label class="form-label small mb-0">Integrado</label>
            <%= select_tag :integrado, options_for_select([["Todos",""],["Sim","1"],["Não","0"]], params[:integrado]), class: "form-select form-select-sm" %>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-primary btn-sm">Filtrar</button>
          </div>
        <% end %>

        <div class="table-responsive">
          <table class="table table-sm table-bordered table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Status SEFAZ</th>
                <th>Integrado</th>
                <th>Fornecedor (emitente)</th>
                <th>NF</th>
                <th>Série</th>
                <th>Emissão</th>
                <th class="text-end">Total</th>
                <th>Tipo</th>
                <th>Natureza</th>
                <th>Transportadora</th>
                <th>CNPJ Transp.</th>
                <th style="width:60px;"></th>
              </tr>
            </thead>
            <tbody>
              <% if @notas.empty? %>
                <tr><td colspan="12" class="text-center text-muted py-3">
                  Nenhuma nota recebida gravada no período. Use <strong>Consultar NF por chave</strong> acima
                  para ver ou baixar uma nota pela chave (sem salvar no sistema).
                </td></tr>
              <% end %>
              <% @notas.each do |n| %>
                <tr class="<%= 'table-warning' if n.integrada_mas_cancelada? %>">
                  <td>
                    <% badge = { "autorizada" => "success", "cancelada" => "danger", "denegada" => "dark" }[n.status_sefaz] || "secondary" %>
                    <span class="badge text-bg-<%= badge %>"><%= n.status_sefaz %></span>
                  </td>
                  <td>
                    <% if n.integrada? %>
                      <%= link_to "Compra ##{n.cod_compra}", collaborators_backoffice_compra_path(n.cod_compra), class: "badge text-bg-info text-decoration-none" %>
                    <% else %>
                      <span class="badge text-bg-light">não</span>
                    <% end %>
                  </td>
                  <td><%= n.emitente_nome %><br><small class="text-muted"><%= n.emitente_cnpj %></small></td>
                  <td><%= n.numero %></td>
                  <td><%= n.serie %></td>
                  <td><%= n.data_emissao&.strftime("%d/%m/%Y") %></td>
                  <td class="text-end"><%= number_to_currency(n.valor_total, unit: "R$ ", delimiter: ".", separator: ",") %></td>
                  <td><%= n.tipo_nf == 0 ? "Entrada" : (n.tipo_nf == 1 ? "Saída" : "—") %></td>
                  <td><small><%= n.natureza_operacao %></small></td>
                  <td><small><%= n.transportadora_nome %></small></td>
                  <td><small><%= n.transportadora_cnpj %></small></td>
                  <td>
                    <% if !n.integrada? && n.status_sefaz == "autorizada" %>
                      <%= button_to "Importar", importar_collaborators_backoffice_notas_recebida_path(n), method: :post, class: "btn btn-success btn-sm" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if @notas.respond_to?(:total_pages) %>
          <div class="text-center"><%= paginate @notas %></div>
        <% end %>
      </div>
    </div>
  </main>
</div>
