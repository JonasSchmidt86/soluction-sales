<div id="layoutAuthentication_content">
  <main>
    <div class="card mt-3">
      <div class="card-header bg-primary text-white d-flex align-items-center">
        <i class="fa fa-inbox me-2"></i>
        <h4 class="mb-0">Notas Recebidas (fornecedores)</h4>
        <div class="ms-auto d-flex gap-2 align-items-center">
          <% if @config&.producao? %>
            <span class="badge text-bg-light">Produção</span>
          <% else %>
            <span class="badge text-bg-warning">Homologação</span>
          <% end %>
          <%# Ver entradas na SEFAZ: busca o periodo na distribuicao e REGISTRA
              (so dados, sem baixar XML) as novas na lista abaixo. Dedupe por chave. %>
          <%# Busca as entradas do periodo na SEFAZ e registra (so dados) na lista. %>
          <%= button_to ver_entradas_collaborators_backoffice_notas_recebidas_path(filtros),
                method: :post, class: "btn btn-light btn-sm", title: "Buscar entradas do período na SEFAZ",
                form: { class: "d-inline", data: { turbo: false } } do %>
            <i class="fa fa-cloud-arrow-down me-1"></i> Ver entradas na SEFAZ
          <% end %>
        </div>
      </div>

      <div class="card-body">
        <% if flash[:notice].present? %><div class="alert alert-success py-2"><%= flash[:notice] %></div><% end %>
        <% if flash[:alert].present? %><div class="alert alert-danger py-2"><%= flash[:alert] %></div><% end %>

        <% unless @config&.producao? %>
          <div class="alert alert-warning py-2">
            <i class="fa fa-triangle-exclamation me-1"></i>
            A empresa está em <strong>Homologação</strong>. A SEFAZ não distribui notas reais de entrada
            nesse ambiente — para receber as notas de verdade, mude para <strong>Produção</strong> em Configuração Fiscal.
          </div>
        <% end %>

        <%# Alerta: notas importadas que foram canceladas na SEFAZ %>
        <% if @alertas_canceladas.any? %>
          <div class="alert alert-warning">
            <i class="fa fa-triangle-exclamation me-1"></i>
            <strong><%= @alertas_canceladas.size %></strong> nota(s) já importada(s) como compra foram
            <strong>CANCELADAS na SEFAZ</strong>. Verifique e cancele a compra correspondente:
            <%= @alertas_canceladas.map { |n| "NF #{n.numero}" }.join(", ") %>.
          </div>
        <% end %>

        <%# ===== Consultar NF por chave: consulta e SALVA na lista (so dados) ===== %>
        <div class="card border-info mb-3">
          <div class="card-header bg-info-subtle d-flex align-items-center">
            <strong><i class="fa fa-magnifying-glass me-2"></i>Consultar NF por chave</strong>
            <span class="ms-2 small text-muted">consulta a situação e permite salvar a nota na lista</span>
          </div>
          <div class="card-body">
            <div class="row g-2 align-items-end">
              <div class="col-md-8">
                <label class="form-label small mb-1">Chave de acesso</label>
                <input id="nfChave" class="form-control" maxlength="54" inputmode="numeric"
                       placeholder="Cole a chave da NF-e / NFC-e" autocomplete="off">
              </div>
              <div class="col-md-4 d-flex gap-2">
                <button id="btnConsultarChave" type="button" class="btn btn-primary">
                  <i class="fa fa-eye me-1"></i> Consultar
                </button>
                <%= form_with url: salvar_chave_collaborators_backoffice_notas_recebidas_path(filtros),
                      method: :post, local: true, data: { turbo: false }, class: "d-inline" do %>
                  <%= hidden_field_tag :chave, "", id: "nfChaveSalvar" %>
                  <button type="submit" id="btnSalvarChave" class="btn btn-success" disabled>
                    <i class="fa fa-floppy-disk me-1"></i> Salvar na lista
                  </button>
                <% end %>
              </div>
            </div>
            <div id="nfChaveResultado" class="mt-3 text-muted small">
              Informe a chave para ver a situação da nota na SEFAZ.
            </div>
          </div>
        </div>

        <script>
          (function () {
            var inp = document.getElementById('nfChave');
            var btn = document.getElementById('btnConsultarChave');
            var out = document.getElementById('nfChaveResultado');
            var btnSalvar = document.getElementById('btnSalvarChave');
            var hidSalvar = document.getElementById('nfChaveSalvar');
            if (!inp || !btn) return;
            var urlConsulta = "<%= consultar_chave_collaborators_backoffice_notas_recebidas_path %>";

            function soDigitos(v) { return (v || '').replace(/\D/g, ''); }
            function travarSalvar() { if (btnSalvar) btnSalvar.disabled = true; }
            inp.addEventListener('input', travarSalvar);

            btn.addEventListener('click', function () {
              var chave = soDigitos(inp.value);
              if (chave.length < 20) {
                out.className = 'mt-3 text-danger small';
                out.textContent = 'Informe a chave de acesso.';
                travarSalvar();
                return;
              }
              btn.disabled = true;
              out.className = 'mt-3 text-muted small';
              out.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> Consultando na SEFAZ...';
              travarSalvar();

              fetch(urlConsulta + '?chave=' + encodeURIComponent(chave), { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                  if (!d.sucesso) {
                    out.className = 'mt-3 text-danger small';
                    out.textContent = d.mensagem || 'Não foi possível consultar.';
                    return;
                  }
                  var mapa = { autorizada: 'success', cancelada: 'danger', denegada: 'dark', rejeitada: 'warning', enviada: 'secondary' };
                  var cor = mapa[d.situacao] || 'secondary';
                  var linhas = [
                    '<span class="badge text-bg-' + cor + '">' + (d.situacao || 'situação indefinida') + '</span>',
                    d.numero ? ('NF <strong>' + d.numero + '</strong>' + (d.serie ? ' série ' + d.serie : '')) : null,
                    d.protocolo ? ('Protocolo: ' + d.protocolo) : null,
                    d.mensagem
                  ].filter(Boolean);
                  out.className = 'mt-3';
                  out.innerHTML = linhas.join(' · ');
                  // libera o Salvar com a chave consultada
                  if (hidSalvar) hidSalvar.value = chave;
                  if (btnSalvar) btnSalvar.disabled = false;
                })
                .catch(function () {
                  out.className = 'mt-3 text-danger small';
                  out.textContent = 'Falha ao consultar a nota.';
                })
                .finally(function () { btn.disabled = false; });
            });
          })();
        </script>

        <%# ===== Filtros ===== %>
        <%= form_with url: collaborators_backoffice_notas_recebidas_path, method: :get, local: true, class: "row g-2 mb-3 align-items-end" do %>
          <div class="col-md-2">
            <label class="form-label small mb-0">De</label>
            <%= text_field_tag :inicio, params[:inicio] || Date.today.beginning_of_month.strftime("%Y-%m-%d"), type: "date", class: "form-control form-control-sm" %>
          </div>
          <div class="col-md-2">
            <label class="form-label small mb-0">Até</label>
            <%= text_field_tag :fim, params[:fim] || Date.today.strftime("%Y-%m-%d"), type: "date", class: "form-control form-control-sm" %>
          </div>
          <div class="col-md-2">
            <label class="form-label small mb-0">Tipo</label>
            <%= select_tag :tipo, options_for_select([["Todos", ""], ["Mercadoria (NF-e)", "mercadoria"], ["Serviço", "servico"]], params[:tipo]), class: "form-select form-select-sm" %>
          </div>
          <div class="col-md-2">
            <label class="form-label small mb-0">Status SEFAZ</label>
            <%= select_tag :status, options_for_select([["Todos", ""], ["Autorizada","autorizada"], ["Cancelada","cancelada"], ["Denegada","denegada"]], params[:status]), class: "form-select form-select-sm" %>
          </div>
          <div class="col-md-2">
            <label class="form-label small mb-0">Integrado</label>
            <%= select_tag :integrado, options_for_select([["Todos",""],["Sim","1"],["Não","0"]], params[:integrado]), class: "form-select form-select-sm" %>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-primary btn-sm">Filtrar</button>
          </div>
        <% end %>

        <%# ===== Tabela UNICA de notas recebidas gravadas ===== %>
        <div class="table-responsive notas-recebidas-tabela">
          <table class="table table-sm table-bordered table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th class="text-center" style="width:50px;">Status</th>
                <th>Fornecedor (emitente)</th>
                <th>Natureza da operação</th>
                <th style="width:125px;">NF / Série</th>
                <th class="text-center" style="width:50px;">Mod.</th>
                <th>Emissão</th>
                <th class="text-end" style="max-width:200px;">Total</th>
                <th class="text-break" style="width:425px;">Chave</th>
                <th class="text-center" style="width:95px;">Ações</th>
              </tr>
            </thead>
            <tbody>
              <% if @notas.empty? %>
                <tr><td colspan="9" class="text-center text-muted py-3">
                  Nenhuma nota no período. Clique em <strong>Ver entradas na SEFAZ</strong> para buscar e registrar,
                  ou use <strong>Consultar NF por chave</strong>.
                </td></tr>
              <% end %>
              <% @notas.each do |n| %>
                <% mercadoria = n.modelo.to_i == 55 %>
                <tr class="<%= 'table-warning' if n.integrada_mas_cancelada? %>">
                  <%# Status: so um icone. Verde = autorizada; cinza = os demais.
                      O status real aparece no tooltip (title). %>
                  <td class="text-center">
                    <% autorizada = n.status_sefaz == "autorizada" %>
                    <i class="fa fa-circle-check <%= autorizada ? 'text-success' : 'text-secondary' %>"
                       title="<%= (n.status_sefaz || 'desconhecido').capitalize %>"
                       data-bs-toggle="tooltip"></i>
                  </td>
                  <%# Fornecedor: sem CNPJ, limitado a 40 caracteres (tooltip com o nome completo). %>
                  <td title="<%= n.emitente_nome %>"><%= truncate(n.emitente_nome.to_s, length: 35) %></td>
                  <%# Natureza da operacao (natOp do XML), limitada no visual com tooltip. %>
                  <td title="<%= n.natureza_operacao %>"><%= truncate(n.natureza_operacao.to_s, length: 20) %></td>
                  <td><%= n.numero %><%= " / #{n.serie}" if n.serie.present? %></td>
                  <%# Modelo compacto: S = servico, T = transporte (CT-e 57 / MDF-e 58),
                      mercadoria (NF-e 55) mostra o numero do modelo. %>
                  <td class="text-center">
                    <% if [57, 58].include?(n.modelo.to_i) %>
                      <span class="badge text-bg-info" title="Transporte (modelo <%= n.modelo %>)">T</span>
                    <% elsif n.modelo.to_i == 55 %>
                      <span title="NF-e (mercadoria)"><%= n.modelo %></span>
                    <% else %>
                      <span class="badge text-bg-secondary" title="Serviço (modelo <%= n.modelo %>)">S</span>
                    <% end %>
                  </td>
                  <td><%= n.data_emissao&.strftime("%d/%m/%Y") %></td>
                  <%# Total em formato contabil: "R$" a esquerda, valor a direita. %>
                  <td>
                    <div class="d-flex justify-content-between">
                      <span>R$</span>
                      <span><%= number_with_precision(n.valor_total, precision: 2, delimiter: ".", separator: ",") %></span>
                    </div>
                  </td>
                  <td class="text-break"><small><%= n.chave_acesso %></small></td>
                  <td class="text-center">
                    <div class="d-inline-flex gap-1 align-items-center">
                      <%# Acao principal (em cima): se ja integrada, VER COMPRA;
                          senao, se mercadoria autorizada, IMPORTAR. So icone. %>
                      <% if n.integrada? %>
                        <%= link_to collaborators_backoffice_compra_path(n.cod_compra),
                              class: "btn btn-info btn-sm text-white", style: "width:34px;",
                              title: "Ver compra ##{n.compra&.cod_compraempresa || n.cod_compra}" do %>
                          <i class="fa fa-cart-shopping"></i>
                        <% end %>
                      <% elsif mercadoria && n.status_sefaz == "autorizada" %>
                        <%= button_to importar_chave_collaborators_backoffice_notas_recebidas_path(chave: n.chave_acesso, inicio: params[:inicio], fim: params[:fim]),
                              method: :post, class: "btn btn-success btn-sm", title: "Importar compra",
                              form: { class: "d-inline", data: { turbo: false } },
                              style: "width:34px;",
                              data: { confirm: "Baixar o XML e importar esta nota para montar a compra?" } do %>
                          <i class="fa fa-file-import"></i>
                        <% end %>
                      <% end %>

                      <%# Dropdown (embaixo). strategy fixed + overflow visible
                          evitam que o menu seja cortado pela tabela. %>
                      <div class="dropdown">
                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button"
                                style="width:34px;" data-bs-toggle="dropdown" aria-expanded="false" title="Ações">
                          <i class="fa fa-ellipsis-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                          <li>
                            <%= link_to baixar_chave_collaborators_backoffice_notas_recebidas_path(chave: n.chave_acesso, tipo: "xml", origem: "entrada"),
                                  class: "dropdown-item" do %>
                              <i class="fa fa-file-code me-2"></i> Baixar XML
                            <% end %>
                          </li>
                          <li>
                            <%= link_to baixar_chave_collaborators_backoffice_notas_recebidas_path(chave: n.chave_acesso, tipo: "pdf", origem: "entrada"),
                                  target: "_blank", class: "dropdown-item" do %>
                              <i class="fa fa-file-pdf me-2"></i> Abrir DANFE
                            <% end %>
                          </li>
                          <li><hr class="dropdown-divider"></li>
                          <li>
                            <% msg_excluir = n.integrada? ?
                                 "Esta nota já está vinculada à Compra ##{n.compra&.cod_compraempresa || n.cod_compra}. Remover só o registro da lista (a compra NÃO é apagada)?" :
                                 "Remover esta nota da lista?" %>
                            <%= button_to collaborators_backoffice_notas_recebida_path(n, filtros),
                                  method: :delete, class: "dropdown-item text-danger",
                                  form: { data: { turbo: false } },
                                  data: { confirm: msg_excluir } do %>
                              <i class="fa fa-trash-can me-2"></i> Excluir da lista
                            <% end %>
                          </li>
                        </ul>
                      </div>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if @notas.respond_to?(:total_pages) %>
          <div class="text-center"><%= paginate @notas %></div>
        <% end %>
      </div>
    </div>
  </main>
</div>

<style>
  /* O .table-responsive corta o dropdown (overflow). Deixa o overflow visivel
     para o menu "escapar" da tabela. A tabela aqui nao precisa de scroll
     horizontal, entao nao ha efeito colateral. */
  .notas-recebidas-tabela.table-responsive { overflow: visible; }
  /* Botoes de acao empilhados e compactos (sem margem extra do button_to). */
  .notas-recebidas-tabela form { margin: 0; }
  .notas-recebidas-tabela td { vertical-align: middle; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Tooltips (status por icone).
    if (window.bootstrap && bootstrap.Tooltip) {
      document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
        new bootstrap.Tooltip(el);
      });
    }
    // Dropdowns com Popper em strategy "fixed": renderiza fora do clipping da
    // tabela, evitando que o menu apareca cortado.
    if (window.bootstrap && bootstrap.Dropdown) {
      document.querySelectorAll('[data-bs-toggle="dropdown"]').forEach(function (el) {
        new bootstrap.Dropdown(el, { popperConfig: function (defaultConfig) {
          return Object.assign({}, defaultConfig, { strategy: 'fixed' });
        } });
      });
    }
  });
</script>
