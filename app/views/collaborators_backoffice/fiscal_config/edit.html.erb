<div class="container-fluid mt-3">
  <div class="card">
    <div class="card-header bg-primary">
      <h4 class="text-white mb-0"><i class="fa fa-gear me-2"></i> Configuração Fiscal</h4>
    </div>
    <div class="card-body">
      <%= form_with model: @config, url: collaborators_backoffice_fiscal_config_path, method: :patch, local: true do |f| %>
        <% if @config.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @config.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
            </ul>
          </div>
        <% end %>

        <%# ===== Ambiente e Regime ===== %>
        <h6 class="text-uppercase text-muted fw-bold border-bottom pb-2 mb-3">
          <i class="fa fa-sliders me-1"></i> Ambiente e Regime
        </h6>
        <div class="row mb-3">
          <div class="col-md-4">
            <div class="form-floating">
              <%= f.select :ambiente,
                    options_for_select([["Homologação (teste)", "homologacao"], ["Produção", "producao"]], @config.ambiente),
                    { id: "selAmbiente" }, class: "form-select" %>
              <%= f.label :ambiente, "Ambiente" %>
            </div>
          </div>
          <div class="col-md-4">
            <div class="form-floating">
              <%= f.select :regime_tributario,
                    options_for_select([["Simples Nacional", "simples"], ["Lucro Presumido", "presumido"], ["Lucro Real", "real"]], @config.regime_tributario),
                    {}, class: "form-select" %>
              <%= f.label :regime_tributario, "Regime Tributário" %>
            </div>
          </div>
          <div class="col-md-4">
            <div class="form-floating">
              <%= f.number_field :crt, class: "form-control" %>
              <%= f.label :crt, "CRT (1=Simples)" %>
            </div>
          </div>
        </div>

        <%# Painel de prontidao para PRODUCAO: aparece ao escolher "Produção",
            lista as pendencias (plano, certificado, CSC, tokens) e so libera
            salvar quando tudo ok. O backend tambem bloqueia (fonte de verdade). %>
        <div id="prodCheck" class="alert mb-3" style="display:none;"></div>

        <%# ===== Numeração e Série ===== %>
        <h6 class="text-uppercase text-muted fw-bold border-bottom pb-2 mb-3 mt-4">
          <i class="fa fa-list-ol me-1"></i> Numeração e Série
        </h6>
        <div class="row mb-3">
          <div class="col-md-3">
            <div class="form-floating">
              <%= f.number_field :serie_nfe, class: "form-control", id: "serie_nfe" %>
              <%= f.label :serie_nfe, "Série NF-e" %>
            </div>
          </div>
          <div class="col-md-3">
            <div class="form-floating">
              <%= f.number_field :proximo_numero_nfe, class: "form-control", id: "proximo_numero_nfe" %>
              <%= f.label :proximo_numero_nfe, "Próximo nº NF-e" %>
            </div>
          </div>
          <div class="col-md-3">
            <div class="form-floating">
              <%= f.number_field :serie_nfce, class: "form-control", id: "serie_nfce" %>
              <%= f.label :serie_nfce, "Série NFC-e" %>
            </div>
          </div>
          <div class="col-md-3">
            <div class="form-floating">
              <%= f.number_field :proximo_numero_nfce, class: "form-control", id: "proximo_numero_nfce" %>
              <%= f.label :proximo_numero_nfce, "Próximo nº NFC-e" %>
            </div>
          </div>
        </div>

        <%# ===== Sincronizar numeracao com o provedor =====
            Consulta a serie/proximo numero que o provedor (Brasil NFe) usa hoje
            e permite GRAVAR no provedor a serie + proximo numero (forma segura
            de "passar o numero"; o provedor segue sendo a fonte da sequencia).
            E tudo via JSON (nao mexe no form principal de salvar a config). %>
        <div class="border rounded p-3 mb-3 bg-light">
          <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <button type="button" id="btnConsultarNumeracao" class="btn btn-outline-primary btn-sm">
              <i class="fa fa-cloud-download-alt me-1"></i> Consultar numeração no provedor
            </button>
            <span id="numeracaoInfo" class="text-muted small"></span>
          </div>
          <div id="numeracaoResultado" class="alert mb-2" style="display:none;"></div>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="small text-muted">Após ajustar série e próximo nº acima, grave no provedor:</span>
            <button type="button" class="btn btn-success btn-sm" data-salvar-numeracao="55">
              <i class="fa fa-upload me-1"></i> Salvar numeração NF-e (55)
            </button>
            <button type="button" class="btn btn-success btn-sm" data-salvar-numeracao="65">
              <i class="fa fa-upload me-1"></i> Salvar numeração NFC-e (65)
            </button>
          </div>
          <small class="text-danger d-block mt-2">
            <i class="fa fa-triangle-exclamation me-1"></i>
            Nunca defina um número menor ou igual a um já autorizado na SEFAZ — isso gera chave duplicada.
          </small>
        </div>

        <script>
          (function () {
            var urlConsulta   = "<%= consultar_numeracao_collaborators_backoffice_fiscal_config_path(format: :json) %>";
            var urlAtualiza   = "<%= atualizar_numeracao_collaborators_backoffice_fiscal_config_path(format: :json) %>";
            var token         = document.querySelector('meta[name="csrf-token"]');
            var csrf          = token ? token.getAttribute('content') : '';

            var info      = document.getElementById('numeracaoInfo');
            var resultado = document.getElementById('numeracaoResultado');

            function mostrar(tipo, msg) {
              resultado.style.display = 'block';
              resultado.className = 'alert alert-' + tipo + ' mb-2';
              resultado.innerHTML = msg;
            }

            function setVal(id, v) {
              var el = document.getElementById(id);
              if (el && v !== null && v !== undefined) el.value = v;
            }

            var btn = document.getElementById('btnConsultarNumeracao');
            if (btn) {
              btn.addEventListener('click', function () {
                btn.disabled = true;
                info.textContent = 'Consultando...';
                fetch(urlConsulta, { headers: { 'Accept': 'application/json' } })
                  .then(function (r) { return r.json(); })
                  .then(function (data) {
                    btn.disabled = false;
                    info.textContent = '';
                    if (!data.ok) { mostrar('danger', data.mensagem || 'Falha ao consultar.'); return; }

                    var partes = [];
                    if (data.sugestao && data.sugestao.nfe) {
                      setVal('serie_nfe', data.sugestao.nfe.serie);
                      setVal('proximo_numero_nfe', data.sugestao.nfe.numero);
                      partes.push('NF-e: série ' + data.sugestao.nfe.serie + ', próximo nº ' + data.sugestao.nfe.numero);
                    }
                    if (data.sugestao && data.sugestao.nfce) {
                      setVal('serie_nfce', data.sugestao.nfce.serie);
                      setVal('proximo_numero_nfce', data.sugestao.nfce.numero);
                      partes.push('NFC-e: série ' + data.sugestao.nfce.serie + ', próximo nº ' + data.sugestao.nfce.numero);
                    }
                    var txt = 'Ambiente ' + (data.ambiente || '') + '. ' +
                      (partes.length ? partes.join(' | ') : 'Nenhuma numeração cadastrada no provedor ainda.');
                    mostrar(partes.length ? 'info' : 'warning', txt + ' Os campos acima foram preenchidos — revise e salve se desejar.');
                  })
                  .catch(function (e) {
                    btn.disabled = false; info.textContent = '';
                    mostrar('danger', 'Erro de comunicação: ' + e.message);
                  });
              });
            }

            document.querySelectorAll('[data-salvar-numeracao]').forEach(function (b) {
              b.addEventListener('click', function () {
                var modelo = b.getAttribute('data-salvar-numeracao');
                var serie  = modelo === '65' ? document.getElementById('serie_nfce').value : document.getElementById('serie_nfe').value;
                var numero = modelo === '65' ? document.getElementById('proximo_numero_nfce').value : document.getElementById('proximo_numero_nfe').value;

                if (!serie || !numero || parseInt(numero, 10) <= 0) {
                  mostrar('warning', 'Informe a série e um próximo número maior que zero para o modelo ' + modelo + '.');
                  return;
                }
                if (!confirm('Gravar no provedor: modelo ' + modelo + ', série ' + serie + ', próximo nº ' + numero + '?')) return;

                b.disabled = true;
                fetch(urlAtualiza, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': csrf },
                  body: JSON.stringify({ modelo: modelo, serie: serie, numero: numero })
                })
                  .then(function (r) { return r.json(); })
                  .then(function (data) {
                    b.disabled = false;
                    mostrar(data.ok ? 'success' : 'danger', data.mensagem || (data.ok ? 'Numeração atualizada.' : 'Falha ao atualizar.'));
                  })
                  .catch(function (e) {
                    b.disabled = false;
                    mostrar('danger', 'Erro de comunicação: ' + e.message);
                  });
              });
            });
          })();
        </script>

        <%# ===== Brasil NFe — Credenciais ===== %>
        <h6 class="text-uppercase text-muted fw-bold border-bottom pb-2 mb-3 mt-4">
          <i class="fa fa-plug me-1"></i> Brasil NFe — Tokens de acesso
        </h6>
        <p class="text-muted small mb-3">
          Tokens guardados de forma <strong>criptografada</strong>. Deixe em branco para
          <strong>manter</strong> o já salvo; preencha apenas para trocar.
          O ambiente (produção/homologação) é definido no campo <em>Ambiente</em> acima — o token da empresa é o mesmo para os dois.
        </p>
        <div class="row mb-3">
          <div class="col-md-6">
            <div class="form-floating">
              <%= f.password_field :brasilnfe_token, class: "form-control", autocomplete: "off",
                    placeholder: "Token da empresa (transmissão)", value: nil %>
              <%= f.label :brasilnfe_token, "Token da empresa (transmissão de documentos)" %>
            </div>
            <small class="text-muted"><%= @config.brasilnfe_token.present? ? "✔ token da empresa salvo" : "nenhum token da empresa salvo" %></small>
          </div>
          <div class="col-md-6">
            <div class="form-floating">
              <%= f.password_field :brasilnfe_user_token, class: "form-control", autocomplete: "off",
                    placeholder: "Token pessoal (usuário)", value: nil %>
              <%= f.label :brasilnfe_user_token, "Token pessoal / UserToken (numeração, certificado)" %>
            </div>
            <small class="text-muted"><%= @config.brasilnfe_user_token.present? ? "✔ token pessoal salvo" : "nenhum token pessoal salvo" %></small>
          </div>
        </div>

        <%# ===== NFC-e (CSC) por ambiente ===== %>
        <h6 class="text-uppercase text-muted fw-bold border-bottom pb-2 mb-3 mt-4">
          <i class="fa fa-key me-1"></i> NFC-e — CSC (por ambiente)
        </h6>
        <p class="text-muted small mb-3">
          CSC usado na NFC-e (modelo 65). O <strong>token</strong> é guardado criptografado —
          deixe em branco para manter o já salvo.
        </p>
        <div class="row mb-3">
          <div class="col-md-3">
            <div class="form-floating">
              <%= f.text_field :csc_id_producao, class: "form-control", autocomplete: "off" %>
              <%= f.label :csc_id_producao, "Ident. CSC Produção" %>
            </div>
          </div>
          <div class="col-md-9">
            <div class="form-floating">
              <%= f.password_field :csc_token_producao, class: "form-control", autocomplete: "off",
                    placeholder: "Código CSC de produção", value: nil %>
              <%= f.label :csc_token_producao, "Código CSC Produção" %>
            </div>
            <small class="text-muted"><%= @config.csc_token_producao.present? ? "✔ CSC de produção salvo" : "nenhum CSC de produção salvo" %></small>
          </div>
        </div>
        <div class="row mb-3">
          <div class="col-md-3">
            <div class="form-floating">
              <%= f.text_field :csc_id_homologacao, class: "form-control", autocomplete: "off" %>
              <%= f.label :csc_id_homologacao, "Ident. CSC Homologação" %>
            </div>
          </div>
          <div class="col-md-9">
            <div class="form-floating">
              <%= f.password_field :csc_token_homologacao, class: "form-control", autocomplete: "off",
                    placeholder: "Código CSC de homologação", value: nil %>
              <%= f.label :csc_token_homologacao, "Código CSC Homologação" %>
            </div>
            <small class="text-muted"><%= @config.csc_token_homologacao.present? ? "✔ CSC de homologação salvo" : "nenhum CSC de homologação salvo" %></small>
          </div>
        </div>

        <%# ===== Envio ao contador ===== %>
        <h6 class="text-uppercase text-muted fw-bold border-bottom pb-2 mb-3 mt-4">
          <i class="fa fa-paper-plane me-1"></i> Envio de XML ao contador
        </h6>
        <div class="row mb-3">
          <div class="col-md-6">
            <div class="form-floating">
              <%= f.email_field :email_xml, class: "form-control", placeholder: "email@contador.com" %>
              <%= f.label :email_xml, "E-mail do contador (recebe o .zip de XMLs)" %>
            </div>
          </div>
        </div>

        <%# ===== Provedor ===== %>
        <h6 class="text-uppercase text-muted fw-bold border-bottom pb-2 mb-3 mt-4">
          <i class="fa fa-plug me-1"></i> Provedor
        </h6>
        <div class="row mb-3">
          <div class="col-md-4">
            <div class="form-floating">
              <%= f.select :provedor,
                    options_for_select([["A definir", ""], ["Focus NFe", "focus"], ["Brasil NFe", "brasilnfe"]], @config.provedor),
                    {}, class: "form-select" %>
              <%= f.label :provedor, "Provedor" %>
            </div>
          </div>
        </div>

        <div class="alert alert-info small">
          <i class="fa fa-circle-info me-1"></i>
          Os tokens e o CSC são guardados criptografados neste sistema (não dependem mais de arquivo de configuração).
          O certificado digital é enviado na seção abaixo, após salvar os tokens.
        </div>

        <div class="d-flex justify-content-end gap-2 border-top pt-3">
          <%= link_to "Cancelar", collaborators_backoffice_fiscal_config_path, class: "btn btn-secondary" %>
          <%= f.submit "Salvar", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>
  </div>

  <%# ===== Certificado digital A1 (upload separado — chama a Brasil NFe) ===== %>
  <div class="card mt-3">
    <div class="card-header d-flex align-items-center">
      <strong><i class="fa fa-certificate me-2"></i> Certificado digital A1</strong>
      <div class="ms-auto d-flex align-items-center gap-2">
        <% if @config.certificado_nome.present? %>
          <span class="small text-muted">
            Atual: <%= @config.certificado_nome %>
            <% if @config.certificado_validade %>
              · válido até <%= @config.certificado_validade.strftime("%d/%m/%Y") rescue @config.certificado_validade %>
            <% end %>
          </span>
        <% end %>
        <% if @config.persisted? && @config.provedor.to_s == "brasilnfe" %>
          <button id="btnConferirCert" type="button" class="btn btn-sm btn-outline-light border">
            <i class="fa fa-rotate me-1"></i> Conferir validade
          </button>
        <% end %>
      </div>
    </div>
    <div class="card-body">
      <div id="conferirCertResultado" class="mb-3" style="display:none;"></div>
      <p class="text-muted small mb-3">
        Envie o certificado <strong>A1 (.pfx ou .p12)</strong> com a senha. O arquivo vai
        direto para a Brasil NFe; a senha <strong>não</strong> é guardada neste sistema.
        Cadastre e salve os tokens acima antes de enviar o certificado.
      </p>
      <%= form_with url: enviar_certificado_collaborators_backoffice_fiscal_config_path,
            method: :post, local: true, html: { multipart: true } do %>
        <div class="row g-2 align-items-end">
          <div class="col-md-5">
            <label class="form-label mb-1">Arquivo do certificado (.pfx / .p12)</label>
            <input type="file" name="certificado_arquivo" accept=".pfx,.p12" class="form-control" required>
          </div>
          <div class="col-md-4">
            <label class="form-label mb-1">Senha do certificado</label>
            <input type="password" name="certificado_senha" class="form-control" autocomplete="off" required>
          </div>
          <div class="col-md-3 d-grid">
            <button type="submit" class="btn btn-primary"
                    data-confirm="Enviar este certificado para a Brasil NFe?">
              <i class="fa fa-upload me-1"></i> Enviar certificado
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <script>
    // ---- Prontidão para PRODUÇÃO (item 5) ----
    (function () {
      var sel = document.getElementById('selAmbiente');
      var box = document.getElementById('prodCheck');
      if (!sel || !box) return;
      var url = "<%= @config.persisted? ? checar_producao_collaborators_backoffice_fiscal_config_path : '' %>";
      // Botão Salvar (submit do form principal).
      function btnSalvar() { return document.querySelector('form input[type=submit], form button[type=submit]'); }

      function limpar() {
        box.style.display = 'none';
        box.innerHTML = '';
        var b = btnSalvar(); if (b) { b.disabled = false; b.title = ''; }
      }

      function checar() {
        if (sel.value !== 'producao') { limpar(); return; }
        if (!url) {
          box.style.display = 'block';
          box.className = 'alert alert-warning mb-3';
          box.innerHTML = 'Salve a configuração (em homologação) uma vez antes de ativar a Produção.';
          return;
        }
        box.style.display = 'block';
        box.className = 'alert alert-secondary mb-3';
        box.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> Verificando pré-requisitos para Produção...';
        var b = btnSalvar(); if (b) b.disabled = true;

        fetch(url, { headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (d.pronto) {
              box.className = 'alert alert-success mb-3';
              box.innerHTML = '<i class="fa fa-circle-check me-1"></i> <strong>Pronto para Produção.</strong> ' +
                'Ao salvar, as próximas notas terão <strong>valor fiscal real</strong>.';
              var bb = btnSalvar(); if (bb) bb.disabled = false;
            } else {
              var itens = (d.pendencias || []).map(function (p) { return '<li>' + p + '</li>'; }).join('');
              box.className = 'alert alert-danger mb-3';
              box.innerHTML = '<i class="fa fa-triangle-exclamation me-1"></i> <strong>Ainda não é possível ativar Produção.</strong>' +
                '<ul class="mb-0 mt-1">' + itens + '</ul>';
              var bb = btnSalvar(); if (bb) { bb.disabled = true; bb.title = 'Resolva as pendências para ativar produção'; }
            }
          })
          .catch(function () {
            box.className = 'alert alert-warning mb-3';
            box.innerHTML = 'Não foi possível verificar os pré-requisitos agora. O salvamento em produção será validado pelo servidor.';
            var bb = btnSalvar(); if (bb) bb.disabled = false;
          });
      }

      sel.addEventListener('change', checar);
      if (sel.value === 'producao') checar(); // estado inicial
    })();
  </script>

  <% if @config.persisted? && @config.provedor.to_s == "brasilnfe" %>
    <script>
      (function () {
        var btn = document.getElementById('btnConferirCert');
        var out = document.getElementById('conferirCertResultado');
        if (!btn || !out) return;
        var url = "<%= verificar_certificado_collaborators_backoffice_fiscal_config_path %>";
        btn.addEventListener('click', function () {
          btn.disabled = true;
          out.style.display = 'block';
          out.className = 'mb-3 alert alert-secondary py-2';
          out.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> Consultando a validade na Brasil NFe...';
          fetch(url, { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
              if (!d.sucesso) {
                out.className = 'mb-3 alert alert-danger py-2';
                out.textContent = d.mensagem || 'Não foi possível verificar o certificado.';
                return;
              }
              var classe, rotulo;
              if (d.expirado === true) { classe = 'alert-danger'; rotulo = 'Certificado expirado'; }
              else if (d.proximo_vencimento) { classe = 'alert-warning'; rotulo = 'Certificado vence em breve'; }
              else if (d.valido) { classe = 'alert-success'; rotulo = 'Certificado válido'; }
              else { classe = 'alert-secondary'; rotulo = 'Situação indefinida'; }
              var extra = '';
              if (d.data_expiracao) {
                extra = ' — validade ' + d.data_expiracao;
                if (typeof d.dias_para_expirar === 'number') {
                  extra += d.dias_para_expirar < 0
                    ? ' (expirado há ' + Math.abs(d.dias_para_expirar) + ' dia(s))'
                    : ' (faltam ' + d.dias_para_expirar + ' dia(s))';
                }
              }
              var avisos = (d.avisos && d.avisos.length) ? '<br><small>' + d.avisos.join(' · ') + '</small>' : '';
              out.className = 'mb-3 alert ' + classe + ' py-2';
              out.innerHTML = '<strong>' + rotulo + '</strong>' + extra + avisos;
            })
            .catch(function () {
              out.className = 'mb-3 alert alert-danger py-2';
              out.textContent = 'Falha ao verificar o certificado.';
            })
            .finally(function () { btn.disabled = false; });
        });
      })();
    </script>
  <% end %>
</div>
