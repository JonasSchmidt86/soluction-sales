<div class="container-fluid mt-3">
  <div class="card">
    <div class="card-header bg-primary d-flex align-items-center">
      <h4 class="text-white mb-0"><i class="fa fa-gear me-2"></i> Configuração Fiscal</h4>
      <div class="ms-auto d-flex gap-2">
        <% if @config.persisted? && @config.ativo? %>
          <%= link_to exportar_collaborators_backoffice_fiscal_config_path, class: "btn btn-light btn-sm" do %>
            <i class="fa fa-file-zipper me-1"></i> Exportar período
          <% end %>
        <% end %>
        <%= link_to edit_collaborators_backoffice_fiscal_config_path, class: "btn btn-light btn-sm" do %>
          <i class="fa fa-pencil me-1"></i> Editar
        <% end %>
      </div>
    </div>
    <div class="card-body">
      <% if @config.persisted? %>
        <div class="row">
          <div class="col-md-6">
            <p><strong>Ambiente:</strong>
              <% if @config.producao? %>
                <span class="badge bg-danger">Produção</span>
              <% else %>
                <span class="badge bg-warning text-dark">Homologação (teste)</span>
              <% end %>
            </p>
            <p><strong>Regime:</strong> <%= @config.regime_tributario.titleize %> (CRT <%= @config.crt %>)</p>
            <p><strong>Provedor:</strong> <%= @config.provedor.presence&.titleize || "A definir" %></p>
          </div>
          <div class="col-md-6">
            <p><strong>NF-e:</strong> série <%= @config.serie_nfe %>, próximo nº <%= @config.proximo_numero_nfe %></p>
            <p><strong>NFC-e:</strong> série <%= @config.serie_nfce %>, próximo nº <%= @config.proximo_numero_nfce %></p>
            <p><strong>CSC:</strong> <%= @config.csc_id.present? ? "configurado (ID #{@config.csc_id})" : "—" %></p>
            <p><strong>Certificado:</strong>
              <%= @config.certificado_nome.presence || "—" %>
              <% if @config.certificado_validade %>
                (válido até <%= l @config.certificado_validade, format: :default rescue @config.certificado_validade %>)
              <% end %>
            </p>
          </div>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="fa fa-gear fa-3x text-muted mb-3"></i>
          <p class="text-muted">Nenhuma configuração fiscal definida ainda.</p>
          <%= link_to edit_collaborators_backoffice_fiscal_config_path, class: "btn btn-primary" do %>
            <i class="fa fa-pencil me-1"></i> Configurar agora
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <% if @config.persisted? && @config.ativo? %>
    <%# ---- Status operacional da SEFAZ (consulta sob demanda) ---- %>
    <div class="card mt-3">
      <div class="card-header d-flex align-items-center">
        <strong><i class="fa fa-tower-broadcast me-2"></i>Status da SEFAZ</strong>
        <div class="ms-auto d-flex align-items-center gap-2">
          <select id="statusModelo" class="form-select form-select-sm" style="width:auto;">
            <option value="55">NF-e (55)</option>
            <option value="65">NFC-e (65)</option>
          </select>
          <button id="btnStatusSefaz" type="button" class="btn btn-sm btn-outline-primary">
            <i class="fa fa-rotate me-1"></i> Verificar
          </button>
        </div>
      </div>
      <div class="card-body">
        <div id="statusSefazResultado" class="text-muted">
          Clique em <em>Verificar</em> para consultar a disponibilidade da SEFAZ (consulta sempre em produção).
        </div>
      </div>
    </div>

    <%# ---- Consulta de cadastro de contribuinte na SEFAZ ---- %>
    <div class="card mt-3">
      <div class="card-header">
        <strong><i class="fa fa-id-card me-2"></i>Consultar cadastro na SEFAZ</strong>
      </div>
      <div class="card-body">
        <div class="row g-2 align-items-end">
          <div class="col-md-2">
            <label class="form-label mb-1">UF</label>
            <input id="cadUf" class="form-control" maxlength="2" placeholder="PR"
                   value="<%= @config.empresa&.uf rescue nil %>">
          </div>
          <div class="col-md-5">
            <label class="form-label mb-1">CPF / CNPJ / IE</label>
            <input id="cadDoc" class="form-control" placeholder="Somente números">
          </div>
          <div class="col-md-2">
            <button id="btnCadastro" type="button" class="btn btn-outline-primary">
              <i class="fa fa-magnifying-glass me-1"></i> Consultar
            </button>
          </div>
        </div>
        <div id="cadastroResultado" class="mt-3 text-muted">
          Informe UF e documento para verificar a situação cadastral do contribuinte.
        </div>
        <%# Faixa de acao: cadastrar/abrir pessoa (preenchida via JS apos a consulta). %>
        <div id="cadastroAcao" class="mt-3" style="display:none;"></div>
      </div>
    </div>

    <script>
      (function () {
        var btn   = document.getElementById('btnStatusSefaz');
        var sel   = document.getElementById('statusModelo');
        var out   = document.getElementById('statusSefazResultado');
        var url   = "<%= status_sefaz_collaborators_backoffice_fiscal_config_path %>";

        btn.addEventListener('click', function () {
          btn.disabled = true;
          out.className = 'text-muted';
          out.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> Consultando...';

          fetch(url + '?modelo=' + encodeURIComponent(sel.value), { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
              var badge = d.operante
                ? '<span class="badge bg-success">Operante</span>'
                : '<span class="badge bg-danger">Indisponível</span>';
              var detalhe = [d.mensagem, d.uf, d.ambiente].filter(Boolean).join(' — ');
              out.className = '';
              out.innerHTML = badge + ' ' + (detalhe || '') +
                (d.codigo ? ' <small class="text-muted">(cód ' + d.codigo + ')</small>' : '');
            })
            .catch(function () {
              out.className = 'text-danger';
              out.textContent = 'Falha ao consultar o status da SEFAZ.';
            })
            .finally(function () { btn.disabled = false; });
        });

        // ---- Consulta de cadastro ----
        var cadBtn  = document.getElementById('btnCadastro');
        var cadUf   = document.getElementById('cadUf');
        var cadDoc  = document.getElementById('cadDoc');
        var cadOut  = document.getElementById('cadastroResultado');
        var cadAcao = document.getElementById('cadastroAcao');
        var cadUrl  = "<%= consultar_cadastro_collaborators_backoffice_fiscal_config_path %>";
        var novoPessoaUrl = "<%= new_collaborators_backoffice_pessoa_path %>";
        var editPessoaBase = "<%= collaborators_backoffice_pessoas_path %>"; // + /:id/edit

        // Monta a faixa de acao conforme a pessoa ja existe ou nao.
        function montarAcaoCadastro(d) {
          if (!d || !d.sucesso) { cadAcao.style.display = 'none'; return; }

          if (d.pessoa_existe && d.cod_pessoa) {
            cadAcao.style.display = 'block';
            cadAcao.innerHTML =
              '<div class="alert alert-light border d-flex justify-content-between align-items-center mb-0">' +
                '<span><i class="fa fa-user-check me-1 text-success"></i> Já existe uma pessoa com este documento.</span>' +
                '<a class="btn btn-sm btn-outline-primary" href="' + editPessoaBase + '/' + d.cod_pessoa + '/edit">' +
                  '<i class="fa fa-arrow-up-right-from-square me-1"></i> Abrir cadastro</a>' +
              '</div>';
            return;
          }

          // Nao existe: link para abrir o cadastro de PJ ja preenchido.
          var qs = Object.keys(d.prefill || {})
            .filter(function (k) { return d.prefill[k] != null && d.prefill[k] !== ''; })
            .map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(d.prefill[k]); })
            .join('&');
          var href = novoPessoaUrl + (qs ? ('?' + qs) : '');

          cadAcao.style.display = 'block';
          cadAcao.innerHTML =
            '<div class="alert alert-primary border d-flex justify-content-between align-items-center mb-0">' +
              '<span>' +
                '<i class="fa fa-circle-info me-1"></i> Este CNPJ ainda não está cadastrado como pessoa.' +
                '<small class="d-block text-muted">Abre o cadastro de PJ já preenchido; o CEP completa o endereço.</small>' +
              '</span>' +
              '<a class="btn btn-sm btn-success" target="_blank" href="' + href + '">' +
                '<i class="fa fa-plus me-1"></i> Cadastrar pessoa</a>' +
            '</div>';
        }

        cadBtn.addEventListener('click', function () {
          cadBtn.disabled = true;
          cadOut.className = 'mt-3 text-muted';
          cadOut.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> Consultando...';

          var q = 'uf=' + encodeURIComponent(cadUf.value.trim()) +
                  '&documento=' + encodeURIComponent(cadDoc.value.trim());
          fetch(cadUrl + '?' + q, { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.json(); })
            .then(function (d) {
              if (!d.sucesso) {
                cadOut.className = 'mt-3 text-danger';
                cadOut.textContent = d.mensagem || 'Não foi possível consultar.';
                return;
              }
              var badge = d.habilitado
                ? '<span class="badge bg-success">Habilitado</span>'
                : '<span class="badge bg-warning text-dark">' + (d.situacao || 'Verificar') + '</span>';
              var contato = d.contato
                ? [d.contato.telefone, d.contato.email].filter(Boolean).join(' · ')
                : null;
              var linhas = [
                badge,
                d.razao_social ? '<strong>' + d.razao_social + '</strong>' : null,
                d.nome_fantasia ? ('Fantasia: ' + d.nome_fantasia) : null,
                d.ie ? ('IE: ' + d.ie) : 'IE: —',
                d.cnae ? ('CNAE: ' + d.cnae) : null,
                d.regime,
                d.endereco ? ('<i class="fa fa-location-dot me-1"></i>' + d.endereco) : null,
                contato ? ('<i class="fa fa-phone me-1"></i>' + contato) : null,
                [d.credenciado_nfe ? 'Credenciado NF-e' : 'NF-e não credenciado',
                 d.credenciado_cte ? 'Credenciado CT-e' : null].filter(Boolean).join(' · '),
                d.data_inicio ? ('Início: ' + String(d.data_inicio).substring(0,10)) : null,
                [d.uf, d.fonte ? ('fonte: ' + d.fonte) : null].filter(Boolean).join(' — '),
                d.mensagem
              ].filter(Boolean);
              cadOut.className = 'mt-3';
              cadOut.innerHTML = linhas.join('<br>');

              // Faixa de acao: abrir cadastro existente ou cadastrar novo.
              montarAcaoCadastro(d);
            })
            .catch(function () {
              cadOut.className = 'mt-3 text-danger';
              cadOut.textContent = 'Falha ao consultar o cadastro.';
              cadAcao.style.display = 'none';
            })
            .finally(function () { cadBtn.disabled = false; });
        });
      })();
    </script>
  <% end %>
</div>
