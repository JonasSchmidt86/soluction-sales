<%
  pessoa = @venda.pessoa
  empresa = @venda.empresa
  funcionario = @venda.funcionario

  # Formatar CPF/CNPJ
  cpf_cnpj_formatado = if pessoa&.cpf_cnpj.present?
    digitos = pessoa.cpf_cnpj.gsub(/\D/, '')
    if digitos.length == 11
      digitos.gsub(/(\d{3})(\d{3})(\d{3})(\d{2})/, '\1.\2.\3-\4')
    elsif digitos.length == 14
      digitos.gsub(/(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})/, '\1.\2.\3/\4-\5')
    else
      pessoa.cpf_cnpj
    end
  else
    "_______________"
  end
%>

<div style="border: 2px solid #000; padding: 15px; font-family: Arial, sans-serif; font-size: 11pt; max-width: 210mm; margin: 0 auto; word-wrap: break-word; overflow-wrap: break-word;">
  <!-- CABEÇALHO -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
    <h2 style="font-weight: bold; font-size: 16pt; margin: 0;">RECIBO DE ENTREGA</h2>
    <span style="font-size: 11pt;">DATA VENDA, <%= I18n.l(@venda.datavenda, format: '%d DE %B DE %Y').upcase %></span>
  </div>

  <!-- DADOS DO CLIENTE -->
  <div style="margin-bottom: 8px; line-height: 1.8; word-wrap: break-word; overflow-wrap: break-word;">
    <p style="margin: 0;">
      EU <span style="border-bottom: 1px dotted #000; padding: 0 5px;"><strong><%= pessoa&.nome || "_______________" %></strong></span>
      PORTADOR(A) DO CPF/CNPJ:<span style="border-bottom: 1px dotted #000; padding: 0 5px;"><strong><%= cpf_cnpj_formatado %></strong></span>
    </p>
    <p style="margin: 0;">
      RESIDENTE NA: <span style="border-bottom: 1px dotted #000; padding: 0 5px;"><strong><%= [pessoa&.endereco, pessoa&.complemento].compact.reject(&:blank?).join(', ') || "_______________" %></strong></span>, Nº <span style="border-bottom: 1px dotted #000; padding: 0 5px;"><strong><%= pessoa&.numero || "___" %></strong></span>
      BAIRRO: <span style="border-bottom: 1px dotted #000; padding: 0 5px;"><strong><%= pessoa&.bairro || "_______________" %></strong></span>
    </p>
    <p style="margin: 0;">
      CIDADE: <span style="border-bottom: 1px dotted #000; padding: 0 5px;"><strong><%= pessoa&.cidade&.nome || "_______________" %></strong></span>
      TELEFONE(S): <span style="border-bottom: 1px dotted #000; padding: 0 5px;"><strong><%= pessoa&.celular || pessoa&.telefone || "_______________" %></strong></span>
    </p>
  </div>

  <p style="margin: 10px 0 5px 0;">DECLARO TER RECEBIDO O(S) ITEM(S) A SEGUIR RELACIONADO(S).</p>

  <!-- TABELA DE ITENS -->
  <table style="width: 100%; border-collapse: collapse; margin: 10px 0;">
    <thead>
      <tr style="border-bottom: 1px solid #000;">
        <th style="text-align: left; padding: 4px; font-size: 10pt;">CODIGO</th>
        <th style="text-align: center; padding: 4px; font-size: 10pt;">QTD</th>
        <th style="text-align: left; padding: 4px; font-size: 10pt;">PRODUTO</th>
        <th style="text-align: center; padding: 4px; font-size: 10pt;">DEPOSITO</th>
        <th style="text-align: left; padding: 4px; font-size: 10pt;">COR</th>
      </tr>
    </thead>
    <tbody>
      <% @venda.itensvenda.each do |item| %>
        <tr>
          <td style="padding: 3px 4px; font-size: 10pt;"><%= item.full_codigo %></td>
          <td style="text-align: center; padding: 3px 4px; font-size: 10pt;"><%= number_with_precision(item.quantidade, precision: 2, separator: ',', delimiter: '') %></td>
          <td style="padding: 3px 4px; font-size: 10pt;"><%= item.produto&.nome %></td>
          <td style="text-align: center; padding: 3px 4px; font-size: 10pt;">&#9633;</td>
          <td style="padding: 3px 4px; font-size: 10pt;"><%= item.cor&.nmcor || 'PADRAO' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <!-- OBSERVAÇÕES -->
  <div style="margin: 15px 0; overflow: hidden;">
    <p style="margin: 0; border-bottom: 1px solid #000; padding-bottom: 15px;">OBSERVAÇÕES:</p>
    <p style="margin: 0; border-bottom: 1px solid #000; padding: 15px 0;"></p>
    <p style="margin: 0; border-bottom: 1px solid #000; padding: 15px 0;"></p>
  </div>

  <!-- DECLARAÇÃO -->
  <div style="margin: 15px 0; text-align: justify;">
    <p style="margin: 0;">
      DECLARO QUE A MERCADORIA RECEBIDA ESTÁ DE ACORDO COM A AQUISIÇÃO, SEM AVARIAS E EM
      PERFEITAS CONDIÇÕES E RESPONSABILIZO-ME PELA CONFERENCIA ESTANDO DE ACORDO QUE QUALQUER
      ASSISTÊNCIA FUTURA SERÁ TARIFADA.
    </p>
  </div>

  <!-- VENDEDOR E ENTREGADORES -->
  <div style="margin: 15px 0;">
    <p style="margin: 0;">VENDEDOR: <strong><%= funcionario&.usuario || "_______________" %></strong></p>
    <div style="display: flex; gap: 30px; margin-top: 8px;">
      <span>DATA:____/____/________</span>
      <span>PERIODO:____________________</span>
    </div>
    <p style="margin: 8px 0 0 0;">ENTREGADORES:___________________________________________________</p>
  </div>

  <!-- ASSINATURA -->
  <div style="display: flex; justify-content: space-between; align-items: flex-end; margin: 40px 0;">
    <p style="margin: 0;">PARCELAS:</p>
    <div style="text-align: center; margin: 0 auto;">
      <div style="border-top: 1px solid #000; width: 350px; margin: 0 auto 5px auto;"></div>
      <span>ASSINATURA RESPONSÁVEL RECEBIMENTO</span>
    </div>
  </div>

  <!-- MENSAGEM -->
  <div style="border: 1px solid #000; padding: 10px; margin: 15px 0; text-align: justify;">
    <p style="margin: 0;">
      É UM PRIVILÉGIO SERVIR CLIENTES COMO VOCÊ. AGORA QUE JÁ CONFERIU E VIU QUE ESTÁ TUDO OK,
      JÁ PODE DESFRUTAR DA SUA COMPRA.
    </p>
    <p style="margin: 5px 0 0 0;">
      NÓS DA FAMÍLIA <strong><%= empresa&.pessoa&.nome || "_______________" %></strong> AGRADECEMOS A PREFERENCIA.
    </p>
  </div>

  <!-- TABELA DE PARCELAS -->
  <% if @parcelas.present? %>
    <table style="width: 100%; border-collapse: collapse; border: 1px solid #000;">
      <tbody>
        <% @parcelas.each_slice(6) do |grupo| %>
          <tr>
            <% grupo.each do |parcela| %>
              <td style="border: 1px solid #000; padding: 5px; font-size: 9pt; vertical-align: top; width: <%= 100.0 / [grupo.size, 6].max %>%;">
                <div><%= I18n.l(parcela.dtvencimento, format: '%d/%m/%Y') %></div>
                <div><%= number_to_currency(parcela.valorparcela, unit: "", separator: ",", delimiter: ".") %></div>
                <div><%= parcela.quitada ? 'PAGA' : 'EM ABERTO' %></div>
                <div>PARCELA Nº: <%= parcela.numeroparcela %></div>
              </td>
            <% end %>
            <% if grupo.size < 6 %>
              <% (6 - grupo.size).times do %>
                <td style="border: 1px solid #000; padding: 5px;"></td>
              <% end %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
