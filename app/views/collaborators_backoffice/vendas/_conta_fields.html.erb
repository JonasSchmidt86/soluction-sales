<tr class= "nested-fields">
  <td class="">
    <%= f.text_field :numeroparcela, class: "form-control border-top-0 border-start-0 border-end-0 border-dark", readonly: true %>
  </td>
  <td class="">
    <%# Formata a data existente como dd/mm/aaaa. Sem isso, o Date cru (ISO) %>
    <%# era reinterpretado pela mascara 99/99/9999 e virava algo como "20/26/". %>
    <%= f.text_field :dtvencimento,
          value: (f.object.dtvencimento.present? ? post_date(f.object.dtvencimento) : nil),
          class: "datepicker fallback form-control border-top-0 border-start-0 border-end-0 border-dark" %>
  </td>
  <td class="">
    <%# Parcela com lancamento no caixa (ja liquidada) e travada: o servidor
        ignora alteracoes nela, entao fica somente leitura e a redistribuicao
        automatica de parcelas (JS) nao a modifica (data-travada). %>
    <% travada = f.object.persisted? && f.object.lancamentos.present? %>
    <%= f.text_field :valorparcela, 
      value: number_with_precision(f.object.valorparcela, precision: 2, separator: ',', delimiter: '.'),
      class: "money2 form-control border-top-0 border-start-0 border-end-0 border-dark",
      readonly: travada,
      data: { travada: travada } %>
  </td>
  <%= f.hidden_field :cod_empresa, value: params[:cod_empresa] || current_collaborator.empresa.cod_empresa %>
  <%= f.hidden_field :ativo,  value: params[:ativo] || true %>
  <%= f.hidden_field :quitada,  value: params[:quitada] || false %>
  <%= f.hidden_field :cod_tppagamento,  value: params[:cod_tppagamento] || 1 %>
  <td class="align-middle fw-semibold">
    <%= link_to_remove_association f, class: 'btn btn-primary btn-xs', title: 'Remover' do %>
      <i class="fa fa-trash-can"></i>
    <% end %>
  </td>
</tr>