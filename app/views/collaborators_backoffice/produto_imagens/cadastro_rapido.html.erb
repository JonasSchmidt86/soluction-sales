<!-- Área de mensagens (toast) no topo da tela -->
<div id="toast_cadastro_rapido"
     style="position: fixed; top: 16px; left: 50%; transform: translateX(-50%); z-index: 4000; min-width: 260px; text-align: center; display: none;">
</div>

<div class="card mt-3">
  <div class="card-header bg-primary d-flex align-items-center">
    <%= link_to collaborators_backoffice_produto_imagens_path do %>
      <h4 class="text-white mb-0">Cadastro Rápido de Imagens</h4>
    <% end %>
    <div class="ms-auto">
      <%= link_to collaborators_backoffice_produto_imagens_path, class: "btn btn-light" do %>
        <i class="fa fa-images"></i> Ver imagens
      <% end %>
    </div>
  </div>

  <div class="card-body">
    <!-- Abas: Cadastrar novas x Editar existentes -->
    <ul class="nav nav-tabs mb-3" id="tabs_cadastro_rapido" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-novas" data-bs-toggle="tab" data-bs-target="#pane-novas"
                type="button" role="tab"><i class="fa fa-plus"></i> Cadastrar novas</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-editar" data-bs-toggle="tab" data-bs-target="#pane-editar"
                type="button" role="tab"><i class="fa fa-pen"></i> Editar existentes</button>
      </li>
    </ul>

    <div class="tab-content">
      <!-- ============ ABA: EDITAR EXISTENTES ============ -->
      <div class="tab-pane fade" id="pane-editar" role="tabpanel">
        <div class="alert alert-info">
          Busque um produto por <strong>código ou nome</strong> para carregar as imagens já cadastradas,
          navegar entre elas, remover ou adicionar novas e editar título, descrição, cor e publicação.
        </div>

        <div class="row g-2 align-items-end mb-3" style="position: relative;">
          <div class="col-md-6">
            <label class="form-label mb-1">Produto (código ou nome)</label>
            <input type="text" id="edit_produto_search" class="form-control" autocomplete="off"
                   placeholder="Digite o código ou o nome do produto">
            <div id="edit_products_list" class="position-absolute bg-light rounded border p-2 mt-1"
                 style="display: none; z-index: 1000; width: 100%; max-height: 260px; overflow-y: auto;"></div>
          </div>
          <div class="col-md-3">
            <label class="form-label mb-1">Publicação</label>
            <select id="edit_publicado_filtro" class="form-select">
              <option value="todas">Todas</option>
              <option value="publicadas">Publicadas</option>
              <option value="nao_publicadas">Não publicadas</option>
            </select>
          </div>
          <div class="col-md-3 d-flex align-items-end">
            <button type="button" id="edit_limpar" class="btn btn-outline-secondary w-100">Limpar</button>
          </div>
        </div>

        <!-- Área onde o produto carregado é renderizado -->
        <div id="edit_container"></div>

        <!-- input de arquivo oculto para "Adicionar imagem" -->
        <input type="file" id="edit_file_input" accept="image/*" style="display: none;">
      </div>

      <!-- ============ ABA: CADASTRAR NOVAS (fluxo atual) ============ -->
      <div class="tab-pane fade show active" id="pane-novas" role="tabpanel">
    <div class="alert alert-info">
      Selecione várias imagens de uma vez. Para cada imagem escolha o
      <strong>produto</strong> (buscando por código ou nome), a <strong>cor</strong>
      e informe uma <strong>descrição</strong>. Em seguida clique em <strong>Salvar tudo</strong>.
    </div>

    <!-- Seleção das imagens -->
    <div class="row g-2 align-items-end mb-3">
      <div class="col-md-9">
        <label for="seletor_imagens" class="form-label mb-1">Selecionar imagens</label>
        <input type="file" id="seletor_imagens" class="form-control" accept="image/*" multiple>
      </div>
      <div class="col-md-3 d-flex align-items-end">
        <button type="button" id="limpar_imagens" class="btn btn-outline-secondary w-100">
          Limpar seleção
        </button>
      </div>
    </div>

    <%= form_with(url: cadastro_rapido_salvar_collaborators_backoffice_produto_imagens_path,
                  local: true, method: :post, multipart: true, id: "form_cadastro_rapido") do |form| %>
      <div class="table-responsive">
        <table class="table table-bordered align-middle" id="tabela_cadastro_rapido">
          <thead class="table-light">
            <tr>
              <th style="width: 200px;">Imagem</th>
              <th style="width: 320px;">Produto / Cor</th>
              <th>Descrição</th>
              <th style="width: 60px;"></th>
            </tr>
          </thead>
          <tbody id="linhas_imagens">
            <tr id="linha_vazia">
              <td colspan="4" class="text-center text-muted py-4">
                Nenhuma imagem selecionada.
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="d-flex justify-content-end mt-3">
        <button type="submit" id="btn_salvar_tudo" class="btn btn-success" disabled>
          <i class="fa fa-save"></i> Salvar tudo
        </button>
      </div>
    <% end %>
      </div><!-- /#pane-novas -->
    </div><!-- /.tab-content -->
  </div>
</div>

<!-- Template do card de edição de um produto (aba Editar existentes) -->
<template id="template_edit_produto">
  <div class="card mb-3 edit-produto-card">
    <div class="card-header d-flex align-items-center py-1">
      <strong class="edit-nome-produto"></strong>
      <span class="badge bg-secondary ms-2 edit-cod-produto"></span>
      <div class="ms-auto d-flex align-items-center gap-2">
        <label class="small text-muted mb-0">Cor</label>
        <select class="form-select form-select-sm edit-cod-cor" style="width: auto; min-width: 160px;"></select>
        <button type="button" class="btn btn-outline-danger btn-sm edit-apagar-todas" title="Apagar todas as imagens">
          <i class="fa fa-trash"></i> Apagar todas
        </button>
      </div>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <!-- Galeria -->
        <div class="col-md-6">
          <div class="position-relative text-center border rounded p-2 bg-light" style="min-height: 200px;">
            <div class="edit-galeria-vazia text-muted py-5" style="display:none;">Nenhuma imagem cadastrada.</div>
            <img class="edit-galeria-img rounded" style="max-width: 100%; max-height: 200px; object-fit: contain;">
            <!-- setas -->
            <button type="button" class="btn btn-light border edit-prev"
                    style="position:absolute; top:50%; left:8px; transform:translateY(-50%);" title="Anterior">
              <i class="fa fa-chevron-left"></i>
            </button>
            <button type="button" class="btn btn-light border edit-next"
                    style="position:absolute; top:50%; right:8px; transform:translateY(-50%);" title="Próxima">
              <i class="fa fa-chevron-right"></i>
            </button>
            <!-- lixeira -->
            <button type="button" class="btn btn-danger edit-remover"
                    style="position:absolute; top:8px; right:8px;" title="Remover esta imagem">
              <i class="fa fa-trash"></i>
            </button>
            <!-- contador -->
            <span class="badge bg-dark edit-contador"
                  style="position:absolute; bottom:8px; left:50%; transform:translateX(-50%);"></span>
          </div>
          <div class="d-grid mt-2">
            <button type="button" class="btn btn-outline-primary edit-add-imagem">
              <i class="fa fa-plus"></i> Adicionar imagem
            </button>
          </div>
        </div>

        <!-- Campos -->
        <div class="col-md-6">
          <div class="form-floating mb-2">
            <input type="text" class="form-control edit-titulo" placeholder="Título">
            <label>Título</label>
          </div>
          <div class="form-floating mb-2">
            <textarea class="form-control edit-descricao" style="height: 150px; white-space: pre-wrap;"
                      placeholder="Descrição"></textarea>
            <label>Descrição</label>
          </div>
          <div class="d-flex align-items-center gap-3">
            <div class="form-check mb-0">
              <input type="checkbox" class="form-check-input edit-publicado" id="edit_pub_chk">
              <label class="form-check-label" for="edit_pub_chk">Publicar no site</label>
            </div>
            <button type="button" class="btn btn-success edit-salvar-dados">
              <i class="fa fa-save"></i> Salvar dados
            </button>
            <span class="edit-status small"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<!-- Picker de emojis (estilo WhatsApp) - único, reutilizado por todas as linhas -->
<div id="emoji_picker_wrapper" style="display: none; position: absolute; z-index: 3000;">
  <emoji-picker></emoji-picker>
</div>
<script type="module" src="https://cdn.jsdelivr.net/npm/emoji-picker-element@^1/index.js"></script>

<!-- Template de uma linha (imagem + campos) -->
<template id="template_linha">
  <tr class="linha-imagem">
    <td class="text-center">
      <img class="preview-img rounded border" style="max-width: 200px; max-height: 150px; object-fit: contain;" />
      <div class="small text-muted mt-1 nome-arquivo text-truncate" style="max-width: 200px;"></div>
    </td>
    <!-- Coluna 2: Produto (2 linhas: busca + cor) -->
    <td style="vertical-align: top;">
      <div class="d-flex flex-column gap-2">
        <!-- Linha 1: Busca de produto -->
        <div style="position: relative;">
          <div class="form-floating">
            <input type="text" class="form-control produto_search" placeholder="Código ou nome do produto" autocomplete="off">
            <label>Produto (código ou nome)</label>
          </div>
          <div class="products_list position-absolute bg-light rounded border p-2 mt-1"
               style="display: none; z-index: 1000; width: 100%; max-height: 260px; overflow-y: auto;"></div>
          <input type="hidden" class="campo_cod_produto" data-name="cod_produto">
        </div>

        <!-- Linha 2: Cor -->
        <div class="form-floating">
          <select class="form-select campo_cod_cor" data-name="cod_cor" disabled>
            <option value="">Selecione o produto primeiro</option>
          </select>
          <label>Cor</label>
        </div>

        <!-- Linha 3: Título do produto -->
        <div class="form-floating">
          <input type="text" class="form-control campo_titulo" data-name="titulo"
                 placeholder="Título do produto" autocomplete="off">
          <label>Título</label>
        </div>

        <!-- Linha 4: Publicar direto -->
        <div class="form-check mt-1">
          <input type="checkbox" class="form-check-input campo_publicado" data-name="publicado" value="1" id="pub_{{idx}}">
          <label class="form-check-label" for="pub_{{idx}}">Publicar no site</label>
        </div>
      </div>
    </td>

    <!-- Coluna 3: Descrição (com barra de emojis) -->
    <td style="vertical-align: top;">
      <div class="emoji-bar mb-1 d-flex flex-wrap gap-1">
        <button type="button" class="btn btn-sm btn-light border emoji-btn" data-emoji="🛋️" title="Produto/Móvel">🛋️</button>
        <button type="button" class="btn btn-sm btn-light border emoji-btn" data-emoji="📏" title="Tamanho/Medidas">📏</button>
        <button type="button" class="btn btn-sm btn-light border emoji-btn" data-emoji="🌳" title="Madeira">🌳</button>
        <button type="button" class="btn btn-sm btn-light border emoji-btn" data-emoji="🧵" title="Tecido">🧵</button>
        <button type="button" class="btn btn-sm btn-light border emoji-btn" data-emoji="🎨" title="Cor/Acabamento">🎨</button>
        <button type="button" class="btn btn-sm btn-light border emoji-btn" data-emoji="🛡️" title="Garantia">🛡️</button>
        <button type="button" class="btn btn-sm btn-light border emoji-btn" data-emoji="✅" title="Item/Check">✅</button>
        <button type="button" class="btn btn-sm btn-light border emoji-btn" data-emoji="⭐" title="Destaque">⭐</button>
        <button type="button" class="btn btn-sm btn-light border emoji-btn" data-emoji="📦" title="Embalagem/Entrega">📦</button>
        <button type="button" class="btn btn-sm btn-light border emoji-btn" data-emoji="🚚" title="Frete/Entrega">🚚</button>
        <button type="button" class="btn btn-sm btn-light border emoji-btn" data-emoji="💲" title="Preço">💲</button>
        <button type="button" class="btn btn-sm btn-outline-primary border abrir-picker" title="Mais emojis">😀 +</button>
      </div>
      <textarea class="form-control campo_descricao" data-name="descricao" rows="8"
                placeholder="Ex.:&#10;🛋️ Nome do produto&#10;📏 Tamanho: 2,10m&#10;🌳 Madeira: eucalipto&#10;🧵 Tecido: veludo&#10;🛡️ Garantia: 1 ano"
                style="min-height: 200px; white-space: pre-wrap;"></textarea>
    </td>

    <td class="text-center" style="vertical-align: top;">
      <div class="d-flex flex-column gap-2 align-items-center">
        <button type="button" class="btn btn-outline-success btn-sm gravar-linha" title="Gravar esta imagem" disabled>
          <i class="fa fa-save"></i>
        </button>
        <button type="button" class="btn btn-outline-danger btn-sm remover-linha" title="Remover">
          <i class="fa fa-trash"></i>
        </button>
        <span class="status-linha small"></span>
      </div>
    </td>
  </tr>
</template>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const urlBase        = window.location.origin + '/collaborators_backoffice/';
    const seletor        = document.getElementById('seletor_imagens');
    const corpoTabela    = document.getElementById('linhas_imagens');
    const linhaVazia     = document.getElementById('linha_vazia');
    const template       = document.getElementById('template_linha');
    const btnSalvar      = document.getElementById('btn_salvar_tudo');
    const btnLimpar      = document.getElementById('limpar_imagens');
    const form           = document.getElementById('form_cadastro_rapido');

    // Mantém os arquivos associados a cada linha
    const arquivosPorLinha = new Map();
    let contadorLinhas = 0;

    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
    const toastEl = document.getElementById('toast_cadastro_rapido');
    let toastTimer = null;

    // Mensagem no topo da tela (some sozinha). tipo: 'success' | 'danger' | 'warning'
    function mostrarToast(mensagem, tipo = 'success') {
      toastEl.className = 'alert alert-' + tipo + ' shadow-sm py-2 px-3 mb-0';
      toastEl.textContent = mensagem;
      toastEl.style.display = 'block';
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { toastEl.style.display = 'none'; }, 2500);
    }

    function atualizarEstado() {
      const temLinhas = corpoTabela.querySelectorAll('tr.linha-imagem').length > 0;
      linhaVazia.style.display = temLinhas ? 'none' : '';
      btnSalvar.disabled = !temLinhas;
    }

    // ---- Bloqueia Enter em campos de texto (mantém quebra de linha só no textarea) ----
    corpoTabela.addEventListener('keydown', function (event) {
      if (event.key === 'Enter' && event.target.tagName !== 'TEXTAREA') {
        event.preventDefault();
      }
    });

    // Habilita o botão de gravar somente quando a linha tem produto E cor
    function atualizarBotaoGravar(linha) {
      if (!linha) return;
      const temProduto = !!linha.querySelector('.campo_cod_produto').value;
      const temCor     = !!linha.querySelector('.campo_cod_cor').value;
      const btn        = linha.querySelector('.gravar-linha');
      const jaSalva    = linha.dataset.salva === '1';
      btn.disabled = !(temProduto && temCor) || jaSalva;
    }

    // ---- Seleção de imagens: cria uma linha por arquivo ----
    seletor.addEventListener('change', function () {
      Array.from(this.files).forEach(file => adicionarLinha(file));
      // permite selecionar de novo os mesmos arquivos
      this.value = '';
      atualizarEstado();
    });

    btnLimpar.addEventListener('click', function () {
      corpoTabela.querySelectorAll('tr.linha-imagem').forEach(tr => tr.remove());
      arquivosPorLinha.clear();
      atualizarEstado();
    });

    function adicionarLinha(file) {
      const idx = contadorLinhas++;
      const fragment = template.content.cloneNode(true);
      const tr = fragment.querySelector('tr');
      tr.dataset.idx = idx;

      arquivosPorLinha.set(idx, file);

      // ids únicos para o checkbox "Publicar" e seu label (evita conflito entre linhas)
      const chkPublicado = tr.querySelector('.campo_publicado');
      const lblPublicado = tr.querySelector('label[for^="pub_"]');
      if (chkPublicado && lblPublicado) {
        const pubId = 'pub_' + idx;
        chkPublicado.id = pubId;
        lblPublicado.setAttribute('for', pubId);
      }

      // preview
      const img = tr.querySelector('.preview-img');
      const reader = new FileReader();
      reader.onload = e => { img.src = e.target.result; };
      reader.readAsDataURL(file);
      tr.querySelector('.nome-arquivo').textContent = file.name;

      // remover
      tr.querySelector('.remover-linha').addEventListener('click', function () {
        arquivosPorLinha.delete(idx);
        tr.remove();
        atualizarEstado();
      });

      corpoTabela.appendChild(tr);
    }

    // ---- Autocomplete de produto (por linha) ----
    $(document).on('keydown', '.produto_search', function (event) {
      if (event.key === 'Enter') {
        event.preventDefault();
        buscarProdutos(this);
      } else if (event.key === 'Escape') {
        fecharListas();
      }
    });

    // busca também ao clicar/parar de digitar (debounce)
    let debounceTimer = null;
    $(document).on('input', '.produto_search', function () {
      const campo = this;
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => buscarProdutos(campo), 400);
    });

    function fecharListas() {
      document.querySelectorAll('.products_list').forEach(el => {
        el.style.display = 'none';
        el.innerHTML = '';
      });
    }

    function buscarProdutos(campo) {
      const query = campo.value.trim().toLowerCase();
      const linha = campo.closest('tr.linha-imagem');
      const lista = linha.querySelector('.products_list');
      if (!query) { lista.style.display = 'none'; lista.innerHTML = ''; return; }

      $.ajax({
        url: urlBase + 'buscas/buscar_produtos',
        method: 'GET',
        data: { entidade: 'Produto', query: query },
        success: function (data) {
          lista.innerHTML = '';
          if (!data.length) {
            lista.innerHTML = '<div class="text-muted small px-1">Nenhum produto encontrado</div>';
            lista.style.display = 'block';
            return;
          }
          data.forEach(product => {
            const item = document.createElement('div');
            item.className = 'list-group-item list-group-item-action';
            item.style.cursor = 'pointer';
            item.textContent = product.produto;
            item.addEventListener('click', function () {
              selecionarProduto(linha, product);
              lista.style.display = 'none';
              lista.innerHTML = '';
            });
            lista.appendChild(item);
          });
          lista.style.display = 'block';
        },
        error: function (err) { console.error('Erro na busca de produtos:', err); }
      });
    }

    function selecionarProduto(linha, product) {
      linha.querySelector('.produto_search').value = product.produto;
      linha.querySelector('.campo_cod_produto').value = product.cod_produto;
      atualizarBotaoGravar(linha);
      carregarCores(linha, product.cod_produto);
      verificarDuplicada(linha, product.cod_produto);
    }

    // Verifica no servidor se a imagem desta linha já existe para o produto.
    function verificarDuplicada(linha, codProduto) {
      const idx = parseInt(linha.dataset.idx, 10);
      const file = arquivosPorLinha.get(idx);
      const status = linha.querySelector('.status-linha');
      if (!file || !codProduto) return;

      // reseta estado anterior
      linha.dataset.duplicada = '0';
      linha.dataset.confirmada = '0';

      const dados = new FormData();
      dados.append('cod_produto', codProduto);
      dados.append('arquivo', file);

      status.textContent = 'Verificando...';
      status.className = 'status-linha small text-muted';

      fetch('<%= cadastro_rapido_verificar_collaborators_backoffice_produto_imagens_path %>', {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' },
        body: dados
      })
        .then(r => r.json())
        .then(res => {
          if (res.duplicada) {
            linha.dataset.duplicada = '1';
            linha.classList.add('table-warning');
            status.textContent = '⚠ Imagem já cadastrada para este produto';
            status.className = 'status-linha small text-warning';
          } else {
            linha.classList.remove('table-warning');
            status.textContent = '';
          }
        })
        .catch(() => { status.textContent = ''; });
    }

    // ao mudar a cor, carrega a descrição atual do produto (produto.descricao)
    $(document).on('change', '.campo_cod_cor', function () {
      const linha = this.closest('tr.linha-imagem');
      atualizarBotaoGravar(linha);
      const codProduto = linha.querySelector('.campo_cod_produto').value;
      const codCor = this.value;
      const campoDescricao = linha.querySelector('.campo_descricao');
      const campoTitulo    = linha.querySelector('.campo_titulo');
      const campoPublicado = linha.querySelector('.campo_publicado');
      if (!codProduto || !codCor) return;

      fetch(`<%= get_cor_data_collaborators_backoffice_produto_imagens_path %>?cod_produto=${codProduto}&cod_cor=${codCor}`)
        .then(r => r.json())
        .then(data => {
          if (data && !data.error) {
            if (!campoDescricao.value) campoDescricao.value = data.descricao || '';
            if (campoTitulo && !campoTitulo.value) campoTitulo.value = data.name || '';
            if (campoPublicado) campoPublicado.checked = !!data.publicado;
          }
        })
        .catch(() => {});
    });

    // ---- Carrega as cores já cadastradas para o produto ----
    function carregarCores(linha, codProduto) {
      const select = linha.querySelector('.campo_cod_cor');
      select.disabled = true;
      select.innerHTML = '<option value="">Carregando...</option>';

      $.ajax({
        url: urlBase + 'buscas/consulta_estoque',
        method: 'GET',
        data: { id_produto: codProduto },
        success: function (cores) {
          select.innerHTML = '';
          if (!cores || !cores.length) {
            select.innerHTML = '<option value="">Sem cores cadastradas</option>';
            select.disabled = false;
            return;
          }
          cores.forEach(cor => {
            const opt = document.createElement('option');
            opt.value = cor.cod_cor;
            opt.textContent = cor.nmcor + ' - ' + cor.cod_cor;
            select.appendChild(opt);
          });
          select.disabled = false;
          // dispara para já carregar a descrição da primeira cor
          // (bubbles: true para acionar o handler delegado no document)
          select.dispatchEvent(new Event('change', { bubbles: true }));
          atualizarBotaoGravar(linha);
        },
        error: function (err) {
          console.error('Erro ao carregar cores:', err);
          select.innerHTML = '<option value="">Erro ao carregar cores</option>';
          select.disabled = false;
        }
      });
    }

    // fecha listas ao clicar fora
    document.addEventListener('click', function (e) {
      if (!e.target.closest('.produto_search') && !e.target.closest('.products_list')) {
        fecharListas();
      }
    });

    // ---- Gravar UMA linha (imagem) via AJAX ----
    $(document).on('click', '.gravar-linha', function () {
      const btn = this;
      const linha = btn.closest('tr.linha-imagem');
      const idx = parseInt(linha.dataset.idx, 10);
      const file = arquivosPorLinha.get(idx);

      const codProduto = linha.querySelector('.campo_cod_produto').value;
      const codCor     = linha.querySelector('.campo_cod_cor').value;
      const descricao  = linha.querySelector('.campo_descricao').value;
      const titulo     = linha.querySelector('.campo_titulo')?.value || '';
      const publicado  = linha.querySelector('.campo_publicado')?.checked ? '1' : '0';
      const status     = linha.querySelector('.status-linha');

      if (!codProduto || !codCor || !file) {
        status.textContent = '⚠ Selecione produto e cor';
        status.className = 'status-linha small text-danger';
        return;
      }

      // Se for duplicada e ainda não foi confirmada, pede confirmação
      if (linha.dataset.duplicada === '1' && linha.dataset.confirmada !== '1') {
        const ok = confirm('Esta imagem já foi cadastrada para este produto. Deseja gravar mesmo assim?');
        if (!ok) return;
        linha.dataset.confirmada = '1';
      }

      const forcar = linha.dataset.confirmada === '1' ? '1' : '0';

      const dados = new FormData();
      dados.append('cod_produto', codProduto);
      dados.append('cod_cor', codCor);
      dados.append('descricao', descricao);
      dados.append('titulo', titulo);
      dados.append('publicado', publicado);
      dados.append('arquivo', file);
      dados.append('forcar', forcar);

      btn.disabled = true;
      status.textContent = 'Gravando...';
      status.className = 'status-linha small text-muted';

      fetch('<%= cadastro_rapido_linha_collaborators_backoffice_produto_imagens_path %>', {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' },
        body: dados
      })
        .then(r => r.json().then(j => ({ ok: r.ok, body: j })))
        .then(res => {
          if (res.ok && res.body.success) {
            linha.dataset.salva = '1';
            status.textContent = '✅ Gravada';
            status.className = 'status-linha small text-success';
            // desativa os campos e o botão gravar; mantém remover
            linha.querySelectorAll('input, select, textarea, .emoji-btn, .abrir-picker').forEach(el => el.disabled = true);
            btn.disabled = true;
            mostrarToast('Imagem gravada com sucesso!', 'success');
          } else if (res.body.duplicada) {
            // backend detectou duplicidade e ainda não foi confirmado
            linha.dataset.duplicada = '1';
            linha.classList.add('table-warning');
            status.textContent = '⚠ Imagem já cadastrada — clique gravar para confirmar';
            status.className = 'status-linha small text-warning';
            btn.disabled = false;
          } else {
            status.textContent = '⚠ ' + (res.body.error || 'Falha ao gravar');
            status.className = 'status-linha small text-danger';
            btn.disabled = false;
            mostrarToast('Falha ao gravar: ' + (res.body.error || 'erro desconhecido'), 'danger');
          }
        })
        .catch(err => {
          console.error('Erro ao gravar linha:', err);
          status.textContent = '⚠ Erro de conexão';
          status.className = 'status-linha small text-danger';
          btn.disabled = false;
          mostrarToast('Erro de conexão ao gravar a imagem.', 'danger');
        });
    });

    // ---- Inserção de emojis na descrição (atalhos rápidos) ----
    $(document).on('click', '.emoji-btn', function (e) {
      e.preventDefault();
      const linha = this.closest('tr.linha-imagem');
      const textarea = linha.querySelector('.campo_descricao');
      const emoji = this.getAttribute('data-emoji');
      inserirNoCursor(textarea, emoji + ' ');
    });

    // ---- Picker completo (estilo WhatsApp) ----
    const pickerWrapper = document.getElementById('emoji_picker_wrapper');
    const picker = pickerWrapper.querySelector('emoji-picker');
    let textareaDoPicker = null; // textarea alvo enquanto o picker está aberto

    $(document).on('click', '.abrir-picker', function (e) {
      e.preventDefault();
      e.stopPropagation();
      const linha = this.closest('tr.linha-imagem');
      textareaDoPicker = linha.querySelector('.campo_descricao');

      // já estava aberto para este botão? fecha (toggle)
      if (pickerWrapper.style.display === 'block' && pickerWrapper.dataset.botao === (linha.dataset.idx)) {
        fecharPicker();
        return;
      }
      pickerWrapper.dataset.botao = linha.dataset.idx;

      // posiciona o picker logo abaixo do botão
      const rect = this.getBoundingClientRect();
      pickerWrapper.style.top  = (window.scrollY + rect.bottom + 4) + 'px';
      pickerWrapper.style.left = (window.scrollX + rect.left) + 'px';
      pickerWrapper.style.display = 'block';
    });

    // seleção de emoji dentro do picker
    picker.addEventListener('emoji-click', function (event) {
      const unicode = event.detail.unicode;
      if (textareaDoPicker && unicode) {
        inserirNoCursor(textareaDoPicker, unicode + ' ');
      }
      // não fecha automaticamente: permite escolher vários seguidos
    });

    function fecharPicker() {
      pickerWrapper.style.display = 'none';
      pickerWrapper.dataset.botao = '';
    }

    // fecha o picker ao clicar fora dele e fora do botão que o abre
    document.addEventListener('click', function (e) {
      if (pickerWrapper.style.display !== 'block') return;
      if (!e.target.closest('#emoji_picker_wrapper') && !e.target.closest('.abrir-picker')) {
        fecharPicker();
      }
    });

    function inserirNoCursor(textarea, texto) {
      if (!textarea) return;
      const inicio = textarea.selectionStart ?? textarea.value.length;
      const fim    = textarea.selectionEnd ?? textarea.value.length;
      const antes  = textarea.value.substring(0, inicio);
      const depois = textarea.value.substring(fim);

      // se estiver no meio do texto e não houver quebra antes, mantém como está;
      // a ideia é o usuário posicionar o cursor onde quer (normalmente início de linha)
      textarea.value = antes + texto + depois;

      const novaPos = inicio + texto.length;
      textarea.focus();
      textarea.setSelectionRange(novaPos, novaPos);
    }

    // ---- Monta os campos com name[] no submit ----
    form.addEventListener('submit', function (e) {
      const linhas = corpoTabela.querySelectorAll('tr.linha-imagem');

      // valida produto em todas as linhas
      let invalida = null;
      linhas.forEach(linha => {
        const cod = linha.querySelector('.campo_cod_produto').value;
        if (!cod && !invalida) invalida = linha;
      });
      if (invalida) {
        e.preventDefault();
        mostrarToast('Selecione um produto para todas as imagens antes de salvar.', 'danger');
        invalida.querySelector('.produto_search').focus();
        return;
      }

      // remove campos gerados anteriormente (reenvio)
      form.querySelectorAll('.campo-gerado').forEach(el => el.remove());

      let i = 0;
      linhas.forEach(linha => {
        const idx = parseInt(linha.dataset.idx, 10);
        const file = arquivosPorLinha.get(idx);
        if (!file) return;

        // arquivo
        const inputFile = document.createElement('input');
        inputFile.type = 'file';
        inputFile.name = `itens[${i}][arquivo]`;
        inputFile.className = 'campo-gerado';
        inputFile.style.display = 'none';
        const dt = new DataTransfer();
        dt.items.add(file);
        inputFile.files = dt.files;
        form.appendChild(inputFile);

        // demais campos
        linha.querySelectorAll('[data-name]').forEach(campo => {
          const hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = `itens[${i}][${campo.dataset.name}]`;
          hidden.className = 'campo-gerado';
          // checkbox envia "1"/"0" conforme marcado; demais usam o value
          hidden.value = campo.type === 'checkbox' ? (campo.checked ? '1' : '0') : (campo.value || '');
          form.appendChild(hidden);
        });

        i++;
      });
    });

    // ============================================================
    //  MODO EDIÇÃO (aba "Editar existentes")
    // ============================================================
    const PRODUTO_URL     = '<%= cadastro_rapido_produto_collaborators_backoffice_produto_imagens_path %>';
    const BUSCAR_URL       = '<%= cadastro_rapido_buscar_collaborators_backoffice_produto_imagens_path %>';
    const SALVAR_DADOS_URL = '<%= cadastro_rapido_salvar_dados_collaborators_backoffice_produto_imagens_path %>';
    const APAGAR_TODAS_URL = '<%= cadastro_rapido_apagar_todas_collaborators_backoffice_produto_imagens_path %>';
    const LINHA_URL        = '<%= cadastro_rapido_linha_collaborators_backoffice_produto_imagens_path %>';

    const editSearch    = document.getElementById('edit_produto_search');
    const editList      = document.getElementById('edit_products_list');
    const editContainer = document.getElementById('edit_container');
    const editLimpar    = document.getElementById('edit_limpar');
    const editFileInput = document.getElementById('edit_file_input');
    const tplEdit       = document.getElementById('template_edit_produto');

    // estado por card (suporta vários produtos carregados ao mesmo tempo)
    const stateDoCard = new WeakMap();
    // últimos resultados da busca (para "Carregar todos" / Enter)
    let editUltimosResultados = [];

    // ---- Busca de produto (código ou nome) ----
    let editDebounce = null;
    editSearch.addEventListener('input', function () {
      clearTimeout(editDebounce);
      editDebounce = setTimeout(() => editBuscarProdutos(this.value.trim()), 400);
    });
    editSearch.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { editList.style.display = 'none'; }
    });

    // re-busca ao trocar o filtro de publicação (se já houver termo digitado)
    const editFiltroPub = document.getElementById('edit_publicado_filtro');
    if (editFiltroPub) {
      editFiltroPub.addEventListener('change', function () {
        const termo = editSearch.value.trim();
        if (termo) editBuscarProdutos(termo);
      });
    }

    function editBuscarProdutos(query) {
      if (!query) { editList.style.display = 'none'; editList.innerHTML = ''; return; }
      const filtroPub = document.getElementById('edit_publicado_filtro')?.value || 'todas';
      $.ajax({
        url: BUSCAR_URL, // só produtos que possuem imagem cadastrada
        method: 'GET',
        data: { query: query, publicado: filtroPub },
        success: function (data) {
          editList.innerHTML = '';
          if (!data.length) {
            editList.innerHTML = '<div class="text-muted small px-1">Nenhum produto com imagem encontrado</div>';
            editList.style.display = 'block';
            return;
          }
          // guarda os resultados para o "Carregar todos"
          editUltimosResultados = data.slice();

          // cabeçalho com ação "Carregar todos os N"
          const head = document.createElement('div');
          head.className = 'd-flex justify-content-between align-items-center px-1 pb-1 mb-1 border-bottom';
          head.innerHTML = '<span class="small text-muted">' + data.length + ' produto(s) encontrado(s)</span>';
          const btnTodos = document.createElement('button');
          btnTodos.type = 'button';
          btnTodos.className = 'btn btn-sm btn-primary';
          btnTodos.innerHTML = '<i class="fa fa-layer-group"></i> Carregar todos';
          btnTodos.addEventListener('click', function () {
            editList.style.display = 'none';
            carregarVarios(editUltimosResultados.map(p => p.cod_produto));
          });
          head.appendChild(btnTodos);
          editList.appendChild(head);

          data.forEach(product => {
            const item = document.createElement('div');
            item.className = 'list-group-item list-group-item-action';
            item.style.cursor = 'pointer';
            item.textContent = product.produto;
            item.addEventListener('click', function () {
              editSearch.value = product.produto;
              editList.style.display = 'none';
              carregarVarios([product.cod_produto]); // carrega só este
            });
            editList.appendChild(item);
          });
          editList.style.display = 'block';
        }
      });
    }

    // Enter dispara "carregar todos" os resultados atuais da busca.
    editSearch.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        if (editUltimosResultados.length) {
          editList.style.display = 'none';
          carregarVarios(editUltimosResultados.map(p => p.cod_produto));
        }
      }
    });

    document.addEventListener('click', function (e) {
      if (!e.target.closest('#edit_produto_search') && !e.target.closest('#edit_products_list')) {
        editList.style.display = 'none';
      }
    });

    editLimpar.addEventListener('click', function () {
      editSearch.value = '';
      editContainer.innerHTML = '';
      editUltimosResultados = [];
    });

    // ---- Carrega VÁRIOS produtos (um card cada), em sequência ----
    function carregarVarios(codigos) {
      editContainer.innerHTML = '';
      if (!codigos || !codigos.length) return;

      // carrega em sequência para não disparar dezenas de fetch ao mesmo tempo
      (async function () {
        for (const cod of codigos) {
          try {
            const r = await fetch(`${PRODUTO_URL}?cod_produto=${encodeURIComponent(cod)}`, {
              headers: { 'Accept': 'application/json' }
            });
            const data = await r.json();
            if (!data.error) montarCard(data);
          } catch (e) { /* ignora falha individual */ }
        }
      })();
    }

    function montarCard(data) {
      const frag = tplEdit.content.cloneNode(true);
      const card = frag.querySelector('.edit-produto-card');

      card.querySelector('.edit-nome-produto').textContent = data.nome || '';
      card.querySelector('.edit-cod-produto').textContent  = '#' + data.cod_produto;
      card.querySelector('.edit-titulo').value    = data.titulo || '';
      card.querySelector('.edit-descricao').value = data.descricao || '';

      // cores
      const selCor = card.querySelector('.edit-cod-cor');
      selCor.innerHTML = '';
      (data.cores || []).forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.cod_cor;
        opt.textContent = c.nmcor + ' - ' + c.cod_cor;
        selCor.appendChild(opt);
      });
      // seleciona a cor publicada (vinda do backend), se houver
      if (data.cod_cor_selecionada != null) {
        selCor.value = String(data.cod_cor_selecionada);
      }

      // ids únicos do checkbox publicado (por produto)
      const chk = card.querySelector('.edit-publicado');
      const lbl = card.querySelector('label[for="edit_pub_chk"]');
      const pubId = 'edit_pub_' + data.cod_produto;
      chk.id = pubId; if (lbl) lbl.setAttribute('for', pubId);

      editContainer.appendChild(frag);

      // estado próprio deste card
      const estado = {
        cod_produto: data.cod_produto,
        imagens: data.imagens || [],
        publicadoPorCor: data.publicado_por_cor || {},
        idxAtual: 0,
        card: card
      };
      stateDoCard.set(card, estado);

      // ao trocar a cor, reflete o "publicado" daquela cor
      selCor.addEventListener('change', function () {
        chk.checked = !!estado.publicadoPorCor[this.value];
      });
      selCor.dispatchEvent(new Event('change'));

      bindCardEventos(card);
      renderGaleria(card);
    }

    // ---- Galeria: navegação, contador, estado vazio (por card) ----
    function renderGaleria(card) {
      const estado = stateDoCard.get(card);
      if (!estado) return;
      const img        = card.querySelector('.edit-galeria-img');
      const vazia      = card.querySelector('.edit-galeria-vazia');
      const contador   = card.querySelector('.edit-contador');
      const btnRemover = card.querySelector('.edit-remover');
      const btnPrev    = card.querySelector('.edit-prev');
      const btnNext    = card.querySelector('.edit-next');

      const total = estado.imagens.length;
      if (total === 0) {
        img.style.display = 'none';
        vazia.style.display = 'block';
        contador.style.display = 'none';
        btnRemover.style.display = 'none';
        btnPrev.style.display = 'none';
        btnNext.style.display = 'none';
        return;
      }

      if (estado.idxAtual >= total) estado.idxAtual = total - 1;
      if (estado.idxAtual < 0) estado.idxAtual = 0;

      img.src = estado.imagens[estado.idxAtual].url;
      img.style.display = 'inline-block';
      vazia.style.display = 'none';
      btnRemover.style.display = 'inline-block';
      contador.style.display = 'inline-block';
      contador.textContent = (estado.idxAtual + 1) + ' / ' + total;

      const varias = total > 1;
      btnPrev.style.display = varias ? 'inline-block' : 'none';
      btnNext.style.display = varias ? 'inline-block' : 'none';
    }

    function bindCardEventos(card) {
      card.querySelector('.edit-prev').addEventListener('click', function () {
        const estado = stateDoCard.get(card);
        estado.idxAtual = (estado.idxAtual - 1 + estado.imagens.length) % estado.imagens.length;
        renderGaleria(card);
      });
      card.querySelector('.edit-next').addEventListener('click', function () {
        const estado = stateDoCard.get(card);
        estado.idxAtual = (estado.idxAtual + 1) % estado.imagens.length;
        renderGaleria(card);
      });

      // Remover imagem atual (lixeira) com confirmação
      card.querySelector('.edit-remover').addEventListener('click', function () {
        const estado = stateDoCard.get(card);
        const atual = estado.imagens[estado.idxAtual];
        if (!atual) return;
        if (!confirm('Tem certeza de que deseja remover esta imagem?')) return;
        removerImagem(card, atual.id);
      });

      // Adicionar imagem: abre o seletor de arquivo lembrando qual card pediu
      card.querySelector('.edit-add-imagem').addEventListener('click', function () {
        cardDoUpload = card;
        editFileInput.value = '';
        editFileInput.click();
      });

      // Salvar dados (título/descrição/cor/publicado)
      card.querySelector('.edit-salvar-dados').addEventListener('click', function () {
        salvarDados(card);
      });

      // Apagar TODAS as imagens do produto (ação em lote, com dupla confirmação)
      card.querySelector('.edit-apagar-todas').addEventListener('click', function () {
        apagarTodas(card);
      });
    }

    // ---- Apagar todas as imagens de um produto ----
    function apagarTodas(card) {
      const estado = stateDoCard.get(card);
      if (!estado) return;
      const total = estado.imagens.length;
      if (total === 0) { mostrarToast('Este produto não tem imagens.', 'warning'); return; }

      if (!confirm('Apagar TODAS as ' + total + ' imagem(ns) deste produto? Esta ação não pode ser desfeita.')) return;
      if (!confirm('Confirma mesmo? Todas as imagens serão removidas permanentemente.')) return;

      const dados = new FormData();
      dados.append('cod_produto', estado.cod_produto);

      mostrarToast('Apagando imagens...', 'warning');
      fetch(APAGAR_TODAS_URL, {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' },
        body: dados
      })
        .then(r => r.json())
        .then(res => {
          if (res.success) {
            estado.imagens = [];
            renderGaleria(card);
            mostrarToast((res.removidas || 0) + ' imagem(ns) apagada(s).', 'success');
          } else {
            mostrarToast('Falha: ' + (res.error || 'erro ao apagar'), 'danger');
          }
        })
        .catch(() => mostrarToast('Erro de conexão ao apagar.', 'danger'));
    }

    // ---- Remover imagem (reusa a rota destroy padrão) ----
    function removerImagem(card, id) {
      const estado = stateDoCard.get(card);
      const body = new FormData();
      body.append('_method', 'delete');
      body.append('term', 'cadastro_rapido'); // evita depender de @produto no controller

      fetch(`${urlBase}produto_imagens/${id}`, {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'text/html' },
        body: body
      })
        .then(r => {
          if (r.ok || r.redirected) {
            estado.imagens = estado.imagens.filter(im => im.id !== id);
            renderGaleria(card);
            mostrarToast('Imagem removida.', 'success');
          } else {
            mostrarToast('Falha ao remover a imagem.', 'danger');
          }
        })
        .catch(() => mostrarToast('Erro de conexão ao remover.', 'danger'));
    }

    // ---- Adicionar imagem (reusa cadastro_rapido_linha) ----
    let cardDoUpload = null; // card que acionou o seletor de arquivo
    editFileInput.addEventListener('change', function () {
      const file = this.files[0];
      const card = cardDoUpload;
      if (!file || !card) return;
      const estado = stateDoCard.get(card);

      const codCor = card.querySelector('.edit-cod-cor').value;
      if (!codCor) { mostrarToast('Selecione uma cor antes de adicionar a imagem.', 'warning'); return; }

      const dados = new FormData();
      dados.append('cod_produto', estado.cod_produto);
      dados.append('cod_cor', codCor);
      dados.append('descricao', card.querySelector('.edit-descricao').value || '');
      dados.append('titulo', card.querySelector('.edit-titulo').value || '');
      dados.append('publicado', card.querySelector('.edit-publicado').checked ? '1' : '0');
      dados.append('arquivo', file);
      dados.append('forcar', '1'); // na edição, não bloqueia por duplicidade

      mostrarToast('Enviando imagem...', 'warning');
      fetch(LINHA_URL, {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' },
        body: dados
      })
        .then(r => r.json())
        .then(res => {
          if (res.success) {
            mostrarToast('Imagem adicionada!', 'success');
            recarregarCard(card, estado.cod_produto);
          } else {
            mostrarToast('Falha: ' + (res.error || 'erro ao adicionar'), 'danger');
          }
        })
        .catch(() => mostrarToast('Erro de conexão ao adicionar.', 'danger'));
    });

    // Recarrega só as imagens de um card específico (após adicionar).
    function recarregarCard(card, codProduto) {
      fetch(`${PRODUTO_URL}?cod_produto=${encodeURIComponent(codProduto)}`, {
        headers: { 'Accept': 'application/json' }
      })
        .then(r => r.json())
        .then(data => {
          if (data.error) return;
          const estado = stateDoCard.get(card);
          estado.imagens = data.imagens || [];
          estado.publicadoPorCor = data.publicado_por_cor || {};
          renderGaleria(card);
        })
        .catch(() => {});
    }

    // ---- Salvar dados do produto (título/descrição/cor/publicado) ----
    function salvarDados(card) {
      const estado = stateDoCard.get(card);
      if (!estado) return;
      const status = card.querySelector('.edit-status');

      const dados = new FormData();
      dados.append('cod_produto', estado.cod_produto);
      dados.append('cod_cor', card.querySelector('.edit-cod-cor').value || '');
      dados.append('titulo', card.querySelector('.edit-titulo').value || '');
      dados.append('descricao', card.querySelector('.edit-descricao').value || '');
      dados.append('publicado', card.querySelector('.edit-publicado').checked ? '1' : '0');

      status.textContent = 'Salvando...';
      status.className = 'edit-status small text-muted';

      fetch(SALVAR_DADOS_URL, {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' },
        body: dados
      })
        .then(r => r.json())
        .then(res => {
          if (res.success) {
            const cor = card.querySelector('.edit-cod-cor').value;
            estado.publicadoPorCor[cor] = card.querySelector('.edit-publicado').checked;
            status.textContent = '✅ Salvo';
            status.className = 'edit-status small text-success';
            mostrarToast('Dados salvos!', 'success');
          } else {
            status.textContent = '⚠ ' + (res.error || 'Falha');
            status.className = 'edit-status small text-danger';
          }
        })
        .catch(() => {
          status.textContent = '⚠ Erro de conexão';
          status.className = 'edit-status small text-danger';
        });
    }
  });
</script>
