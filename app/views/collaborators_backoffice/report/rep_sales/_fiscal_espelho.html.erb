<%# =================================================================== %>
<%# ESPELHO FISCAL (somente leitura) da NF-e da venda, inline no relatorio. %>
<%# Monta o documento neutro via DocumentoFiscalBuilder (sem emitir).    %>
<%# Requer local :sale.                                                  %>
<%# =================================================================== %>
<%
  operacao = OperacaoFiscal.find_by(nome: "Venda")
  config   = FiscalConfig.find_by(cod_empresa: sale.cod_empresa)
  doc = nil
  erro_espelho = nil
  begin
    if operacao && config
      doc = Fiscal::DocumentoFiscalBuilder.new(sale, operacao: operacao, config: config, modelo: 55).montar
    else
      erro_espelho = "Configuração fiscal ausente (operação 'Venda' ou FiscalConfig)."
    end
  rescue => e
    erro_espelho = e.message
  end
%>

<div class="p-2 bg-light border rounded">
  <% if erro_espelho.present? %>
    <div class="alert alert-warning mb-0 py-2"><i class="fa fa-triangle-exclamation me-1"></i> <%= erro_espelho %></div>
  <% else %>
    <div class="row small mb-2">
      <div class="col-md-6">
        <strong>Natureza:</strong> <%= doc[:natureza] %> &nbsp;|&nbsp;
        <strong>Consumidor final:</strong> <%= doc[:consumidor_final] ? "Sim" : "Não" %>
      </div>
      <div class="col-md-6">
        <% cli = doc[:cliente] %>
        <strong>Destinatário:</strong>
        <% if cli.present? %>
          <%= cli["NmCliente"] %> — <%= cli["CpfCnpj"] || "sem CPF/CNPJ" %>
          <% if cli["Endereco"].present? %> (<%= [cli["Endereco"]["Municipio"], cli["Endereco"]["Uf"]].compact.join("/") %>)<% end %>
        <% else %>
          <span class="text-danger">sem destinatário</span>
        <% end %>
      </div>
    </div>

    <table class="table table-sm table-bordered mb-0 bg-white">
      <thead class="table-secondary">
        <tr>
          <th>Produto</th>
          <th>NCM</th>
          <th>CFOP</th>
          <th>Orig.</th>
          <th class="text-end">Qtd</th>
          <th class="text-end">Vl Unit.</th>
          <th class="text-end">Total</th>
          <th>CSOSN</th>
          <th>PIS</th>
          <th>COFINS</th>
          <th>IPI</th>
        </tr>
      </thead>
      <tbody>
        <% Array(doc[:produtos]).each do |p| %>
          <% imp = p["Imposto"] || {} %>
          <tr>
            <td><%= p["NmProduto"] %></td>
            <td><%= p["NCM"] || destaque_ausente %></td>
            <td><%= p["CFOP"] || destaque_ausente %></td>
            <td><%= p["OrigemProduto"] %></td>
            <td class="text-end"><%= p["Quantidade"] %></td>
            <td class="text-end"><%= number_to_currency(p["ValorUnitario"], unit: "", separator: ",", delimiter: ".") %></td>
            <td class="text-end"><%= number_to_currency(p["ValorTotal"], unit: "", separator: ",", delimiter: ".") %></td>
            <td><%= imp.dig("ICMS", "CodSituacaoTributaria") || destaque_ausente %></td>
            <td><%= imp.dig("PIS", "CodSituacaoTributaria") || "—" %></td>
            <td><%= imp.dig("COFINS", "CodSituacaoTributaria") || "—" %></td>
            <td><%= imp.dig("IPI", "CodSituacaoTributaria") || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
