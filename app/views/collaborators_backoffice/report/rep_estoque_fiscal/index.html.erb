<div class="card mt-2">
  <%= link_to collaborators_backoffice_report_estoque_fiscal_index_path, class: "card-header text-center bg-primary text-white" do %>
    <h3>Relatório de Estoque Fiscal</h3>
  <% end %>
  <div class="card-body">
    <% somaFiscal = 0 %>
    <% somaCusto = 0 %>
    <% somaVenda = 0 %>

    <% if flash[:error] %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= flash[:error] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>

    <%= form_with(url: collaborators_backoffice_report_estoque_fiscal_index_path, local: true, method: :get, class: "dataTable-search mb-4") do |form| %>
      <div class="row g-2 align-items-start">
        <div class="col-md-12">
          <div class="row g-1 align-items-center">
            <div class="col-md-1">
              <%= select_tag :per_page, options_for_select([30, 40, 70, 150, "Todas"], params[:per_page] || 30), onchange: 'this.form.submit()', class: "form-control" %>
            </div>
            <div class="col-md-3">
              <%= form.text_field :term, value: params[:term], class: "form-control", placeholder: "Código/Nome produto..." %>
            </div>
            <div class="col-md-2">
              <%= form.collection_select(:cod_marca, Marca.order(:nome), :cod_marca, :nome,
                                     { include_blank: 'Marca', selected: params[:cod_marca] },
                                     class: "form-control") %>
            </div>
            <div class="col-md-2">
              <%= form.collection_select(:cod_grupo, Grupo.where(ativo: true).order(:nomegrupo), :cod_grupo, :nomegrupo,
                                     { include_blank: 'Grupo', selected: params[:cod_grupo] },
                                     class: "form-control") %>
            </div>
            <div class="col-md-auto">
              <% com_estoque = params[:com_estoque_fiscal] == '1' %>
              <%= check_box_tag :com_estoque_fiscal, '1', com_estoque, class: "btn-check", id: "com-estoque-fiscal" %>
              <label class="btn btn-outline-primary" for="com-estoque-fiscal" style="min-width: 110px;">
                C/ Estoque
              </label>
            </div>
            <div class="col-md-auto">
              <button type="submit" class="btn btn-success" style="min-width: 110px;">
                Buscar
              </button>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <div class="dataTable-container">
      <table id="report-stock-fiscal" class="table table-bordered table-striped table-hover table-sm">
        <thead class="table-primary">
          <tr>
            <th data-sortable="true">Cód Produto</th>
            <th data-sortable="true">Nome</th>
            <th data-sortable="true" style="width: 15%;">Cor</th>
            <th data-sortable="true" style="width: 12%;">Marca</th>
            <th data-sortable="true" style="width: 12%;">Grupo</th>
            <th data-sortable="true" class="text-center" style="width: 6%;">Estoque</th>
            <% if access_control.admin? %>
              <th data-sortable="true" class="text-end" style="width: 8%;">Custo</th>
            <% end %>
            <th data-sortable="true" class="text-end" style="width: 8%;">Vl Venda</th>
          </tr>
        </thead>
        <tbody>
          <% @empresa_produtos.each do |estoque| %>
            <% valor_venda = estoque.valor_venda_calculado %>
            <% somaFiscal += estoque.qtdfiscal.to_f %>
            <% somaCusto  += estoque.ultimocusto.to_f * estoque.qtdfiscal.to_f %>
            <% somaVenda  += valor_venda.to_f * estoque.qtdfiscal.to_f %>
            <tr>
              <td class="align-middle"><%= estoque.full_codigo %></td>
              <td class="align-middle"><%= estoque.produto.nome %></td>
              <td class="align-middle"><%= estoque.cor.nmcor %></td>
              <td class="align-middle"><%= estoque.produto.cod_marca&.nome %></td>
              <td class="align-middle"><%= estoque.produto.cod_grupo&.nomegrupo %></td>
              <td class="align-middle text-center"><%= number_with_precision(estoque.qtdfiscal.to_f, precision: 2, delimiter: '.', separator: ',') %></td>
              <% if access_control.admin? %>
                <td class="align-middle">
                  <div class="d-flex justify-content-between gap-3">
                    <span>R$</span>
                    <span><%= number_to_currency(estoque.ultimocusto, unit: "", separator: ",", delimiter: ".", precision: 2) %></span>
                  </div>
                </td>
              <% end %>
              <td class="align-middle">
                <div class="d-flex justify-content-between gap-3">
                  <span>
                    R$
                    <% if estoque.valorvenda.to_f <= 0 && valor_venda.to_f > 0 %>
                      <i class="fa fa-calculator text-muted ms-1" title="Valor calculado pela margem (venda não cadastrada)"></i>
                    <% end %>
                  </span>
                  <span><%= number_to_currency(valor_venda, unit: "", separator: ",", delimiter: ".", precision: 2) %></span>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <th colspan="5" class="text-end">Total (página)</th>
            <th class="text-center"><%= number_with_precision(somaFiscal, precision: 2, delimiter: '.', separator: ',') %></th>
            <% if access_control.admin? %>
              <th>
                <div class="d-flex justify-content-between gap-3">
                  <span>R$</span>
                  <span><%= number_to_currency(somaCusto, unit: "", separator: ",", delimiter: ".", precision: 2) %></span>
                </div>
              </th>
            <% end %>
            <th>
              <div class="d-flex justify-content-between gap-3">
                <span>R$</span>
                <span><%= number_to_currency(somaVenda, unit: "", separator: ",", delimiter: ".", precision: 2) %></span>
              </div>
            </th>
          </tr>
        </tfoot>
      </table>
    </div>

    <% if @empresa_produtos.respond_to?(:total_pages) %>
      <div class="dataTable-bottom">
        <div class="dataTable-info"><%= page_entries_info @empresa_produtos, entry_name: 'item' %></div>
        <div class="text-center">
          <%= paginate @empresa_produtos %>
        </div>
      </div>
    <% else %>
      <div class="dataTable-bottom mb-9">
        <div class="dataTable-info">
          <h5>Exibindo <%= @empresa_produtos.size %> registros</h5>
        </div>
        <div class="text-center"></div>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.jQuery && jQuery.fn.DataTable) {
      $('#report-stock-fiscal').DataTable({
        "paging": false,
        "searching": false,
        "ordering": true,
        "info": false
      });
    }
  });
</script>
