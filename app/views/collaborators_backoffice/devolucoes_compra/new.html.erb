<div id="layoutAuthentication_content">
  <main>
    <div class="card-body">
      <div class="row justify-content-center">
        <div class="">
          <div class="card mt-3">
            <h4 class="card-header text-center bg-primary text-white">
              <i class="fa fa-rotate-left me-2"></i> Devolução de Compra
            </h4>

            <div class="card-body">
              <% unless @tem_xml %>
                <div class="alert alert-warning py-2">
                  <i class="fa fa-triangle-exclamation me-1"></i>
                  Sem XML da nota de compra disponível — os impostos não puderam ser espelhados automaticamente.
                  Revise os valores antes de emitir.
                </div>
              <% end %>

              <%= form_with url: collaborators_backoffice_compra_devolucao_path(@compra), method: :post, local: true do %>

                <%# ---- Fornecedor + NF de origem ---- %>
                <div class="row my-2 mx-1 align-items-center">
                  <div class="col-md-7">
                    <div class="form-floating">
                      <%= text_field_tag :fornecedor_nome, @compra.pessoa&.nome,
                            class: "form-control border-top-0 border-start-0 border-end-0 border-dark", readonly: true %>
                      <label>Fornecedor</label>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <div class="form-floating">
                      <%= text_field_tag :fornecedor_doc, @compra.pessoa&.cpf_cnpj,
                            class: "form-control border-top-0 border-start-0 border-end-0 border-dark", readonly: true %>
                      <label>CNPJ/CPF</label>
                    </div>
                  </div>
                  <div class="col-md-2">
                    <div class="form-floating">
                      <%= text_field_tag :nf_origem, @compra.numeronf,
                            class: "form-control border-top-0 border-start-0 border-end-0 border-dark", readonly: true %>
                      <label>NF de origem</label>
                    </div>
                  </div>
                </div>

                <%# ---- Operacao / Finalidade / Natureza / CFOP padrao ---- %>
                <div class="row my-2 mx-1 g-2">
                  <div class="col-md-3">
                    <div class="form-floating">
                      <%= select_tag :cod_operacao_fiscal,
                            options_from_collection_for_select(@operacoes, :cod_operacao_fiscal, :nome, @operacao_padrao&.cod_operacao_fiscal),
                            id: "operacaoGeral", class: "form-select" %>
                      <label>Operação (padrão)</label>
                    </div>
                    <small class="text-muted">Aplica a todos os itens e recalcula o CFOP.</small>
                  </div>
                  <div class="col-md-3">
                    <div class="form-floating">
                      <%= select_tag :finalidade,
                            options_for_select(@finalidades.map { |cod, nome| ["#{cod} - #{nome}", cod] }, 4),
                            class: "form-select" %>
                      <label>Finalidade</label>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="form-floating">
                      <%= text_field_tag :natureza_operacao, @operacao_padrao&.natureza_operacao || "Devolucao de compra", class: "form-control" %>
                      <label>Natureza da operação</label>
                    </div>
                  </div>
                  <div class="col-md-2">
                    <div class="form-floating">
                      <%= text_field_tag :cfop, nil, id: "cfopGeral", class: "form-control", placeholder: "ex: 5202" %>
                      <label>CFOP padrão</label>
                    </div>
                    <small class="text-muted">Aplica aos itens sem CFOP próprio.</small>
                  </div>
                </div>

                <div class="row my-2 mx-1">
                  <div class="col-md-12">
                    <div class="form-floating">
                      <%= text_field_tag :chave_referencia, @chave_referencia,
                            class: "form-control", placeholder: "Chave de 44 dígitos (se houver)" %>
                      <label>Documento referenciado (chave NF-e)</label>
                    </div>
                  </div>
                </div>

                <%# ---- Itens ---- %>
                <div class="table-responsive mt-2">
                  <table class="table table-sm align-middle table-light table-striped table-hover">
                    <thead>
                      <tr>
                        <th style="width:40px;" class="text-center">Dev?</th>
                        <th style="width:90px;">Cód</th>
                        <th>Produto (XML)</th>
                        <th style="width:90px;">NCM</th>
                        <th style="width:90px;">CFOP</th>
                        <th style="width:80px;" class="text-end">Qtd</th>
                        <th style="width:110px;" class="text-end">Vl Unit.</th>
                        <th>Impostos (espelho — editável)</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% @itens.each_with_index do |it, i| %>
                        <% imp0 = it[:imposto] || {} %>
                        <tr class="dev-item"
                            data-qtd-orig="<%= it[:quantidade_original].to_d %>"
                            data-icms-base="<%= (imp0[:icms] || {})[:base_calculo].to_d %>"
                            data-icms-valor="<%= (imp0[:icms] || {})[:valor].to_d %>"
                            data-ipi-valor="<%= (imp0[:ipi] || {})[:valor].to_d %>"
                            data-pis-base="<%= (imp0[:pis] || {})[:base_calculo].to_d %>"
                            data-cofins-base="<%= (imp0[:cofins] || {})[:base_calculo].to_d %>">
                          <td class="text-center">
                            <%= check_box_tag "itens[#{i}][devolver]", "1", true %>
                          </td>
                          <td>
                            <span class="fw-semibold"><%= it[:cod_produto] %></span>
                            <% if it[:cod_cor].present? %><div class="small text-muted">cor <%= it[:cod_cor] %></div><% end %>
                          </td>
                          <td><%= it[:descricao] %></td>
                          <td><%= it[:ncm] %></td>
                          <td style="min-width:150px;">
                            <%# Operacao por item: ao trocar, resolve o CFOP pela regra do perfil. %>
                            <%= select_tag "itens[#{i}][cod_operacao_fiscal]",
                                  options_from_collection_for_select(@operacoes, :cod_operacao_fiscal, :nome, @operacao_padrao&.cod_operacao_fiscal),
                                  class: "form-select form-select-sm mb-1 dev-op-item",
                                  data: { cod_produto: it[:cod_produto], cfop_original: it[:cfop_original] } %>
                            <%# CFOP por item: pre-preenchido pela regra; editavel. %>
                            <%= text_field_tag "itens[#{i}][cfop]", it[:cfop_sugerido],
                                  class: "form-control form-control-sm text-end dev-cfop",
                                  placeholder: "CFOP" %>
                          </td>
                          <td class="text-end">
                            <%= text_field_tag "itens[#{i}][quantidade]",
                                  number_with_precision(it[:quantidade], precision: 2, separator: ",", delimiter: ""),
                                  class: "form-control form-control-sm text-end dev-qtd" %>
                          </td>
                          <td class="text-end">
                            <%= text_field_tag "itens[#{i}][valor_unitario]",
                                  number_with_precision(it[:valor_unitario], precision: 2, separator: ",", delimiter: ""),
                                  class: "form-control form-control-sm text-end" %>
                          </td>
                          <td class="small">
                            <% imp = it[:imposto] || {} %>
                            <% if imp.present? %>
                              <% q_orig = it[:quantidade_original].to_d
                                 q_dev  = it[:quantidade].to_d
                                 fator  = (q_orig.nonzero? && q_dev.nonzero?) ? (q_dev / q_orig) : 1.to_d
                                 icms   = imp[:icms] || {}
                                 ipi    = imp[:ipi] || {}
                                 pis    = imp[:pis] || {}
                                 cof    = imp[:cofins] || {}
                                 rateia = ->(v) { v.to_d.nonzero? ? (v.to_d * fator).round(2) : nil } %>

                              <% if icms.present? %>
                                <div class="d-flex align-items-center gap-1 mb-1 flex-wrap">
                                  <span class="text-muted" style="width:42px;">ICMS</span>
                                  <% icms_base_auto = rateia.(icms[:base_calculo]) ? number_with_precision(rateia.(icms[:base_calculo]), precision: 2, separator: ",", delimiter: "") : "" %>
                                  <% icms_valor_auto = rateia.(icms[:valor]) ? number_with_precision(rateia.(icms[:valor]), precision: 2, separator: ",", delimiter: "") : "" %>
                                  <span class="input-group input-group-sm" style="max-width:150px;">
                                    <span class="input-group-text">Base</span>
                                    <%= text_field_tag "itens[#{i}][icms_base]", icms_base_auto, class: "form-control text-end imp-field", data: { campo: "icms_base" }, placeholder: "0,00" %>
                                    <%= hidden_field_tag "itens[#{i}][icms_base_auto]", icms_base_auto, class: "imp-auto", data: { campo: "icms_base" } %>
                                  </span>
                                  <span class="input-group input-group-sm" style="max-width:150px;">
                                    <span class="input-group-text">R$</span>
                                    <%= text_field_tag "itens[#{i}][icms_valor]", icms_valor_auto, class: "form-control text-end imp-field", data: { campo: "icms_valor" }, placeholder: "0,00" %>
                                    <%= hidden_field_tag "itens[#{i}][icms_valor_auto]", icms_valor_auto, class: "imp-auto", data: { campo: "icms_valor" } %>
                                  </span>
                                  <span class="text-muted">CST <%= icms[:cst] || "—" %> · <%= icms[:aliquota] %>%</span>
                                </div>
                              <% end %>

                              <% if ipi.present? %>
                                <div class="d-flex align-items-center gap-1 mb-1 flex-wrap">
                                  <span class="text-muted" style="width:42px;">IPI</span>
                                  <% ipi_valor_auto = rateia.(ipi[:valor]) ? number_with_precision(rateia.(ipi[:valor]), precision: 2, separator: ",", delimiter: "") : "" %>
                                  <span class="input-group input-group-sm" style="max-width:150px;">
                                    <span class="input-group-text">R$</span>
                                    <%= text_field_tag "itens[#{i}][ipi_valor]", ipi_valor_auto, class: "form-control text-end imp-field", data: { campo: "ipi_valor" }, placeholder: "0,00" %>
                                    <%= hidden_field_tag "itens[#{i}][ipi_valor_auto]", ipi_valor_auto, class: "imp-auto", data: { campo: "ipi_valor" } %>
                                  </span>
                                  <span class="text-muted">CST <%= ipi[:cst] || "—" %> · <%= ipi[:aliquota] %>%</span>
                                </div>
                              <% end %>

                              <% if pis.present? %>
                                <span class="badge text-bg-light border me-1">PIS base <span class="imp-pis"><%= number_with_precision(rateia.(pis[:base_calculo]), precision: 2, separator: ",", delimiter: ".") %></span> · <%= pis[:aliquota] %>%</span>
                              <% end %>
                              <% if cof.present? %>
                                <span class="badge text-bg-light border me-1">COFINS base <span class="imp-cofins"><%= number_with_precision(rateia.(cof[:base_calculo]), precision: 2, separator: ",", delimiter: ".") %></span> · <%= cof[:aliquota] %>%</span>
                              <% end %>
                              <div class="text-muted" style="font-size:11px;">Rateado pela quantidade. Edite se precisar ajustar.</div>
                            <% else %>
                              <span class="text-muted">sem impostos destacados</span>
                            <% end %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>

                <div class="d-flex justify-content-between mt-3">
                  <%= link_to "Voltar à compra", collaborators_backoffice_compra_path(@compra), class: "btn btn-secondary" %>
                  <div class="d-flex gap-2">
                    <%# Pre-visualizar: submete o mesmo form para a acao de preview, em nova aba. %>
                    <button type="submit" class="btn btn-outline-info"
                            formaction="<%= previsualizar_collaborators_backoffice_compra_devolucao_path(@compra) %>"
                            formtarget="_blank" formnovalidate>
                      <i class="fa fa-file-pdf me-1"></i> Pré-visualizar
                    </button>
                    <button type="submit" class="btn btn-success"
                            onclick="return confirm('Emitir a NF-e de devolução desta compra?');">
                      <i class="fa fa-check-double me-1"></i> Emitir devolução
                    </button>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<script>
  // Recalcula ao vivo os impostos rateados quando a QUANTIDADE do item muda.
  // Espelha o rateio do backend: valor_rateado = valor_cheio * (qtd / qtd_orig).
  // So atualiza os campos que o usuario NAO editou manualmente (continuam == auto).
  (function () {
    function parseBR(v) {
      if (v == null) return 0;
      return parseFloat(String(v).replace(/\./g, '').replace(',', '.')) || 0;
    }
    function fmtBR(n) {
      return (n || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function recalcLinha(tr) {
      var qtdOrig = parseFloat(tr.getAttribute('data-qtd-orig')) || 0;
      var qtdDev  = parseBR(tr.querySelector('.dev-qtd') ? tr.querySelector('.dev-qtd').value : 0);
      var fator   = (qtdOrig > 0 && qtdDev > 0) ? (qtdDev / qtdOrig) : 1;

      var cheio = {
        icms_base:  parseFloat(tr.getAttribute('data-icms-base'))  || 0,
        icms_valor: parseFloat(tr.getAttribute('data-icms-valor')) || 0,
        ipi_valor:  parseFloat(tr.getAttribute('data-ipi-valor'))  || 0
      };

      tr.querySelectorAll('.imp-field').forEach(function (input) {
        var campo = input.getAttribute('data-campo');
        if (!(campo in cheio)) return;
        var autoEl = tr.querySelector('.imp-auto[data-campo="' + campo + '"]');
        var autoVal = autoEl ? autoEl.value : '';
        var alteradoManual = (input.value.trim() !== String(autoVal).trim());
        var novo = cheio[campo] ? fmtBR(Math.round(cheio[campo] * fator * 100) / 100) : '';
        if (autoEl) autoEl.value = novo;
        if (!alteradoManual) input.value = novo;
      });

      var pis = parseFloat(tr.getAttribute('data-pis-base')) || 0;
      var cof = parseFloat(tr.getAttribute('data-cofins-base')) || 0;
      var pisEl = tr.querySelector('.imp-pis');
      var cofEl = tr.querySelector('.imp-cofins');
      if (pisEl) pisEl.textContent = fmtBR(Math.round(pis * fator * 100) / 100);
      if (cofEl) cofEl.textContent = fmtBR(Math.round(cof * fator * 100) / 100);
    }

    document.querySelectorAll('tr.dev-item').forEach(function (tr) {
      var qtd = tr.querySelector('.dev-qtd');
      if (qtd) {
        qtd.addEventListener('input', function () { recalcLinha(tr); });
        qtd.addEventListener('blur', function () { recalcLinha(tr); });
      }
    });
  })();

  // Resolve o CFOP pela regra fiscal ao trocar a OPERACAO (no topo = todos os
  // itens; por item = so a linha). Chama o endpoint resolver_cfop.
  (function () {
    var RESOLVER_URL = "<%= resolver_cfop_collaborators_backoffice_compra_devolucao_path(@compra) %>";

    function resolverItem(tr) {
      var sel  = tr.querySelector('.dev-op-item');
      var cfop = tr.querySelector('.dev-cfop');
      if (!sel || !cfop) return;
      var codProduto    = sel.getAttribute('data-cod-produto');
      var cfopOriginal  = sel.getAttribute('data-cfop-original') || '';
      var codOperacao   = sel.value;

      var url = RESOLVER_URL + '?cod_produto=' + encodeURIComponent(codProduto) +
                '&cod_operacao_fiscal=' + encodeURIComponent(codOperacao) +
                '&cfop_original=' + encodeURIComponent(cfopOriginal);
      fetch(url, { headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.json().catch(function () { return null; }); })
        .then(function (d) {
          if (d && d.cfop) { cfop.value = d.cfop; }
        })
        .catch(function (e) { console.error('resolver_cfop:', e); });
    }

    // Troca por item.
    document.querySelectorAll('tr.dev-item .dev-op-item').forEach(function (sel) {
      sel.addEventListener('change', function () {
        resolverItem(sel.closest('tr.dev-item'));
      });
    });

    // Troca no topo: aplica a todos os itens (sincroniza o seletor da linha
    // e resolve o CFOP de cada um).
    var geral = document.getElementById('operacaoGeral');
    if (geral) {
      geral.addEventListener('change', function () {
        document.querySelectorAll('tr.dev-item').forEach(function (tr) {
          var sel = tr.querySelector('.dev-op-item');
          if (sel) { sel.value = geral.value; resolverItem(tr); }
        });
      });
    }
  })();
</script>
