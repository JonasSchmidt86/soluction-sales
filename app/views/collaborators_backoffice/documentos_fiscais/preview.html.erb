<div id="layoutAuthentication_content">
  <main>
    <div class="card mt-3">
      <div class="card-header bg-primary text-white d-flex align-items-center">
        <i class="fa fa-file-invoice me-2"></i>
        <h4 class="mb-0">Prévia Fiscal — NF-e (modelo 55)</h4>
      </div>

      <div class="card-body">
        <p class="text-muted">
          Confira abaixo os dados que irão na NF-e. Nada foi enviado à SEFAZ ainda.
        </p>

        <%# ---- Pendencias / avisos ---- %>
        <% if @pendencias.present? %>
          <div class="alert alert-warning">
            <strong><i class="fa fa-triangle-exclamation me-1"></i> Pendências que podem causar rejeição:</strong>
            <ul class="mb-0 mt-2">
              <% @pendencias.each do |p| %>
                <li><%= p %></li>
              <% end %>
            </ul>
          </div>
        <% else %>
          <div class="alert alert-success py-2">
            <i class="fa fa-check me-1"></i> Dados fiscais completos.
          </div>
        <% end %>

        <%# ---- Cabecalho ---- %>
        <div class="row mb-3">
          <div class="col-md-6">
            <strong>Natureza da operação:</strong> <%= @documento_neutro[:natureza] %><br>
            <strong>Finalidade:</strong> <%= @documento_neutro[:finalidade] == 1 ? "Normal" : @documento_neutro[:finalidade] %><br>
            <strong>Consumidor final:</strong> <%= @documento_neutro[:consumidor_final] ? "Sim" : "Não" %>
          </div>
          <div class="col-md-6">
            <% cli = @documento_neutro[:cliente] %>
            <strong>Destinatário:</strong><br>
            <% if cli.present? %>
              <%= cli["NmCliente"] %><br>
              CPF/CNPJ: <%= cli["CpfCnpj"] || "—" %><br>
              <% if cli["Endereco"].present? %>
                <%= [cli["Endereco"]["Logradouro"], cli["Endereco"]["Numero"], cli["Endereco"]["Bairro"]].compact.join(", ") %><br>
                <%= [cli["Endereco"]["Municipio"], cli["Endereco"]["Uf"]].compact.join(" / ") %>
              <% else %>
                <span class="text-danger">Sem endereço</span>
              <% end %>
            <% else %>
              <span class="text-danger">Sem destinatário</span>
            <% end %>
          </div>
        </div>

        <%# ---- Itens com tributacao ---- %>
        <div class="table-responsive">
          <table class="table table-sm table-bordered align-middle">
            <thead class="table-dark">
              <tr>
                <th>Produto</th>
                <th>NCM</th>
                <th>CFOP</th>
                <th>Orig.</th>
                <th class="text-end">Qtd</th>
                <th class="text-end">Vl Unit.</th>
                <th class="text-end">Total</th>
                <th>ICMS (CSOSN)</th>
                <th>PIS</th>
                <th>COFINS</th>
                <th>IPI</th>
              </tr>
            </thead>
            <tbody>
              <% Array(@documento_neutro[:produtos]).each do |p| %>
                <% imp = p["Imposto"] || {} %>
                <tr>
                  <td><%= p["NmProduto"] %></td>
                  <td><%= p["NCM"] || destaque_ausente %></td>
                  <td><%= p["CFOP"] || destaque_ausente %></td>
                  <td><%= p["OrigemProduto"] %></td>
                  <td class="text-end"><%= p["Quantidade"] %></td>
                  <td class="text-end"><%= number_to_currency(p["ValorUnitario"], unit: "", separator: ",", delimiter: ".") %></td>
                  <td class="text-end"><%= number_to_currency(p["ValorTotal"], unit: "", separator: ",", delimiter: ".") %></td>
                  <td><%= (imp.dig("ICMS", "CodSituacaoTributaria") || destaque_ausente) %></td>
                  <td><%= imp.dig("PIS", "CodSituacaoTributaria") || "—" %></td>
                  <td><%= imp.dig("COFINS", "CodSituacaoTributaria") || "—" %></td>
                  <td><%= imp.dig("IPI", "CodSituacaoTributaria") || "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <%# ---- Acoes ---- %>
        <div class="d-flex justify-content-between mt-3">
          <%= link_to edit_collaborators_backoffice_venda_path(@venda),
                      class: "btn btn-secondary" do %>
            <i class="fa fa-arrow-left me-1"></i> Voltar à venda
          <% end %>

          <%= button_to emitir_collaborators_backoffice_venda_documentos_fiscais_path(@venda),
                        method: :post, class: "btn btn-primary",
                        data: { confirm: "Confirmar e emitir a NF-e agora?" } do %>
            <i class="fa fa-check-double me-1"></i> Confirmar e emitir
          <% end %>
        </div>
      </div>
    </div>
  </main>
</div>
