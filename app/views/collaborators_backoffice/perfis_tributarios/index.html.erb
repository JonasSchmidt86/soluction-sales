<div class="container-fluid mt-3">
  <div class="card">
    <div class="card-header bg-primary d-flex align-items-center">
      <h4 class="text-white mb-0"><i class="fa fa-file-invoice-dollar me-2"></i> Perfis Tributários</h4>
      <div class="ms-auto">
        <%= link_to new_collaborators_backoffice_perfil_tributario_path, class: "btn btn-light" do %>
          <i class="fa fa-plus me-1"></i> Novo Perfil
        <% end %>
      </div>
    </div>
    <div class="card-body">
      <% if @perfis.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead>
              <tr>
                <th>Nome</th>
                <th>Descrição</th>
                <th class="text-center">Regras</th>
                <th class="text-center">Produtos</th>
                <th class="text-center">Ativo</th>
                <th class="text-end">Ações</th>
              </tr>
            </thead>
            <tbody>
              <% @perfis.each do |perfil| %>
                <tr>
                  <td><%= perfil.nome %></td>
                  <td class="text-muted"><%= perfil.descricao %></td>
                  <td class="text-center"><span class="badge bg-secondary"><%= perfil.regras.size %></span></td>
                  <% qtd_produtos = perfil.produtos.count %>
                  <td class="text-center"><span class="badge bg-info"><%= qtd_produtos %></span></td>
                  <td class="text-center">
                    <% if perfil.ativo %>
                      <span class="badge bg-success">Sim</span>
                    <% else %>
                      <span class="badge bg-secondary">Não</span>
                    <% end %>
                  </td>
                  <td class="text-end">
                    <%= link_to collaborators_backoffice_perfil_tributario_path(perfil), class: "btn btn-sm btn-light" do %>
                      <i class="fa fa-eye"></i>
                    <% end %>
                    <%= link_to edit_collaborators_backoffice_perfil_tributario_path(perfil), class: "btn btn-sm btn-light" do %>
                      <i class="fa fa-pencil"></i>
                    <% end %>
                    <% if qtd_produtos.zero? %>
                      <%= link_to collaborators_backoffice_perfil_tributario_path(perfil),
                            method: :delete,
                            data: { confirm: "Excluir o perfil \"#{perfil.nome}\"?" },
                            class: "btn btn-sm btn-outline-danger" do %>
                        <i class="fa fa-trash"></i>
                      <% end %>
                    <% else %>
                      <span class="btn btn-sm btn-light disabled text-muted"
                            title="Não pode excluir: há <%= qtd_produtos %> produto(s) usando este perfil">
                        <i class="fa fa-trash"></i>
                      </span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="fa fa-file-invoice-dollar fa-3x text-muted mb-3"></i>
          <p class="text-muted">Nenhum perfil tributário cadastrado.</p>
          <%= link_to new_collaborators_backoffice_perfil_tributario_path, class: "btn btn-primary" do %>
            <i class="fa fa-plus me-1"></i> Criar primeiro perfil
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
