<div class="container-fluid">
  <div class="row">
    <!-- Coluna principal -->
    <div class="col-lg-8">
      <!-- Card da solicitação -->
      <div class="card shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
          <div>
            <span class="badge bg-<%= @melhoria.status_cor %> me-1"><%= @melhoria.status_label %></span>
            <span class="badge bg-<%= @melhoria.prioridade_cor %>"><%= @melhoria.prioridade_label %></span>
          </div>
          <div>
            <% if current_collaborator.funcionario.permissao.nivel == 1 %>
              <%= link_to edit_collaborators_backoffice_melhoria_path(@melhoria), class: "btn btn-sm btn-outline-warning" do %>
                <i class="fa fa-edit"></i> Editar
              <% end %>
              <%= link_to collaborators_backoffice_melhoria_path(@melhoria), method: :delete,
                    data: { confirm: "Tem certeza que deseja excluir esta solicitação? Esta ação não pode ser desfeita." },
                    class: "btn btn-sm btn-outline-danger ms-1" do %>
                <i class="fa fa-trash"></i> Excluir
              <% end %>
            <% end %>
          </div>
        </div>
        <div class="card-body">
          <h4 class="card-title">
            <i class="fa <%= @melhoria.tipo_icone %> me-1 text-muted"></i>
            #<%= @melhoria.id %> — <%= @melhoria.titulo %>
          </h4>
          <p class="text-muted small mb-3">
            <i class="fa fa-user me-1"></i> <%= @melhoria.solicitante_nome %>
            &nbsp;•&nbsp;
            <i class="fa fa-calendar me-1"></i> <%= l(@melhoria.created_at, format: :short) rescue @melhoria.created_at.strftime("%d/%m/%Y %H:%M") %>
            &nbsp;•&nbsp;
            <i class="fa <%= @melhoria.tipo_icone %> me-1"></i> <%= @melhoria.tipo_label %>
          </p>
          <hr>
          <div class="mt-3" style="white-space: pre-wrap;"><%= @melhoria.descricao %></div>
        </div>
      </div>

      <!-- Anexos da solicitação -->
      <% if @melhoria.anexos.attached? %>
        <div class="card shadow-sm mb-3">
          <div class="card-header">
            <i class="fa fa-paperclip me-1"></i> Anexos (<%= @melhoria.anexos.count %>)
          </div>
          <div class="card-body">
            <div class="row g-2">
              <% @melhoria.anexos.each do |anexo| %>
                <div class="col-md-4 col-sm-6">
                  <div class="border rounded p-2 text-center position-relative">
                    <% if anexo.content_type.start_with?('image/') %>
                      <%= link_to rails_blob_path(anexo, disposition: "inline"), target: "_blank" do %>
                        <%= image_tag rails_blob_path(anexo, disposition: "inline"),
                              class: "img-fluid rounded", style: "max-height: 120px;" %>
                      <% end %>
                    <% else %>
                      <%= link_to rails_blob_path(anexo, disposition: "attachment"), class: "text-decoration-none" do %>
                        <i class="fa fa-file fa-2x text-muted"></i>
                        <br>
                        <small class="text-truncate d-block"><%= anexo.filename %></small>
                      <% end %>
                    <% end %>
                    <div class="mt-1">
                      <small class="text-muted"><%= number_to_human_size(anexo.byte_size) %></small>
                      <% if current_collaborator.funcionario.permissao.nivel == 1 %>
                        <%= link_to remover_anexo_collaborators_backoffice_melhoria_path(@melhoria, anexo_id: anexo.id),
                              method: :delete, data: { confirm: "Remover este anexo?" },
                              class: "text-danger ms-1", title: "Remover" do %>
                          <i class="fa fa-trash-o"></i>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Comentários -->
      <div class="card shadow-sm mb-3">
        <div class="card-header">
          <i class="fa fa-comments me-1"></i> Comentários (<%= @comentarios.size %>)
        </div>
        <div class="card-body">
          <% if @comentarios.any? %>
            <% @comentarios.each do |comentario| %>
              <div class="d-flex mb-3 pb-3 border-bottom">
                <div class="flex-shrink-0">
                  <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                    <i class="fa fa-user"></i>
                  </div>
                </div>
                <div class="flex-grow-1 ms-3">
                  <div class="d-flex justify-content-between">
                    <strong><%= comentario.autor_nome %></strong>
                    <small class="text-muted"><%= comentario.created_at.strftime("%d/%m/%Y %H:%M") %></small>
                  </div>
                  <div class="mt-1" style="white-space: pre-wrap;"><%= comentario.comentario %></div>
                  <% if comentario.anexos.attached? %>
                    <div class="mt-2">
                      <% comentario.anexos.each do |anexo| %>
                        <% if anexo.content_type.start_with?('image/') %>
                          <%= link_to rails_blob_path(anexo, disposition: "inline"), target: "_blank", class: "me-2" do %>
                            <%= image_tag rails_blob_path(anexo, disposition: "inline"),
                                  class: "rounded border", style: "max-height: 80px;" %>
                          <% end %>
                        <% else %>
                          <%= link_to rails_blob_path(anexo, disposition: "attachment"), class: "btn btn-sm btn-outline-secondary me-1" do %>
                            <i class="fa fa-download me-1"></i><%= truncate(anexo.filename.to_s, length: 25) %>
                          <% end %>
                        <% end %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted text-center mb-0">Nenhum comentário ainda.</p>
          <% end %>
        </div>

        <!-- Formulário de novo comentário -->
        <div class="card-footer bg-light">
          <%= form_with(model: @comentario, url: comentar_collaborators_backoffice_melhoria_path(@melhoria), local: true, html: { multipart: true }) do |f| %>
            <div class="mb-2">
              <%= f.text_area :comentario, class: "form-control", rows: 3, placeholder: "Escreva um comentário..." %>
            </div>
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <%= f.file_field :anexos, multiple: true, class: "form-control form-control-sm", style: "max-width: 300px;",
                      accept: "image/*,.pdf,.doc,.docx,.xls,.xlsx,.txt" %>
              </div>
              <%= f.submit "Comentar", class: "btn btn-sm btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Coluna lateral -->
    <div class="col-lg-4">
      <!-- Informações -->
      <div class="card shadow-sm mb-3">
        <div class="card-header">
          <i class="fa fa-info-circle me-1"></i> Informações
        </div>
        <div class="card-body p-0">
          <table class="table table-sm mb-0">
            <tbody>
              <tr>
                <td class="text-muted fw-semibold" style="width: 40%;">Status</td>
                <td><span class="badge bg-<%= @melhoria.status_cor %>"><%= @melhoria.status_label %></span></td>
              </tr>
              <tr>
                <td class="text-muted fw-semibold">Prioridade</td>
                <td><span class="badge bg-<%= @melhoria.prioridade_cor %>"><%= @melhoria.prioridade_label %></span></td>
              </tr>
              <tr>
                <td class="text-muted fw-semibold">Tipo</td>
                <td><i class="fa <%= @melhoria.tipo_icone %> me-1"></i> <%= @melhoria.tipo_label %></td>
              </tr>
              <tr>
                <td class="text-muted fw-semibold">Solicitante</td>
                <td><%= @melhoria.solicitante_nome %></td>
              </tr>
              <% if current_collaborator.funcionario.permissao.nivel == 1 %>
              <tr>
                <td class="text-muted fw-semibold">Empresa</td>
                <td><%= @melhoria.empresa&.nome %></td>
              </tr>
              <% end %>
              <tr>
                <td class="text-muted fw-semibold">Responsável</td>
                <td><%= @melhoria.responsavel_nome || '—' %></td>
              </tr>
              <tr>
                <td class="text-muted fw-semibold">Aberta em</td>
                <td><%= @melhoria.created_at.strftime("%d/%m/%Y %H:%M") %></td>
              </tr>
              <% if @melhoria.updated_at != @melhoria.created_at %>
                <tr>
                  <td class="text-muted fw-semibold">Atualizada</td>
                  <td><%= @melhoria.updated_at.strftime("%d/%m/%Y %H:%M") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Histórico de alterações -->
      <% if @historicos.any? %>
        <div class="card shadow-sm mb-3">
          <div class="card-header">
            <i class="fa fa-history me-1"></i> Histórico
          </div>
          <div class="card-body p-2">
            <% @historicos.each do |hist| %>
              <div class="small mb-2 pb-2 border-bottom">
                <strong><%= hist.autor_nome %></strong>
                <%= hist.descricao_alteracao %>
                <br>
                <span class="text-muted"><%= hist.created_at.strftime("%d/%m/%Y %H:%M") %></span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Botão voltar -->
      <div class="d-grid">
        <%= link_to collaborators_backoffice_melhorias_path, class: "btn btn-outline-secondary" do %>
          <i class="fa fa-arrow-left me-1"></i> Voltar à listagem
        <% end %>
      </div>
    </div>
  </div>
</div>
