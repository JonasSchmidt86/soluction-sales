<div class="card mt-4">
  <%= link_to collaborators_backoffice_empresa_estoque_index_path, class:"card-header text-center bg-primary text-white" do %>
    <h4> <%= "#{action_message} Valor de venda!" %></h4>
  <% end %>
  <div class="card-body">
    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
      <div class="position-relative" style="max-width: 260px; flex: 1 1 260px;">
        <input type="text" id="filtro-nome-produto" class="text form-control form-control-sm produto_search" placeholder="Nome ou código do Produto" autocomplete="off">
        <input type="hidden" id="filtro-cod-produto">
        <div id="produtos_list" class="list-group position-absolute" style="display: none; z-index: 1000; width: 100%;"></div>
      </div>
      <input type="text" id="filtro-cod-cor" class="form-control form-control-sm" placeholder="Código da Cor" style="max-width: 160px;" inputmode="numeric" pattern="[0-9]*">
      <input type="text" id="filtro-cod-compra" class="form-control form-control-sm" placeholder="Código da Compra" style="max-width: 160px;" inputmode="numeric" pattern="[0-9]*">
      <button type="button" id="btn-buscar-estoque" class="btn btn-success btn-sm">Buscar</button>

      <div class="ms-auto d-flex align-items-center gap-3">
        <div class="form-check mb-0" title="Arredonda o Vl Venda para cima ao próximo múltiplo de 5">
          <input class="form-check-input" type="checkbox" id="chk-arredondar">
          <label class="form-check-label small" for="chk-arredondar">Arredondar Vl Venda (↑ múltiplo de 5)</label>
        </div>
        <button type="button" id="btn-salvar-todos" class="btn btn-primary btn-sm">
          <i class="fa fa-save"></i> Salvar todos
        </button>
      </div>
    </div>
    <div class="dataTable-wrapper dataTable-loading no-footer sortable searchable fixed-columns">
      <div class="dataTable-container">
        <table id="datatablesSimple" class="dataTable-table table-striped" style="width: 100%;">
          <thead>
            <tr>
              <th data-sortable="" style="width: 3%;">Emp..</th>
              <th data-sortable="" style="width: 7%;">Codigo</th>
              <th data-sortable="">Nome</th>
              <th data-sortable="" style="width: 20%;">Cor</th>
              <th data-sortable="" style="width: 7%;">Qtd</th>
              <th style="width: 100px">Qtd Min</th>
              <th style="width: 100px">Vl Venda</th>
              <th data-sortable="" style="width: 8%;">Custo</th>
              <th data-sortable="" style="width: 55px;">Grava</th>
            </tr>
          </thead>
          <tbody>
            <% @empresa_produtos.each do |estoque| %>
              <tr>
                <td class="align-middle text-center"><%= estoque.cod_empresa %> </td>
                <td class="align-middle "><%= estoque.full_codigo %> </td>
                <td class="align-middle "><%= estoque.produto.nome %> </td>
                <td class="align-middle "><%= estoque.cor.nmcor %> </td>
                <td class="align-middle "><%= estoque.quantidade.to_i %> </td>
                <td class="align-middle ">
                  <input type="number" 
                              class="form-control form-control-sm editable-qtd-minima" 
                              data-id="<%= estoque.id %>" 
                              value="<%= estoque.quantidademinima.to_i %>">
                </td>
                <td class="align-middle ">
                  <input type="text" 
                              input_html= { inputmode: "numeric", pattern: "[0-9]*" }
                              class="money2 form-control form-control-sm editable-valor-venda" 
                              data-id="<%= estoque.id %>" 
                              value="<%= number_with_precision(estoque.valorvenda, precision: 2, separator: ',', delimiter: '') %>">
                </td>
                <td class="align-middle fw-semibold"><%= "R$ #{number_to_currency( estoque.ultimocusto, separator: ",", delimiter: "", unit:"")}" %> </td>
                <td class="align-middle">
                  <%= link_to "#", class: "btn btn-success btn-circle salvar-dados", data: { id: estoque.id } do %>
                    <i class="fa fa-check"></i>
                  <% end %>
                </td>
              </td>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <script>
    window.addEventListener('load', function() {
      function buscarEstoque() {
        var codProduto = document.getElementById('filtro-cod-produto').value.trim();
        var codCompra  = document.getElementById('filtro-cod-compra').value.trim();
        var codCor  = document.getElementById('filtro-cod-cor').value.trim();
        if (codProduto) {
          window.location.href = '/collaborators_backoffice/empresa_estoque/' + codProduto + '/edit?cod_cor=' + codCor + '&format=produto';
        } else if (codCompra) {
          window.location.href = '/collaborators_backoffice/empresa_estoque/' + codCompra + '/edit?format=compra';
        }
      }

      document.getElementById('btn-buscar-estoque').addEventListener('click', buscarEstoque);

      // ---------- Campos de cor e compra: apenas números ----------
      ['filtro-cod-cor', 'filtro-cod-compra'].forEach(function(id) {
        var campo = document.getElementById(id);
        // Bloqueia qualquer caractere que não seja digito na digitacao
        campo.addEventListener('keydown', function(e) {
          var permitidas = ['Backspace', 'Delete', 'Tab', 'Escape', 'Enter',
                            'ArrowLeft', 'ArrowRight', 'Home', 'End'];
          if (permitidas.includes(e.key)) { return; }
          if (e.ctrlKey || e.metaKey) { return; } // permite copiar/colar/selecionar
          if (!/^[0-9]$/.test(e.key)) { e.preventDefault(); }
        });
        // Remove qualquer nao-digito que entre por colar/arrastar
        campo.addEventListener('input', function() {
          this.value = this.value.replace(/\D/g, '');
        });
      });

      ['filtro-cod-compra', 'filtro-cod-cor'].forEach(function(id) {
        document.getElementById(id).addEventListener('keydown', function(e) {
          if (e.key === 'Enter') { e.preventDefault(); buscarEstoque(); }
        });
      });

      // ---------- Autocomplete de produto por nome ----------
      var inputNome = document.getElementById('filtro-nome-produto');
      var hiddenCod = document.getElementById('filtro-cod-produto');
      var $lista = $('#produtos_list');
      var apiUrl = '/collaborators_backoffice/buscas/buscar_produtos';

      function buscarProdutos() {
        var query = inputNome.value.trim();
        // Ao digitar, o codigo anterior deixa de valer ate nova selecao
        hiddenCod.value = '';

        if (query.length < 2) { $lista.empty().hide(); return; }

        $.ajax({
          url: apiUrl,
          method: 'GET',
          data: { entidade: 'Produto', query: query },
          success: function(data) {
            $lista.empty();
            data.forEach(function(product) {
              var item = $('<div>').text(product.produto)
                                   .addClass('list-group-item list-group-item-action')
                                   .css('cursor', 'pointer');
              item.data('cod_produto', product.cod_produto);
              item.data('produto', product.produto);
              $lista.append(item);
            });
            $lista.toggle(data.length > 0);
          },
          error: function(err) { console.error('Erro na busca de produtos:', err); }
        });
      }

      // Seleciona produto ao clicar
      $lista.on('click', 'div.list-group-item', function() {
        hiddenCod.value = $(this).data('cod_produto');
        inputNome.value = $(this).data('produto');
        $lista.empty().hide();
      });

      // Debounce simples na digitacao
      var timer = null;
      inputNome.addEventListener('input', function() {
        clearTimeout(timer);
        timer = setTimeout(buscarProdutos, 250);
      });

      inputNome.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          // Se ja houver um codigo selecionado, busca o estoque; senao dispara a busca por nome
          if (hiddenCod.value) { buscarEstoque(); } else { buscarProdutos(); }
        } else if (e.key === 'Escape') {
          $lista.empty().hide();
        }
      });

      // Esconde a lista ao clicar fora
      document.addEventListener('click', function(e) {
        if (!e.target.closest('#produtos_list') && e.target !== inputNome) {
          $lista.hide();
        }
      });
    });

    function salvarDados(estoqueId) {
      const inputValor = document.querySelector(`.editable-valor-venda[data-id="${estoqueId}"]`);
      const inputQtdMin = document.querySelector(`.editable-qtd-minima[data-id="${estoqueId}"]`);

      if (!inputValor || !inputQtdMin) {
        console.error("Erro: Inputs não encontrados.");
        return;
      }

      let valor = inputValor.value.trim();
      let qtdMinima = inputQtdMin.value.trim();

      if (!valor && !qtdMinima) return;

      // Converte de formato brasileiro para formato numérico (troca vírgula por ponto)
      const valorFormatado = valor.replace(/\./g, "").replace(",", ".");

      fetch(`/collaborators_backoffice/empresa_estoque/${estoqueId}`, {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content,
        },
        body: JSON.stringify({ estoque: { valorvenda: valorFormatado, quantidademinima: qtdMinima, id_compra: estoqueId } }),
      })
      .then(response => response.ok ? response.json() : Promise.reject("Erro ao salvar"))
      .then(data => {
        $.bootstrapGrowl(data.message, {
          ele: 'body',
          type: 'success',
          offset: { from: 'top', amount: 60 },
          align: 'center',
          width: 300,
          delay: 3000,
          allow_dismiss: false,
          stackup_spacing: 40,
        });
        console.log("Valor atualizado com sucesso:", data);

      })
      .catch(error => {
        $.bootstrapGrowl("Erro ao salvar. Tente novamente.", { type: 'danger' });
        console.error("Erro:", error);
      });
    }

    document.addEventListener("DOMContentLoaded", function() {
      document.querySelectorAll(".salvar-dados").forEach(button => {
        button.addEventListener("click", function() {
          const estoqueId = this.dataset.id;
          salvarDados(estoqueId); // Chama a função ao clicar no botão
        });
      });
    });

    document.addEventListener("DOMContentLoaded", function() {
      document.querySelectorAll(".editable-valor-venda, .editable-qtd-minima").forEach(input => {
        input.addEventListener("keydown", function(event) {
          if (event.key === "Enter") {
            event.preventDefault(); // Evita quebra de linha
            const estoqueId = this.dataset.id;
            salvarDados(estoqueId); // Chama a função ao pressionar Enter
          }
        });
      });
    });

    // ---------- Utilidades de valor ----------
    // Converte "1.234,56" (BR) para número
    function parseBR(valor) {
      if (valor == null) return 0;
      const v = String(valor).trim().replace(/\./g, "").replace(",", ".");
      const n = parseFloat(v);
      return isNaN(n) ? 0 : n;
    }
    // Formata número para "1234,56" (sem separador de milhar, como no input)
    function formatBR(n) {
      return n.toFixed(2).replace(".", ",");
    }
    // Arredonda para cima ao próximo múltiplo de 5 (ex.: 564,33 -> 565 ; 567,77 -> 570)
    function arredondarParaCima(n) {
      return Math.ceil(n / 5) * 5;
    }

    document.addEventListener("DOMContentLoaded", function() {
      // ---------- Arredondar Vl Venda ao marcar o checkbox ----------
      const chkArredondar = document.getElementById("chk-arredondar");
      if (chkArredondar) {
        chkArredondar.addEventListener("change", function() {
          if (!this.checked) return; // só age ao marcar
          document.querySelectorAll(".editable-valor-venda").forEach(function(input) {
            const atual = parseBR(input.value);
            if (atual > 0) input.value = formatBR(arredondarParaCima(atual));
          });
          $.bootstrapGrowl("Valores arredondados. Confira e clique em Salvar todos.", {
            ele: 'body', type: 'info', offset: { from: 'top', amount: 60 },
            align: 'center', width: 320, delay: 3000
          });
        });
      }

      // ---------- TAB pula para o Vl Venda da linha de baixo ----------
      const camposValor = Array.from(document.querySelectorAll(".editable-valor-venda"));
      camposValor.forEach(function(input, idx) {
        input.addEventListener("keydown", function(e) {
          if (e.key === "Tab" && !e.shiftKey) {
            const proximo = camposValor[idx + 1];
            if (proximo) {
              e.preventDefault();
              proximo.focus();
              proximo.select();
            }
          } else if (e.key === "Tab" && e.shiftKey) {
            const anterior = camposValor[idx - 1];
            if (anterior) {
              e.preventDefault();
              anterior.focus();
              anterior.select();
            }
          }
        });
      });

      // ---------- Salvar todos ----------
      const btnSalvarTodos = document.getElementById("btn-salvar-todos");
      if (btnSalvarTodos) {
        btnSalvarTodos.addEventListener("click", function() {
          const itens = [];
          document.querySelectorAll(".editable-valor-venda").forEach(function(inputValor) {
            const id = inputValor.dataset.id;
            const inputQtd = document.querySelector(`.editable-qtd-minima[data-id="${id}"]`);
            itens.push({
              id: id,
              valorvenda: inputValor.value.trim(),
              quantidademinima: inputQtd ? inputQtd.value.trim() : "0"
            });
          });
          if (!itens.length) return;

          btnSalvarTodos.disabled = true;
          fetch("/collaborators_backoffice/empresa_estoque/update_todos", {
            method: "PATCH",
            headers: {
              "Content-Type": "application/json",
              "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
            },
            body: JSON.stringify({ itens: itens })
          })
          .then(r => r.ok ? r.json() : Promise.reject("Erro ao salvar"))
          .then(data => {
            $.bootstrapGrowl(data.message, {
              ele: 'body', type: 'success', offset: { from: 'top', amount: 60 },
              align: 'center', width: 320, delay: 3000
            });
          })
          .catch(err => {
            $.bootstrapGrowl("Erro ao salvar todos. Tente novamente.", { type: 'danger' });
            console.error(err);
          })
          .finally(() => { btnSalvarTodos.disabled = false; });
        });
      }
    });
  </script>