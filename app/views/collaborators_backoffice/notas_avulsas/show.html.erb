<div id="layoutAuthentication_content">
  <main>
    <div class="card mt-3">
      <div class="card-header bg-primary text-white d-flex align-items-center">
        <i class="fa fa-file-invoice me-2"></i>
        <h4 class="mb-0">Nota avulsa #<%= @documento.cod_documento_fiscal %> — <%= @documento.modelo_nome %></h4>
      </div>
      <div class="card-body">
        <% cor = @documento.autorizada? ? "success" : (@documento.cancelada? ? "secondary" : "danger") %>
        <p><strong>Status:</strong> <span class="badge text-bg-<%= cor %>"><%= @documento.status %></span></p>
        <% if @documento.chave_acesso.present? %>
          <p class="text-break"><strong>Chave:</strong> <%= @documento.chave_acesso %></p>
        <% end %>
        <% if @documento.protocolo.present? %>
          <p><strong>Protocolo:</strong> <%= @documento.protocolo %></p>
        <% end %>
        <% if @documento.mensagem_sefaz.present? %>
          <p><strong>Mensagem SEFAZ:</strong> <%= @documento.mensagem_sefaz %></p>
        <% end %>

        <div class="d-flex gap-2 mt-3 flex-wrap">
          <%= link_to "Voltar", collaborators_backoffice_notas_avulsas_path, class: "btn btn-secondary" %>
          <% if @documento.autorizada? && @documento.danfe_base64.present? %>
            <%= link_to "Ver DANFE", danfe_collaborators_backoffice_notas_avulsa_path(@documento), target: "_blank", class: "btn btn-outline-primary" %>
          <% end %>
          <% if @documento.autorizada? %>
            <%= button_to cancelar_collaborators_backoffice_notas_avulsa_path(@documento),
                          method: :post, params: { justificativa: "" }, class: "btn btn-outline-danger",
                          onclick: "var j=prompt('Justificativa do cancelamento (min 15 caracteres):'); if(!j||j.trim().length<15){alert('Justificativa invalida.');return false;} this.closest('form').justificativa.value=j; return confirm('Cancelar esta NF?');" do %>
              <i class="fa fa-ban me-1"></i> Cancelar NF
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </main>
</div>
