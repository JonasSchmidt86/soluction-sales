<% modelo_nome = @modelo == 65 ? "NFC-e (modelo 65)" : "NF-e (modelo 55)" %>
<% itens_preenchidos = @itens_preenchidos || [] %>

<style>
  /* A .table-responsive do Bootstrap aplica overflow (corta o dropdown de busca
     de produto, que e position:absolute). Deixamos o overflow visivel para o
     autocomplete "escapar" da tabela. As colunas sao poucas e cabem; em telas
     estreitas a pagina rola normalmente. */
  .tabela-itens-nf { overflow: visible !important; }
  /* Dropdown de busca de produto por cima de tudo (botoes, painel pendencias). */
  .produto-lista { z-index: 1080; max-height: 260px; overflow-y: auto; }
</style>

<div id="layoutAuthentication_content">
  <main>
    <div class="card mt-3">
      <div class="card-header bg-primary text-white d-flex align-items-center">
        <i class="fa fa-file-invoice me-2"></i>
        <h4 class="mb-0">Emissão avulsa — <span id="modeloNomeLabel"><%= modelo_nome %></span></h4>
        <div class="ms-auto btn-group">
          <%# Troca de modelo via JS (sem recarregar), para NAO perder os dados %>
          <%# ja preenchidos (itens, destinatario, perfis). %>
          <button type="button" id="btnModelo55" data-modelo="55"
                  class="btn btn-sm <%= @modelo == 55 ? 'btn-light' : 'btn-outline-light' %>">NF-e 55</button>
          <button type="button" id="btnModelo65" data-modelo="65"
                  class="btn btn-sm <%= @modelo == 65 ? 'btn-light' : 'btn-outline-light' %>">NFC-e 65</button>
        </div>
      </div>

      <div class="card-body">
        <% if flash[:alert].present? %>
          <div class="alert alert-danger"><%= flash[:alert] %></div>
        <% end %>

        <%# Edicao de rascunho (PATCH update) vs novo (POST create). O botao de %>
        <%# emitir usa a URL de create/update; "Salvar rascunho" aponta via JS. %>
        <%# "Em elaboracao" = rascunho ou erro (falha de validacao local): ambos %>
        <%# editaveis pelo editor. Mantem o nome editando_rascunho no resto da view. %>
        <% editando_rascunho = @documento&.persisted? && %w[rascunho erro].include?(@documento&.status) %>
        <% form_url = editando_rascunho ? collaborators_backoffice_notas_avulsa_path(@documento) : collaborators_backoffice_notas_avulsas_path %>
        <% form_method = editando_rascunho ? :patch : :post %>
        <%= form_with url: form_url, method: form_method, local: true, id: "formAvulsa" do %>
          <%= hidden_field_tag :modelo, @modelo %>
          <% if editando_rascunho %><%= hidden_field_tag :rascunho_id, @documento.cod_documento_fiscal %><% end %>

          <%# ---- Operacao (natureza) e Finalidade ---- %>
          <div class="row mb-3">
            <div class="col-md-6">
              <div class="form-floating">
                <%= select_tag :cod_operacao_fiscal,
                      options_from_collection_for_select(@operacoes, :cod_operacao_fiscal, :nome, @operacao_padrao&.cod_operacao_fiscal),
                      id: "operacaoGeral", class: "form-select" %>
                <label>Operação (natureza)</label>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-floating">
                <%= select_tag :finalidade,
                      options_for_select(@finalidades.map { |cod, nome| ["#{cod} - #{nome}", cod] }, (@finalidade_sel.presence || 1).to_i),
                      class: "form-select" %>
                <label>Finalidade</label>
              </div>
            </div>
          </div>

          <%# ---- Destinatario ---- %>
          <div class="mb-3">
            <label class="form-label fw-semibold">
              Destinatário
              <span id="destObrigatorio" class="text-danger" style="<%= 'display:none;' unless @modelo == 55 %>">*</span>
              <span id="destOpcional" class="text-muted" style="<%= 'display:none;' if @modelo == 55 %>">(opcional)</span>
            </label>
            <div class="position-relative">
              <div class="input-group">
                <%# Na edicao/reexibicao, preenche o campo visivel com o nome do %>
                <%# destinatario ja escolhido (o hidden sozinho nao aparece na tela). %>
                <input type="text" id="clienteBusca" class="form-control"
                       placeholder="Nome ou CPF/CNPJ — digite para buscar" autocomplete="off"
                       value="<%= @nome_pessoa_sel %>">
                <%# Limpa o destinatario manualmente (util na NFC-e sem destinatario). %>
                <button type="button" class="btn btn-outline-secondary" id="btnLimparDestinatario" title="Limpar destinatário">
                  <i class="fa fa-xmark"></i> Limpar
                </button>
              </div>
              <%= hidden_field_tag :cod_pessoa, @cod_pessoa_sel, id: "codPessoa" %>
              <div id="clienteLista" class="list-group position-absolute w-100" style="display:none; z-index:1000;"></div>
            </div>
            <small id="clienteSelecionado" class="text-success"><%= "Selecionado: #{@nome_pessoa_sel}" if @nome_pessoa_sel.present? %></small>
          </div>

          <%# ---- Pagamento + NF referenciada ---- %>
          <div class="row mb-3">
            <div class="col-md-4">
              <div class="form-floating">
                <%= select_tag :forma_pagamento,
                      options_for_select(
                        DocumentoFiscal::FORMAS_PAGAMENTO.map { |cod, nome| ["#{cod} - #{nome}", cod] },
                        (@forma_pagamento_sel.presence || "01")),
                      id: "formaPagamento", class: "form-select" %>
                <label>Forma de pagamento</label>
              </div>
            </div>
            <%# Descricao do pagamento: so aparece/exige quando "99 - Outros". %>
            <div class="col-md-8" id="descricaoPagamentoWrap"
                 style="<%= 'display:none;' unless @forma_pagamento_sel == '99' %>">
              <div class="form-floating">
                <%= text_field_tag :descricao_pagamento, @descricao_pagamento_sel,
                      id: "descricaoPagamento", maxlength: 60, class: "form-control",
                      placeholder: "Descreva a forma de pagamento" %>
                <label>Descrição do pagamento (obrigatória p/ "Outros")</label>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">
              Nota fiscal referenciada
              <span class="text-muted small">(chave de 44 dígitos — devolução / outra saída)</span>
            </label>
            <%= text_field_tag :chave_referenciada, @chave_referenciada_sel,
                  id: "chaveReferenciada", maxlength: 44, class: "form-control font-monospace",
                  placeholder: "Cole a chave de acesso da NF de compra (44 dígitos)",
                  inputmode: "numeric", autocomplete: "off" %>
            <small id="chaveReferenciadaHint" class="text-muted"></small>
          </div>

          <%# ---- Itens (planilha estilo devolucao) ---- %>
          <h5 class="mt-4">Produtos</h5>
          <div class="table-responsive tabela-itens-nf">
            <table class="table table-sm table-bordered align-top">
              <thead class="table-light">
                <tr>
                  <th style="width:28%;">Produto</th>
                  <th>Cor</th>
                  <th style="width:16%;">Perfil tributário</th>
                  <th style="width:9%;">CFOP</th>
                  <th style="width:9%;">Qtd</th>
                  <th style="width:12%;">Vl Unitário</th>
                  <th style="width:12%;">Total</th>
                  <th style="width:40px;"></th>
                </tr>
              </thead>
              <tbody id="itensBody"></tbody>
            </table>
          </div>
          <button type="button" class="btn btn-primary btn-sm" id="addItem">
            <i class="fa fa-plus me-1"></i> Adicionar produto
          </button>

          <div class="text-end mt-3">
            <strong>Total da nota: R$ <span id="totalNota">0,00</span></strong>
          </div>

          <%# ---- Informacoes adicionais ---- %>
          <div class="row mt-4">
            <div class="col-md-6 mb-3">
              <label class="form-label fw-semibold">Informações complementares</label>
              <%= text_area_tag :info_adicional, @info_adicional_sel,
                    id: "infoAdicional", rows: 3, maxlength: 2000, class: "form-control",
                    placeholder: "Observações que aparecem no DANFE (ex.: pedido, condições, garantia)" %>
              <small class="text-muted">Impresso no DANFE (campo infCpl).</small>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label fw-semibold">Observações ao fisco</label>
              <%= text_area_tag :info_adicional_fisco, @info_adicional_fisco_sel,
                    id: "infoAdicionalFisco", rows: 3, maxlength: 2000, class: "form-control",
                    placeholder: "Observações de interesse do fisco (opcional)" %>
              <small class="text-muted">Campo infAdFisco (não aparece para o cliente).</small>
            </div>
          </div>

          <%# Painel de pendencias: lista o que impede a emissao (CFOP, estoque, %>
          <%# dados basicos). Preenchido pelo JS validarNota(). Oculto quando OK. %>
          <div id="painelPendencias" class="alert alert-warning py-2 px-3 mt-3" style="display:none;">
            <strong><i class="fa fa-triangle-exclamation me-1"></i> Pendências para emitir:</strong>
            <ul id="listaPendencias" class="mb-0 mt-1 small"></ul>
          </div>

          <div class="d-flex justify-content-between mt-4">
            <%= link_to "Voltar", collaborators_backoffice_notas_avulsas_path, class: "btn btn-secondary" %>
            <div class="d-flex align-items-center gap-2">
              <span id="avulsaErro" class="text-danger small"></span>
              <%# Pre-visualizar via AJAX: so abre aba quando vem PDF; erro aparece inline. %>
              <button type="button" class="btn btn-outline-info" id="btnPrevisualizar"
                      data-url="<%= previsualizar_collaborators_backoffice_notas_avulsas_path %>">
                <i class="fa fa-file-pdf me-1"></i> Pré-visualizar
              </button>
              <%# Salvar rascunho: nao emite. No NOVO, formaction aponta para %>
              <%# salvar_rascunho; na EDICAO, o form ja posta para update (salva). %>
              <% unless editando_rascunho %>
                <button type="submit" class="btn btn-outline-primary"
                        formaction="<%= salvar_rascunho_collaborators_backoffice_notas_avulsas_path %>"
                        formmethod="post" formnovalidate>
                  <i class="fa fa-floppy-disk me-1"></i> Salvar rascunho
                </button>
              <% end %>
              <% if editando_rascunho %>
                <%# Submit normal: salva as alteracoes (update). %>
                <button type="submit" class="btn btn-outline-success">
                  <i class="fa fa-floppy-disk me-1"></i> Salvar alterações
                </button>
                <%# Emitir num clique: submete o MESMO form com emitir_apos=1, %>
                <%# entao o update salva e emite em sequencia (sem 2 botoes). %>
                <button type="submit" name="emitir_apos" value="1" class="btn btn-success btn-emitir"
                        data-confirm-msg="Salvar e emitir esta nota agora?">
                  <i class="fa fa-check-double me-1"></i> Emitir
                </button>
              <% else %>
                <%# data-confirm-msg (nao data-confirm) para o Rails UJS NAO disparar
                    um segundo confirm; o nosso JS de submit cuida da confirmacao. %>
                <button type="submit" class="btn btn-success btn-emitir" id="emitirBtn"
                        data-confirm-msg="Emitir a <%= modelo_nome %> agora?">
                  <i class="fa fa-check-double me-1"></i> Emitir <span id="emitirBtnLabel"><%= modelo_nome %></span>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>

      </div>
    </div>
  </main>
</div>

<%# Opcoes de perfil (reaproveitadas por item). %>
<% perfil_options = @perfis.map { |p| [p.nome, p.cod_perfil_tributario] } %>

<%# Linha-modelo (template) para novos itens %>
<template id="itemTemplate">
  <tr class="item-row">
    <td class="position-relative">
      <input type="text" class="form-control form-control-sm produto-busca" placeholder="Produto — digite para buscar" autocomplete="off">
      <input type="hidden" class="cod-produto field-cod-produto">
      <input type="hidden" class="field-nome-produto">
      <div class="list-group position-absolute w-100 produto-lista" style="display:none; z-index:1000;"></div>
    </td>
    <td>
      <select class="form-select form-select-sm cod-cor field-cod-cor">
        <option value="">— selecione a cor —</option>
      </select>
    </td>
    <td>
      <select class="form-select form-select-sm field-perfil item-perfil">
        <option value="">—</option>
        <%= options_for_select(perfil_options) %>
      </select>
    </td>
    <td><input type="text" class="form-control form-control-sm item-cfop field-cfop" readonly placeholder="—"></td>
    <td><input type="number" min="0" step="1" value="1" class="form-control form-control-sm qtd field-quantidade"></td>
    <td><input type="text" class="form-control form-control-sm vlunit field-valorunitario" value="0,00"></td>
    <td class="total-item align-middle">R$ 0,00</td>
    <td class="align-middle">
      <button type="button" class="btn btn-outline-danger btn-sm rm-item"><i class="fa fa-trash-can"></i></button>
    </td>
  </tr>
</template>

<%# Itens preenchidos (re-exibidos quando o create falhou). JSON p/ o JS repopular. %>
<script type="application/json" id="itensPreenchidos"><%== itens_preenchidos.to_json %></script>

<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<script>
(function () {
  var base = window.location.origin + '/collaborators_backoffice/';
  var csrf = document.querySelector('meta[name="csrf-token"]')?.content;
  var RESOLVER_URL = "<%= resolver_cfop_collaborators_backoffice_notas_avulsas_path %>";
  var opTopo = document.getElementById('operacaoGeral');
  var codPessoaHidden = document.getElementById('codPessoa');

  // ---------- Troca de modelo (55/65) SEM recarregar a pagina ----------
  // Antes os botoes eram links que recarregavam o /new, apagando tudo que o
  // usuario ja tinha digitado. Agora so atualizamos o hidden :modelo, os textos
  // e o estado do destinatario (obrigatorio no 55 / opcional no 65), mantendo
  // itens, destinatario e perfis preenchidos. O backend decide o resto na emissao.
  (function () {
    var hiddenModelo = document.querySelector('#formAvulsa input[name="modelo"]');
    var btn55 = document.getElementById('btnModelo55');
    var btn65 = document.getElementById('btnModelo65');

    function aplicarModelo(modelo) {
      if (hiddenModelo) hiddenModelo.value = modelo;
      var nome = modelo === '65' ? 'NFC-e (modelo 65)' : 'NF-e (modelo 55)';

      var nomeLabel = document.getElementById('modeloNomeLabel');
      if (nomeLabel) nomeLabel.textContent = nome;
      var emitirLabel = document.getElementById('emitirBtnLabel');
      if (emitirLabel) emitirLabel.textContent = nome;
      var emitirBtn = document.getElementById('emitirBtn');
      if (emitirBtn) emitirBtn.setAttribute('data-confirm-msg', 'Emitir a ' + nome + ' agora?');

      // Destinatario: obrigatorio no 55, opcional no 65. (Nao limpa nem oculta
      // o campo ao trocar de modelo — a limpeza e manual, pelo botao Limpar.)
      var obrig = document.getElementById('destObrigatorio');
      var opc   = document.getElementById('destOpcional');
      if (obrig) obrig.style.display = (modelo === '55') ? '' : 'none';
      if (opc)   opc.style.display   = (modelo === '55') ? 'none' : '';

      // Estado visual dos botoes (claro = selecionado).
      if (btn55) { btn55.className = 'btn btn-sm ' + (modelo === '55' ? 'btn-light' : 'btn-outline-light'); }
      if (btn65) { btn65.className = 'btn btn-sm ' + (modelo === '65' ? 'btn-light' : 'btn-outline-light'); }

      // Operacao automatica pelo modelo: 65 (cupom) = "Venda (NF-c)"; 55 = "Venda
      // (NF-e)". Casa pelo TEXTO da option (o value e o codigo, que varia).
      selecionarOperacaoDoModelo(modelo);
      // Recarrega perfil tributario + CFOP de todos os produtos com a nova
      // operacao (reavalia o fiscal de cada linha ao trocar o modelo).
      recarregarTodasLinhas();
      validarNota(); // destinatario deixa de ser obrigatorio no 65, etc.
    }

    var opSelect = document.getElementById('operacaoGeral');
    function selecionarOperacaoDoModelo(modelo) {
      if (!opSelect) return;
      var alvo = modelo === '65' ? /nf-?c/i : /nf-?e/i; // 65 => NF-c; 55 => NF-e
      var escolhida = null;
      Array.prototype.forEach.call(opSelect.options, function (opt) {
        var txt = (opt.textContent || '').trim();
        // No 55 evita casar "NF-c" (que tambem contem "nf"); exige NAO ser NF-c.
        if (modelo === '55') {
          if (/nf-?e/i.test(txt) && !/nf-?c/i.test(txt)) escolhida = escolhida || opt;
        } else {
          if (/nf-?c/i.test(txt)) escolhida = escolhida || opt;
        }
      });
      if (escolhida && opSelect.value !== escolhida.value) {
        opSelect.value = escolhida.value;
        // Nao dispara 'change' aqui: aplicarModelo chama recarregarTodasLinhas()
        // logo em seguida (recalcula perfil+CFOP), evitando dupla chamada.
      }
    }

    if (btn55) btn55.addEventListener('click', function () { aplicarModelo('55'); });
    if (btn65) btn65.addEventListener('click', function () { aplicarModelo('65'); });
  })();

  // ---------- Destinatario (autocomplete) ----------
  var cliInput = document.getElementById('clienteBusca');
  var cliLista = document.getElementById('clienteLista');
  var cliHidden = document.getElementById('codPessoa');
  var cliSel = document.getElementById('clienteSelecionado');

  // Botao Limpar: zera o destinatario (campo visivel, hidden e o texto).
  var btnLimparDest = document.getElementById('btnLimparDestinatario');
  if (btnLimparDest) {
    btnLimparDest.addEventListener('click', function () {
      if (cliInput)  cliInput.value = '';
      if (cliHidden) cliHidden.value = '';
      if (cliSel)    cliSel.textContent = '';
      if (cliLista)  cliLista.style.display = 'none';
      if (cliInput)  cliInput.focus();
      validarNota(); // destinatario removido -> revalida (55 exige)
    });
  }

  cliInput.addEventListener('input', function () {
    var q = this.value.trim();
    cliHidden.value = ''; cliSel.textContent = '';
    validarNota(); // limpou/alterou o destinatario -> revalida
    if (q.length < 2) { cliLista.style.display = 'none'; return; }
    fetch(base + 'buscas/buscar_pessoas?query=' + encodeURIComponent(q))
      .then(function (r) { return r.json(); })
      .then(function (ps) {
        cliLista.innerHTML = '';
        ps.forEach(function (p) {
          var it = document.createElement('button');
          it.type = 'button'; it.className = 'list-group-item list-group-item-action';
          it.textContent = p.nome + (p.cpf_cnpj ? ' — ' + p.cpf_cnpj : '');
          it.addEventListener('click', function () {
            cliHidden.value = p.cod_pessoa;
            cliInput.value = p.nome;
            cliSel.textContent = 'Selecionado: ' + p.nome;
            cliLista.style.display = 'none';
            // UF do destinatario muda o CFOP (5/6/7) -> recalcula tudo.
            // (forcarPerfil=false: preserva o perfil escolhido em cada linha.)
            document.querySelectorAll('.item-row').forEach(function (row) { resolverLinha(row); });
          });
          cliLista.appendChild(it);
        });
        cliLista.style.display = ps.length ? 'block' : 'none';
      });
  });

  // ---------- Moeda BR ----------
  function parseBR(v) { return parseFloat(String(v).replace(/\./g, '').replace(',', '.')) || 0; }
  function fmtBR(n) { return n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

  function recalc() {
    var total = 0;
    document.querySelectorAll('.item-row').forEach(function (row) {
      var q = parseBR(row.querySelector('.qtd').value);
      var v = parseBR(row.querySelector('.vlunit').value);
      var t = q * v;
      row.querySelector('.total-item').textContent = 'R$ ' + fmtBR(t);
      total += t;
    });
    document.getElementById('totalNota').textContent = fmtBR(total);
  }

  // ---------- Resolucao de perfil + CFOP pela regra (perfil + operacao + UF) ----------
  // forcarPerfil=true: reaplica o perfil da fiscal_produto mesmo que a linha ja
  // tenha um valor (usado ao trocar de modelo/operacao, para "recarregar" o
  // perfil dos produtos). Por padrao (false) so pre-seleciona quando esta vazio,
  // preservando a escolha manual do usuario.
  function resolverLinha(row, forcarPerfil) {
    var pHidden = row.querySelector('.cod-produto');
    var perfil  = row.querySelector('.item-perfil');
    var cfop    = row.querySelector('.item-cfop');
    if (!pHidden || !cfop) return;
    var codProduto = pHidden.value;
    if (!codProduto) { cfop.value = ''; return; }
    var url = RESOLVER_URL + '?cod_produto=' + encodeURIComponent(codProduto) +
              '&cod_perfil_tributario=' + encodeURIComponent(perfil ? perfil.value : '') +
              '&cod_operacao_fiscal=' + encodeURIComponent(opTopo ? opTopo.value : '') +
              '&cod_pessoa=' + encodeURIComponent(codPessoaHidden ? codPessoaHidden.value : '');
    fetch(url, { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json().catch(function () { return null; }); })
      .then(function (d) {
        if (!d) { cfop.value = ''; return; }
        // Aplica o perfil da fiscal_produto: sempre quando forcarPerfil, ou
        // quando a linha ainda nao tem perfil escolhido.
        if (perfil && d.cod_perfil_tributario && (forcarPerfil || !perfil.value)) {
          perfil.value = String(d.cod_perfil_tributario);
        }
        cfop.value = d.cfop ? d.cfop : '';
        validarNota(); // CFOP mudou -> revalida pendencias
      })
      .catch(function (e) { console.error('resolver_cfop:', e); });
  }

  // Le o estoque fiscal (qtdfiscal) da cor atualmente selecionada e guarda na
  // linha (data-qtdfiscal). Usado para validar se a quantidade cabe no saldo.
  function atualizarEstoqueLinha(row) {
    var corSel = row.querySelector('.cod-cor');
    var opt = corSel && corSel.selectedOptions ? corSel.selectedOptions[0] : null;
    if (opt && opt.dataset && opt.dataset.qtdfiscal !== undefined && corSel.value) {
      row.dataset.qtdfiscal = opt.dataset.qtdfiscal;
      row.dataset.temCor = '1';
    } else {
      row.dataset.qtdfiscal = '';
      row.dataset.temCor = corSel && corSel.value ? '1' : '';
    }
  }

  // ---------- Validacao de pendencias (bloqueia o botao Emitir) ----------
  // Fonte de verdade: endpoint /validar no backend (mesma logica da emissao).
  // O front envia o estado do form e exibe TODAS as pendencias (dados basicos,
  // CFOP, CPF/CNPJ, estoque fiscal consolidado). Enquanto houver pendencia (ou
  // enquanto valida), "Emitir" fica desabilitado; "Salvar" permanece ativo.
  var VALIDAR_URL = "<%= validar_collaborators_backoffice_notas_avulsas_path %>";
  var _validarTimer = null;

  // Mapeia o nome do campo (vindo do backend) para o seletor do input na linha.
  var CAMPO_SELETOR = {
    cor:        '.cod-cor',
    quantidade: '.qtd',
    valor:      '.vlunit',
    cfop:       '.item-cfop'
  };

  // Limpa o destaque vermelho de todos os campos (antes de repintar).
  function limparDestaques() {
    document.querySelectorAll('.item-row .is-invalid').forEach(function (el) {
      el.classList.remove('is-invalid');
    });
    var cli = document.getElementById('clienteBusca');
    if (cli) cli.classList.remove('is-invalid');
  }

  // Pinta de vermelho (is-invalid) os campos apontados pelos marcadores.
  function aplicarDestaques(marc) {
    limparDestaques();
    if (!marc) return;
    var linhas = document.querySelectorAll('#itensBody .item-row');
    var itens = marc.itens || {};
    Object.keys(itens).forEach(function (idx) {
      var row = linhas[parseInt(idx, 10)];
      if (!row) return;
      (itens[idx] || []).forEach(function (campo) {
        var sel = CAMPO_SELETOR[campo];
        if (!sel) return;
        var el = row.querySelector(sel);
        if (el) el.classList.add('is-invalid');
      });
    });
    if (marc.destinatario) {
      var cli = document.getElementById('clienteBusca');
      if (cli) cli.classList.add('is-invalid');
    }
  }

  function renderPendencias(pend, marc) {
    var painel = document.getElementById('painelPendencias');
    var lista  = document.getElementById('listaPendencias');
    if (lista) {
      lista.innerHTML = '';
      pend.forEach(function (p) {
        var li = document.createElement('li'); li.textContent = p; lista.appendChild(li);
      });
    }
    if (painel) painel.style.display = pend.length ? '' : 'none';
    aplicarDestaques(marc);
    document.querySelectorAll('.btn-emitir').forEach(function (btn) {
      btn.disabled = pend.length > 0;
      btn.title = pend.length ? 'Resolva as pendências para emitir' : '';
    });
  }

  // Dispara a validacao no backend (debounce). Enquanto a resposta nao volta,
  // desabilita o Emitir por seguranca (evita emitir antes de validar).
  function validarNota() {
    document.querySelectorAll('.btn-emitir').forEach(function (btn) { btn.disabled = true; });
    if (_validarTimer) clearTimeout(_validarTimer);
    _validarTimer = setTimeout(function () {
      var form = document.getElementById('formAvulsa');
      if (!form) return;
      var fd = new FormData(form);
      fd.delete('_method'); // sempre POST para a rota de collection
      fetch(VALIDAR_URL, {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrf || '', 'Accept': 'application/json' },
        body: fd
      })
        .then(function (r) { return r.json().catch(function () { return null; }); })
        .then(function (d) {
          if (!d) { renderPendencias(['Falha ao validar. Tente novamente.'], null); return; }
          renderPendencias(d.pendencias || [], d.marcadores || null);
        })
        .catch(function () { renderPendencias(['Falha de conexão ao validar.'], null); });
    }, 300);
  }

  // Recarrega perfil tributario + CFOP de TODAS as linhas que tem produto.
  // Usado ao trocar o modelo/operacao (reavalia o fiscal de cada produto).
  function recarregarTodasLinhas() {
    document.querySelectorAll('.item-row').forEach(function (row) {
      if (row.querySelector('.cod-produto') && row.querySelector('.cod-produto').value) {
        resolverLinha(row, true);
      }
    });
  }

  // ---------- Itens ----------
  var body = document.getElementById('itensBody');
  var tpl = document.getElementById('itemTemplate');

  function carregarCores(codProduto, selectEl, corSelecionada, row) {
    return fetch(base + 'notas_avulsas/cores_produto?cod_produto=' + encodeURIComponent(codProduto))
      .then(function (r) { return r.json(); })
      .then(function (cores) {
        selectEl.innerHTML = '<option value="">— selecione a cor —</option>';
        cores.forEach(function (c) {
          var o = document.createElement('option');
          var qf = (typeof c.qtdfiscal === 'number') ? c.qtdfiscal : parseFloat(c.qtdfiscal || '0');
          o.value = c.cod_cor;
          o.textContent = c.nmcor + '  (fiscal: ' + fmtBR(qf) + ')';
          o.dataset.valorvenda = c.valorvenda;
          o.dataset.qtdfiscal  = qf;
          o.dataset.quantidade = c.quantidade;
          if (corSelecionada && String(c.cod_cor) === String(corSelecionada)) o.selected = true;
          selectEl.appendChild(o);
        });
        // Abre o select para o usuario escolher a cor assim que o produto entra.
        if (!corSelecionada && cores.length) {
          if (cores.length === 1) {
            selectEl.selectedIndex = 1; // uma cor so: ja seleciona
          }
          try { selectEl.focus(); } catch (e) {}
        }
      });
  }

  function addItem(dados) {
    dados = dados || {};
    var frag = tpl.content.cloneNode(true);
    body.appendChild(frag);
    var row = body.lastElementChild;

    var pInput  = row.querySelector('.produto-busca');
    var pHidden = row.querySelector('.cod-produto');
    var pNome   = row.querySelector('.field-nome-produto');
    var pLista  = row.querySelector('.produto-lista');
    var corSel  = row.querySelector('.cod-cor');
    var perfil  = row.querySelector('.item-perfil');

    pInput.addEventListener('input', function () {
      var q = this.value.trim();
      pHidden.value = ''; pNome.value = '';
      row.querySelector('.item-cfop').value = '';
      if (q.length < 1) { pLista.style.display = 'none'; return; }
      fetch(base + 'buscas/buscar_produtos?entidade=Produto&query=' + encodeURIComponent(q))
        .then(function (r) { return r.json(); })
        .then(function (prods) {
          pLista.innerHTML = '';
          prods.forEach(function (p) {
            var it = document.createElement('button');
            it.type = 'button'; it.className = 'list-group-item list-group-item-action';
            it.textContent = p.produto;
            it.addEventListener('click', function () {
              pHidden.value = p.cod_produto;
              pNome.value = p.produto;
              pInput.value = p.produto;
              pLista.style.display = 'none';
              carregarCores(p.cod_produto, corSel, null, row);
              resolverLinha(row); // CFOP pela regra do perfil + operacao
            });
            pLista.appendChild(it);
          });
          pLista.style.display = prods.length ? 'block' : 'none';
        });
    });

    corSel.addEventListener('change', function () {
      var opt = this.selectedOptions[0];
      if (opt && opt.dataset.valorvenda) {
        var vl = row.querySelector('.vlunit');
        if (parseBR(vl.value) === 0) { vl.value = fmtBR(parseFloat(opt.dataset.valorvenda) || 0); recalc(); }
      }
      // Guarda o estoque fiscal da cor escolhida na linha, para validar a qtd.
      atualizarEstoqueLinha(row);
      validarNota();
    });

    // Trocar o perfil recalcula o CFOP so desta linha.
    if (perfil) perfil.addEventListener('change', function () { resolverLinha(row); });

    row.querySelector('.qtd').addEventListener('input', function () { recalc(); validarNota(); });
    row.querySelector('.vlunit').addEventListener('input', function () { recalc(); validarNota(); });
    row.querySelector('.rm-item').addEventListener('click', function () { row.remove(); reindex(); recalc(); validarNota(); });

    // Pre-popular (re-exibicao apos erro no create).
    if (dados.cod_produto) {
      pHidden.value = dados.cod_produto;
      pNome.value = dados.nome_produto || '';
      pInput.value = dados.nome_produto || ('Produto ' + dados.cod_produto);
      if (perfil && dados.cod_perfil_tributario) perfil.value = dados.cod_perfil_tributario;
      if (dados.quantidade) row.querySelector('.qtd').value = dados.quantidade;
      if (dados.valorunitario) row.querySelector('.vlunit').value = dados.valorunitario;
      if (dados.cfop) row.querySelector('.item-cfop').value = dados.cfop;
      carregarCores(dados.cod_produto, corSel, dados.cod_cor, row).then(function () {
        atualizarEstoqueLinha(row); // estoque fiscal da cor pre-selecionada
        if (!dados.cfop) { resolverLinha(row); } else { validarNota(); }
      });
    }
    return row;
  }

  // Atribui names indexados itens[i][campo] para o Rails montar array de hashes.
  function reindex() {
    document.querySelectorAll('#itensBody .item-row').forEach(function (row, i) {
      row.querySelector('.field-cod-produto').name    = 'itens[' + i + '][cod_produto]';
      row.querySelector('.field-nome-produto').name   = 'itens[' + i + '][nome_produto]';
      row.querySelector('.field-cod-cor').name         = 'itens[' + i + '][cod_cor]';
      row.querySelector('.field-perfil').name          = 'itens[' + i + '][cod_perfil_tributario]';
      row.querySelector('.field-cfop').name            = 'itens[' + i + '][cfop]';
      row.querySelector('.field-quantidade').name      = 'itens[' + i + '][quantidade]';
      row.querySelector('.field-valorunitario').name   = 'itens[' + i + '][valorunitario]';
    });
  }

  document.getElementById('addItem').addEventListener('click', function () { addItem(); reindex(); validarNota(); });

  // Operacao do topo recalcula CFOP de TODAS as linhas.
  if (opTopo) {
    opTopo.addEventListener('change', function () {
      // So recalcula CFOP; preserva perfil escolhido (forcarPerfil=false).
      document.querySelectorAll('.item-row').forEach(function (row) { resolverLinha(row); });
    });
  }

  // Inicializacao: repopula itens preenchidos (apos erro) ou comeca com 1 linha.
  var preenchidos = [];
  try { preenchidos = JSON.parse(document.getElementById('itensPreenchidos').textContent || '[]'); } catch (e) {}
  if (preenchidos.length) {
    preenchidos.forEach(function (i) { addItem(i); });
    // Repopula destinatario selecionado (so o cod; o nome o usuario reconhece).
    var codSel = codPessoaHidden ? codPessoaHidden.value : '';
    if (codSel) cliSel.textContent = 'Destinatário selecionado (cód ' + codSel + ')';
  } else {
    addItem();
  }
  reindex(); recalc(); validarNota(); // estado inicial do botao Emitir

  // ---------- Enter NAO submete o form ----------
  // Nos campos de texto (busca de produto/destinatario, qtd, valor) o Enter
  // dispararia o submit (= emitir a NF). Bloqueia o Enter nesses inputs; o
  // usuario emite so clicando no botao Emitir. (textarea e select nao afetados.)
  document.getElementById('formAvulsa').addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && e.target.tagName === 'INPUT' && e.target.type !== 'submit') {
      e.preventDefault();
    }
  });

  // ---------- Confirm no submit (emitir) — unico ponto de confirmacao ----------
  document.getElementById('formAvulsa').addEventListener('submit', function (e) {
    var btn = e.submitter || document.getElementById('emitirBtn');
    var msg = btn && btn.dataset ? btn.dataset.confirmMsg : null;
    if (msg && !confirm(msg)) { e.preventDefault(); }
  });

  // ---------- Pre-visualizacao via AJAX (nao abre aba em erro) ----------
  var btnPrev = document.getElementById('btnPrevisualizar');
  var out = document.getElementById('avulsaErro');
  if (btnPrev) {
    btnPrev.addEventListener('click', function () {
      var form = document.getElementById('formAvulsa');
      if (!form) return;
      out.textContent = '';
      btnPrev.disabled = true;
      var original = btnPrev.innerHTML;
      btnPrev.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> Gerando...';
      var fd = new FormData(form);
      // Na EDICAO de rascunho o form usa method PATCH (campo oculto _method),
      // que o Rails aplica como method override. A pre-visualizacao e SEMPRE um
      // POST para a rota de collection; sem remover _method, o POST viraria
      // PATCH /notas_avulsas/previsualizar e casaria com update (:id=previsualizar).
      fd.delete('_method');
      fetch(btnPrev.dataset.url, {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrf || '', 'Accept': 'application/pdf, text/html' },
        body: fd
      })
      .then(function (resp) {
        var ct = resp.headers.get('Content-Type') || '';
        // DANFE (NF-e 55) vem em PDF; DANFCE (NFC-e 65) vem em HTML. Abre os dois.
        if (resp.ok && (ct.indexOf('application/pdf') !== -1 || ct.indexOf('text/html') !== -1)) {
          return resp.blob().then(function (blob) {
            var url = URL.createObjectURL(blob);
            window.open(url, '_blank');
            setTimeout(function () { URL.revokeObjectURL(url); }, 60000);
          });
        }
        return resp.json().then(function (j) {
          out.textContent = (j && j.erro) ? j.erro : 'Não foi possível pré-visualizar.';
        }).catch(function () { out.textContent = 'Não foi possível pré-visualizar.'; });
      })
      .catch(function () { out.textContent = 'Falha de conexão ao pré-visualizar.'; })
      .finally(function () { btnPrev.disabled = false; btnPrev.innerHTML = original; });
    });
  }

  // ---------- Cabecalho fiscal: pagamento + NF referenciada ----------
  // Descricao do pagamento so aparece/faz sentido quando "99 - Outros" (xPag).
  (function () {
    var forma = document.getElementById('formaPagamento');
    var wrap  = document.getElementById('descricaoPagamentoWrap');
    var desc  = document.getElementById('descricaoPagamento');
    if (!forma || !wrap) return;
    function toggle() {
      var outros = forma.value === '99';
      wrap.style.display = outros ? '' : 'none';
      if (!outros && desc) desc.value = '';
    }
    forma.addEventListener('change', toggle);
    toggle();
  })();

  // Chave referenciada: aceita so digitos; dica visual do tamanho (precisa 44).
  (function () {
    var chave = document.getElementById('chaveReferenciada');
    var hint  = document.getElementById('chaveReferenciadaHint');
    if (!chave) return;
    function check() {
      var v = (chave.value || '').replace(/\D/g, '').slice(0, 44);
      if (chave.value !== v) chave.value = v; // mantem so digitos
      if (!hint) return;
      if (v.length === 0) { hint.textContent = ''; chave.classList.remove('is-invalid'); return; }
      if (v.length === 44) {
        hint.textContent = 'Chave válida (44 dígitos).';
        hint.className = 'text-success';
        chave.classList.remove('is-invalid');
      } else {
        hint.textContent = v.length + '/44 dígitos.';
        hint.className = 'text-muted';
        chave.classList.add('is-invalid');
      }
    }
    chave.addEventListener('input', check);
    check();
  })();
})();
</script>
