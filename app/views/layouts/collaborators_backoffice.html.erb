    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <%= javascript_include_tag 'collaborators_backoffice' %>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll('[data-target]').forEach(function (trigger) {
          const targetSelector = trigger.getAttribute("data-target");
          const target = document.querySelector(targetSelector);
          if (!target) return;

          // Cria a instância de Collapse
          const collapse = new bootstrap.Collapse(target, {
            toggle: false // evita que abra automaticamente ao iniciar
          });

          // Adiciona o clique no link
          trigger.addEventListener("click", function (e) {
            e.preventDefault();

            if (target.classList.contains("show")) {
              collapse.hide();
            } else {
              collapse.show();
            }
          });
        });
      });
        // -------------------- FUNÇÃO PARA Validar data --------------------------------------------------------
      $(document).on('focus', '.datepicker', function () {
        if (!$(this).data('datepicker')) {
          $(this).datepicker({
            format: 'dd/mm/yyyy',
            autoclose: true,
            todayHighlight: true,
            changeMonth: true,
            changeYear: true
          });
        }
      });

      document.addEventListener("blur", function (event) {

        if (!event.target.classList.contains("datepicker")) return;

        const campo = event.target;
        const valor = campo.value.trim();
        const partes = valor.split('/');

        if (partes.length === 3) {

          let [dia, mes, ano] = partes.map(p => parseInt(p));

          if (!isNaN(dia) && !isNaN(mes) && !isNaN(ano)) {

      const dataTeste = new Date(ano, mes - 1, dia);

      if (
        dataTeste.getFullYear() !== ano ||
        dataTeste.getMonth() !== mes - 1 ||
        dataTeste.getDate() !== dia
      ) {

        const ultimoDia = new Date(ano, mes, 0).getDate();

        campo.value =
          String(ultimoDia).padStart(2, '0') + "/" +
          String(mes).padStart(2, '0') + "/" +
          ano;
      }
          }
        }

      }, true);

        // -------------------- FUNÇÃO PARA RETORNO O ENDEREÇO COM O CEP --------------------------------------------------------
      function removerAcentos(texto) {
        return texto.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
      }
      function buscarEnderecoPorCEP(cepInput) {
        const cepValue = cepInput.value.replace(/\D/g, '');
        if (cepValue.length === 8) {
          fetch(`https://viacep.com.br/ws/${cepValue}/json/`)
          .then(response => response.json())
          .then(data => {
          // Procura os campos dentro do mesmo bloco (fisica/juridica) do CEP digitado,
          // evitando IDs duplicados quando os dois partials estao no DOM.
          const escopo = cepInput.closest('#pessoaFisica, #pessoaJuridica') || document;
          const enderecoInput = escopo.querySelector('[name*="endereco"]');
          const bairroInput = escopo.querySelector('[name*="bairro"]');
          const citySelect = escopo.querySelector('[name*="cod_cidade"]');
          if (!data.erro) {
            if (enderecoInput) {
              enderecoInput.value = removerAcentos((data.logradouro || "").toUpperCase());
            }
            if (bairroInput) {
              bairroInput.value = removerAcentos((data.bairro || "").toUpperCase());
            }
            if (citySelect) {
              const desiredCity = removerAcentos((data.localidade || "").toUpperCase());
              for (let i = 0; i < citySelect.options.length; i++) {
                if (removerAcentos(citySelect.options[i].text.toUpperCase()) === desiredCity) {
                    citySelect.value = citySelect.options[i].value;
                    break;
                }
              }
            }
          } else {
            if (enderecoInput) {
              enderecoInput.value = "";
            }
            if (bairroInput) {
              bairroInput.value = "";
            }
            if (citySelect) {
              citySelect.value = 0;
            }
          }
        })
        . catch(error => console.error('Ocorreu um erro:', error));
        }
      }
          document.addEventListener('DOMContentLoaded', function() {
          // Usa a classe .cep (presente na fisica e na juridica) em vez do id,
          // pois o id "pessoa_cep" fica duplicado com os dois partials no DOM.
          const cepInputs = document.querySelectorAll('input.cep');
          cepInputs.forEach(function(cepInput) {
          cepInput.addEventListener('blur', function() {
          buscarEnderecoPorCEP(cepInput);
          });
          });
          });

          // -------------------- CADASTRO DE PJ PELO CNPJ ---------------------------------------
          // Fluxo ao completar 14 digitos do CNPJ (somente Pessoa Juridica):
          //   1) busca no banco (check_cpf_cnpj); se ja existir, redireciona para edicao;
          //   2) senao, busca na BrasilAPI; se retornar dados, preenche os campos;
          //   3) salva automaticamente (create via AJAX) e transforma o form em edicao,
          //      para que qualquer alteracao posterior seja um UPDATE.
          function growl(mensagem, tipo) {
            if (mensagem && typeof $ !== 'undefined' && $.bootstrapGrowl) {
              $.bootstrapGrowl(mensagem, {
                ele: 'body', type: (tipo || 'info'),
                offset: { from: 'top', amount: 60 }, align: 'center',
                width: 340, delay: 4500, allow_dismiss: true
              });
            }
          }

          function csrfToken() {
            const el = document.querySelector('meta[name="csrf-token"]');
            return el ? el.getAttribute('content') : '';
          }

          // Converte o formulario de "novo" para "edicao" apos o salvamento automatico,
          // para que o proximo submit vire um UPDATE (PATCH) da mesma pessoa.
          function transformarFormEmEdicao(codPessoa) {
            const form = document.getElementById('form_pessoa');
            if (!form || !codPessoa) return;
            form.action = '<%= collaborators_backoffice_pessoas_path %>/' + codPessoa;
            let methodInput = form.querySelector('input[name="_method"]');
            if (!methodInput) {
              methodInput = document.createElement('input');
              methodInput.type = 'hidden';
              methodInput.name = '_method';
              form.appendChild(methodInput);
            }
            methodInput.value = 'patch';
          }

          function preencherCamposEmpresa(escopo, data) {
            const setVal = function(name, value) {
              const el = escopo.querySelector('[name*="' + name + '"]');
              if (el && value) { el.value = value; }
            };
            setVal('[nome]', data.nome);
            setVal('[apelido]', data.apelido);
            setVal('[cep]', data.cep);
            setVal('[endereco]', data.endereco);
            setVal('[numero]', data.numero);
            setVal('[complemento]', data.complemento);
            setVal('[bairro]', data.bairro);
            setVal('[telefone]', data.telefone);
            setVal('[email]', data.email);
            setVal('[dtnascimento]', data.data_abertura);
            const citySelect = escopo.querySelector('[name*="cod_cidade"]');
            if (citySelect && data.cod_cidade) {
              citySelect.value = data.cod_cidade;
            }
          }

          // Salva automaticamente a PJ recem preenchida (create via AJAX) e ja deixa o
          // formulario em modo edicao para ajustes futuros.
          function salvarAutomaticamentePJ(cnpjValue) {
            const form = document.getElementById('form_pessoa');
            if (!form) return;
            // Ja foi salvo nesta sessao de preenchimento? evita duplicar o create.
            if (form.dataset.autoSaved === '1') return;

            const fd = new FormData(form);
            fd.set('pessoa[tipo]', 'J');
            fd.set('pessoa[cpf_cnpj]', cnpjValue);

            fetch('<%= collaborators_backoffice_pessoas_path %>', {
              method: 'POST',
              headers: { 'X-CSRF-Token': csrfToken(), 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
              body: fd
            })
            .then(function(response) {
              return response.json().catch(function() { return null; });
            })
            .then(function(pessoa) {
              if (!pessoa) { growl('Não foi possível salvar automaticamente. Salve manualmente.', 'danger'); return; }
              const codPessoa = pessoa.cod_pessoa;
              if (!codPessoa) {
                growl('Dados encontrados, mas houve um erro ao salvar. Revise e salve manualmente.', 'danger');
                return;
              }
              form.dataset.autoSaved = '1';
              transformarFormEmEdicao(codPessoa);
              growl('Cadastro criado automaticamente a partir do CNPJ. Ajuste o que precisar e salve.', 'success');
            })
            .catch(function(error) {
              console.error('Erro ao salvar automaticamente:', error);
              growl('Não foi possível salvar automaticamente. Salve manualmente.', 'danger');
            });
          }

          function processarCNPJ(cnpjInput) {
            const cnpjValue = cnpjInput.value.replace(/\D/g, '');
            // So dispara quando o CNPJ estiver completo (14 digitos).
            if (cnpjValue.length !== 14) return;

            const escopo = cnpjInput.closest('#pessoaJuridica') || document;

            // 1) Primeiro verifica se ja existe no banco de dados.
            fetch('<%= collaborators_backoffice_pessoas_check_cpf_cnpj_path %>?cpf_cnpj=' + cnpjValue, {
              headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(response) { return response.json().catch(function() { return null; }); })
            .then(function(dbData) {
              if (dbData && dbData.redirect_url) {
                // Ja cadastrado: vai direto para a edicao do registro existente.
                window.location.href = dbData.redirect_url;
                return;
              }

              // 2) Nao existe no banco: busca na BrasilAPI.
              return fetch('<%= collaborators_backoffice_pessoas_buscar_cnpj_path %>?cnpj=' + cnpjValue, {
                headers: { 'Accept': 'application/json' }
              })
              .then(function(response) { return response.json().catch(function() { return null; }); })
              .then(function(apiData) {
                if (!apiData) return;
                if (apiData.status !== 'ok') {
                  growl(apiData.message, 'warning');
                  return;
                }
                // 3) Preenche os campos e salva automaticamente (somente o que veio da API).
                preencherCamposEmpresa(escopo, apiData);
                salvarAutomaticamentePJ(cnpjValue);
              });
            })
            .catch(function(error) { console.error('Erro ao processar CNPJ:', error); });
          }

          document.addEventListener('DOMContentLoaded', function() {
            const cnpjInputs = document.querySelectorAll('#pessoaJuridica input.cnpj');
            cnpjInputs.forEach(function(cnpjInput) {
              cnpjInput.addEventListener('blur', function() {
                processarCNPJ(cnpjInput);
              });
            });
          });
          // ----------------------------------------------------------------------------------
          $(document).ready(function () {
            $('.datepicker').datepicker({
              format: 'dd/mm/yyyy',
              autoclose: true,
              todayHighlight: true,
              changeMonth: true,
              changeYear: true
            });
          });

          function alertModal(mensagem) {
            var modal = document.getElementById('customModal');
            var alertMessage = document.getElementById('alertMessage');
            alertMessage.textContent = mensagem; // Define a mensagem personalizada no alerta
            $(modal).modal('show'); // Abre o modal usando jQuery (Bootstrap requer jQuery para operações com modals)
            setTimeout(function() {
              $(modal).modal('hide');
            }, 2900); // Redireciona após 2.9 segundos (opcional)
          }
          <% if notice %>
            //alertModal('<%= notice %>');
            $.bootstrapGrowl('<%= notice %>', {
              ele: 'body', // which element to append to
              type: 'success', // (null, 'info', 'danger', 'success')
              // offset: {from: 'top', amount: $(window).height() / 2 - 25}, // Meio da tela (altura da janela dividida por 2, menos metade da altura da notificação)
              offset: {from: 'top', amount: 60}, // 'top', or 'bottom'
              align: 'center', // ('left', 'right', or 'center')
              width: 250, // (integer, or 'auto')
              delay: 4000, // Time while the message will be displayed. It's not equivalent to the *demo* timeOut!
              allow_dismiss: false, // If true then will display a cross to close the popup.
              stackup_spacing: 40 // spacing between consecutively stacked growls.
            });
            <% else %>
              <% if alert %>
              $.bootstrapGrowl('<%= alert %>', {
                ele: 'body', // which element to append to
                type: 'danger', // (null, 'info', 'danger', 'success')
                // offset: {from: 'top', amount: $(window).height() / 2 - 25}, // Meio da tela (altura da janela dividida por 2, menos metade da altura da notificação)
                offset: {from: 'top', amount: 60}, // 'top', or 'bottom'
                align: 'center', // ('left', 'right', or 'center')
                width: 250, // (integer, or 'auto')
                delay: 4000, // Time while the message will be displayed. It's not equivalent to the *demo* timeOut!
                allow_dismiss: false, // If true then will display a cross to close the popup.
                stackup_spacing: 40 // spacing between consecutively stacked growls.
              });
            <% end %>
          <% end %>
          // ----------- Horas da PG -------
          var div = document.getElementById("myId");
          // Adicionando ouvinte de clique
          div.addEventListener("click", function () {
            div.innerHTML = "Boas Vendas =)";
          });
          // Criando um intervalo
          var interval = setInterval(function () {
            var date = new Date();
            div.innerHTML = date.toLocaleTimeString();
          }, 1000/* 1s */);
          // --------------------------------
          // deixa Maiuscula o input com class text
          // Só aplica se a empresa estiver com o parametro "maiusculo" ativo (parametrosempresa)
          var CAMPOS_MAIUSCULO = <%= (current_collaborator.respond_to?(:empresa) && current_collaborator.empresa&.maiusculo?) ? 'true' : 'false' %>;

          // Verifica se um campo deve ficar em maiusculo.
          // Regra: por padrao os inputs de texto viram maiusculo, exceto campos com
          // mascara/semantica propria (dinheiro, data, telefone, cnpj/cpf, email) ou
          // marcados explicitamente com a classe "no-upper".
          // Textarea NUNCA e forcado -> area de texto e sempre livre.
          function deveMaiuscular(el) {
            if (!el) { return false; }
            var tag = (el.tagName || '').toLowerCase();
            var tipo = (el.getAttribute('type') || 'text').toLowerCase();

            // textarea sempre livre; só inputs de texto/busca entram
            if (tag !== 'input') { return false; }
            if (['text', 'search'].indexOf(tipo) === -1) { return false; }

            // Classe de escape explicita
            if (el.classList.contains('no-upper')) { return false; }

            // Classes que indicam mascara / valor formatado -> nao maiuscular
            var classesExcluidas = ['money', 'money2', 'datepicker', 'fallback',
                                    'cnpj', 'cpf', 'phone_with_ddd', 'cep', 'email',
                                    'datatable-input'];
            for (var i = 0; i < classesExcluidas.length; i++) {
              if (el.classList.contains(classesExcluidas[i])) { return false; }
            }

            return true;
          }

          $(document).ready(function() {
            if (!CAMPOS_MAIUSCULO) { return; }
            // Delegacao de evento: pega tambem campos inseridos dinamicamente (cocoon, autocomplete, etc.)
            $(document).on('input', 'input', function() {
              if (!deveMaiuscular(this)) { return; }

              const start = this.selectionStart;
              const end   = this.selectionEnd;

              this.value = this.value.toUpperCase();
              try { this.setSelectionRange(start, end); } catch (e) { /* campos sem suporte a seleção */ }
            });
          });
          // tira a sugestão dos campos
          //     $(document).ready(function() {
          //         $("input[type='text']").attr("autocomplete", "off");
          //     });
          function formatarMoeda() {
          var elemento = document.getElementById('valor');
          var valor = elemento.value;
          valor = valor + '';
          valor = parseInt(valor.replace(/[\D]+/g, ''));
          valor = valor + '';
          valor = valor.replace(/([0-9]{2})$/g, ",$1");
          if (valor.length > 6) {
          valor = valor.replace(/([0-9]{3}),([0-9]{2}$)/g, ".$1,$2");
          }
          elemento.value = valor;
          if(valor == 'NaN') elemento.value = '';
          };
          $('.cpf-cnpj').mask('000.000.000-00', {reverse: false});
          // Adiciona um ouvinte de eventos para verificar se é CPF ou CNPJ e aplicar a máscara correta
          $('.cpf-cnpj').on('input', function() {
          var value = $(this).val().replace(/\D/g, '');
          if (value.length > 11) {
          $(this).mask('00.000.000/0000-00', {reverse: true});
          } else {
          $(this).mask('000.000.000-00', {reverse: true});
          }
          });
          // para mascaras gem jquery-mask-pluguin
          $(document).ready(function(){
          $('.date').mask('00/00/0000');
          $('.numero').mask('00000000');
          $('.time').mask('00:00:00');
          $('.date_time').mask('00/00/0000 00:00:00');
          $('.cep').mask('00000-000');
          $('.phone').mask('(00) 0000-0000');
          $('.phone_with_ddd').mask('(00) 0 0000-0000');
          $('.phone_us').mask('(000) 000-0000');
          $('.mixed').mask('AAA 000-S0S');
          $('.cpf').mask('000.000.000-00', {reverse: true});
          $('.cnpj').mask('00.000.000/0000-00', {reverse: true});
          $('.money').mask('000.000.000.000.000,00', {reverse: true});
          $('.money2').mask("000000000,00", {reverse: true});
          $('.ip_address').mask('0ZZ.0ZZ.0ZZ.0ZZ', {
          translation: {
          'Z': {
          pattern: /[0-9]/, optional: true
          }
          }
          });
          $('.ip_address').mask('099.099.099.099');
          $('.percent').mask('##0,00%', {reverse: true});
          $('.clear-if-not-match').mask("00/00/0000", {clearIfNotMatch: true});
          $('.placeholder').mask("00/00/0000", {placeholder: "__/__/____"});
          $('.fallback').mask("00r00r0000", {
          translation: {
          'r': {
          pattern: /[\/]/,
          fallback: '/'
          },
          placeholder: "__/__/____"
          }
          });
          $('.selectonfocus').mask("00/00/0000", {selectOnFocus: true});
          });
          // ------------------ Abre modal de estoque do prouto nas imagens -----------------------------------
          document.addEventListener('DOMContentLoaded', function () {
          const modal = document.getElementById('produto_info');
          if (!modal) return;
          modal.addEventListener('show.bs.modal', function (event) {
          const button = event.relatedTarget;
          const produtoId = button.getAttribute('data-produto-id');
          const produtoNome = button.getAttribute('data-produto-nome');
          const tbody = modal.querySelector('#tabela-cores-body');
          const titulo = modal.querySelector('#modal-produto-titulo');
          const editUrl = `/collaborators_backoffice/produtos/${produtoId}/edit`;
          // Atualiza o título dinamicamente
          //titulo.textContent = `Estoque do produto: ${'<button type="button" class="btn-close" data-bs-dismiss="modal"></button>'}`;
          titulo.innerHTML = `
          Editar produto:
          <a href="${editUrl}" class="btn btn-sm btn-outline-primary ms-3">
      ${produtoNome}
          </a>
          `;
          // Carregamento da tabela
          tbody.innerHTML = `
          <tr>
      <td colspan="3">Carregando...</td>
          </tr>
          `;
          fetch(`/collaborators_backoffice/produtos/${produtoId}/estoque`)
          .then(res => res.json())
          .then(dados => {
          if (dados.length === 0) {
          tbody.innerHTML = `
          <tr>
      <td colspan="3"> ${produtoNome} Sem Estoque.</td>
          </tr>
          `;
          return;
          }
          tbody.innerHTML = "";
          dados.forEach(item => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
          <td class="text-center">${item.id_empresa}</td>
          <td>${item.nome_produto}</td>
          <td>${item.cor}</td>
          <td class="text-center">${item.quantidade}</td>
          `;
          tbody.appendChild(tr);
          });
          })
          .catch(() => {
          tbody.innerHTML = `
          <tr>
      <td colspan="3">Erro ao carregar dados.</td>
          </tr>
          `;
          });
          });
          });
    </script>
  </body>
</html>