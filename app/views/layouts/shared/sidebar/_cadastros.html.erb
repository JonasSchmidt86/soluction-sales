<!-- Colapso: Cadastros -->
<button class="nav-link collapsed sidebar-section-toggle" type="button" data-sidebar-toggle="#collapseOts" aria-expanded="false" aria-controls="collapseOts">
  <div class="sb-nav-link-icon">
    <i class="fa-solid fa-address-book"></i>
  </div>
  Cadastros
  <div class="sb-sidenav-collapse-arrow">
    <i class="fas fa-angle-down"></i>
  </div>
</button>
<div id="collapseOts" class="collapse">
  <nav class="sb-sidenav-menu-nested nav">
    <%= link_to collaborators_backoffice_pessoas_path, class: "nav-link" do %>
