<!-- Colapso: Administração -->
<% if current_collaborator.funcionario.permissao.nivel == 1 %>
  <button class="nav-link collapsed sidebar-section-toggle" type="button" data-sidebar-toggle="#collapseAdministracao" aria-expanded="false" aria-controls="collapseAdministracao">
    <div class="sb-nav-link-icon">
      <i class="fa-solid fa-user-gear"></i>
    </div>
    Administração
    <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
  </button>
  <div class="collapse" id="collapseAdministracao">
    <nav class="sb-sidenav-menu-nested nav">
      <%= link_to collaborators_backoffice_funcionarios_path, class: "nav-link" do %>
        <i class="fa-solid fa-user-tie fa-fw me-2" aria-hidden="true"></i>
        Funcionários
      <% end %>
      <% if current_collaborator.funcionario.permissao.nivel == 1 && current_collaborator.funcionario.cod_funcionario != 82 %>
        <%= link_to collaborators_backoffice_collaborators_path, class:"nav-link" do %>
          <i class="fa-solid fa-users fa-fw me-2" aria-hidden="true"></i>
          Colaboradores
        <% end %>
        <%= link_to collaborators_backoffice_access_roles_path, class:"nav-link" do %>
          <i class="fa-solid fa-shield-halved fa-fw me-2" aria-hidden="true"></i>
          Perfis de Acesso
        <% end %>
      <% end %>
      <% if current_collaborator.id == 1 %>
        <%= link_to collaborators_backoffice_cadinternalframes_path, class: "nav-link" do %>
          <i class="fa-solid fa-table-columns fa-fw me-2" aria-hidden="true"></i>
          Cadastro de Layouts
        <% end %>
      <% end %>
    </nav>
  </div>
<% end %>
