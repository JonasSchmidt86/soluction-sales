<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Orçamento - Acesso restrito</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f3f4f6;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
      }
      .box {
        width: min(420px, 90vw);
        background: white;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        padding: 28px;
      }
      h2 { margin-top: 0; }
      .campo {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 14px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font-size: 18px;
        letter-spacing: 0.12em;
        text-align: center;
        margin: 12px 0 18px;
      }
      .btn {
        width: 100%;
        background: #0d6efd;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: 16px;
        cursor: pointer;
      }
      .erro {
        color: #b91c1c;
        font-weight: bold;
        margin-bottom: 12px;
      }
    </style>
  </head>
  <body>
    <div class="box">
      <h2>Orçamento</h2>
      <p>Informe a senha para visualizar este orçamento.</p>
      <% if local_assigns[:erro].present? %>
        <div class="erro"><%= erro %></div>
      <% end %>
      <% orc = local_assigns[:orcamento] || @orcamento %>
      <form method="post" action="<%= orcamento_publico_path(orc, nome_cliente: orc.pessoa.nome.to_s.parameterize) %>">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <input class="campo" type="password" name="senha" maxlength="4" placeholder="____" autocomplete="off" inputmode="numeric">
        <button class="btn" type="submit">Acessar orçamento</button>
      </form>
    </div>
  </body>
</html>
