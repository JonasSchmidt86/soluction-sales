<div class="container py-5">
  <div class="text-center mb-4">
    <h1 class="display-4">Nosso Portfólio</h1>
    <p class="lead">Conheça todos os nossos produtos</p>
  </div>

  <!-- Barra de busca e filtros -->
  <%= form_with url: portfolio_path, method: :get, local: true, class: "mb-4" do %>
    <div class="row g-2 justify-content-center align-items-end">
      <div class="col-lg-6 col-md-6">
        <label class="form-label small text-muted mb-1">Buscar produto</label>
        <div class="input-group">
          <span class="input-group-text"><i class="fas fa-search"></i></span>
          <%= text_field_tag :q, params[:q], class: "form-control",
                placeholder: "Nome, modelo ou descrição..." %>
        </div>
      </div>
      <div class="col-lg-4 col-md-6">
        <label class="form-label small text-muted mb-1">Categoria</label>
        <%= select_tag :grupo,
              options_from_collection_for_select(@grupos, :cod_grupo, :nome, params[:grupo]),
              include_blank: "Todas", class: "form-select" %>
      </div>
      <div class="col-lg-2 col-md-12 d-grid gap-2 d-md-flex">
        <button type="submit" class="btn btn-primary flex-fill">
          <i class="fas fa-filter me-1"></i>Filtrar
        </button>
        <% if params[:q].present? || params[:grupo].present? %>
          <a href="<%= portfolio_path %>" class="btn btn-outline-secondary" title="Limpar filtros">
            <i class="fas fa-times"></i>
          </a>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if params[:q].present? || params[:grupo].present? %>
    <p class="text-center text-muted small mb-4">
      <%= @produtos.total_count %> produto<%= 's' if @produtos.total_count != 1 %> encontrado<%= 's' if @produtos.total_count != 1 %>
    </p>
  <% end %>

  <div class="row justify-content-center">
    <% if @produtos.present? %>
      <% @produtos.each do |produto| %>
        <% produto.produto_imagens.group_by(&:cod_cor).each do |cod_cor, imagens| %>
          <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
            <div class="card h-100 shadow-sm">
              <div class="position-relative">
                <% if imagens.count > 1 %>
                  <div id="portfolioCarousel<%= produto.cod_produto %>_<%= cod_cor %>" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                      <% imagens.each_with_index do |imagem, index| %>
                        <div class="carousel-item <%= 'active' if index == 0 %>">
                          <div class="watermark-wrap">
                            <%= image_tag(imagem.imagem.variant(resize_to_limit: [600, 500]),
                                  class: "card-img-top portfolio-img", 
                                  data: { images: imagens.map{|img| url_for(img.imagem)}.to_json.html_safe, index: index },
                                  ondblclick: "openImageModal(this)" 
                                ) %>
                          </div>
                        </div>
                      <% end %>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#portfolioCarousel<%= produto.cod_produto %>_<%= cod_cor %>" data-bs-slide="prev">
                      <span class="carousel-control-prev-icon" aria-hidden="true" style="filter: invert(27%) sepia(51%) saturate(2878%) hue-rotate(346deg) brightness(104%) contrast(97%);"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#portfolioCarousel<%= produto.cod_produto %>_<%= cod_cor %>" data-bs-slide="next">
                      <span class="carousel-control-next-icon" aria-hidden="true" style="filter: invert(27%) sepia(51%) saturate(2878%) hue-rotate(346deg) brightness(104%) contrast(97%);"></span>
                    </button>
                  </div>
                <% else %>
                  <div class="watermark-wrap">
                    <%= image_tag(imagens.first.imagem.variant(resize_to_limit: [600, 500]),
                          class: "card-img-top portfolio-img", 
                          data: { images: imagens.map{|img| url_for(img.imagem)}.to_json.html_safe, index: 0 },
                          ondblclick: "openImageModal(this)" 
                        ) %>
                  </div>
                <% end %>
              </div>
              <div class="card-body d-flex flex-column">
                <h5 class="card-title flex-grow-1"><%= truncate(produto.titulo&.capitalize, length: 40) %></h5>
                <div class="mt-auto">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <% valor = produto.valor_site_por_cor(cod_cor).to_f %>
                    <% if valor > 0 %>
                      <span class="text-success fw-bold">R$ <%= number_to_currency(valor, unit: "") %></span>
                    <% else %>
                      <span></span>
                    <% end %>
                    <small class="text-muted"><%= imagens.count %> foto<%= 's' if imagens.count > 1 %></small>
                  </div>
                  <div class="d-grid gap-2">
                    <a href="<%= produto_path(produto.cod_produto, cod_cor) %>" class="btn btn-outline-dark btn-sm">
                      Ver Detalhes
                    </a>
                    <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#portfolioModal<%= produto.cod_produto %>_<%= cod_cor %>">
                      <i class="fab fa-whatsapp me-1"></i>Tenho Interesse
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <div class="col-12 text-center py-5">
        <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
        <% if params[:q].present? || params[:grupo].present? %>
          <p class="lead">Nenhum produto encontrado com esses filtros.</p>
          <a href="<%= portfolio_path %>" class="btn btn-outline-primary">Ver todos os produtos</a>
        <% else %>
          <p class="lead">Nenhum produto disponível no momento.</p>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Paginação -->
  <% if @produtos.respond_to?(:total_pages) && @produtos.total_pages > 1 %>
    <div class="d-flex justify-content-center mt-4">
      <%= paginate @produtos, params: { q: params[:q], grupo: params[:grupo] } %>
    </div>
  <% end %>
</div>
<style>
  .card-text p:first-letter {
    text-transform: uppercase;
  }
  /* Imagem do card: mostra a foto inteira, sem cortar nem deformar */
  .portfolio-img {
    width: 100%;
    height: 250px;
    object-fit: contain;
    background-color: #f7f5f2;
    cursor: zoom-in;
  }
  @media (max-width: 575.98px) {
    .portfolio-img {
      height: 320px;
    }
  }
  /* Marca d'água sobre as fotos do portfólio */
  .watermark-wrap {
    position: relative;
    display: block;
    overflow: hidden;
    height: 250px;
  }
  @media (max-width: 575.98px) {
    .watermark-wrap {
      height: 320px;
    }
  }
  .watermark-wrap img {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
<%= render partial: 'home/shared/image_modal' %>
<!-- Modais para WhatsApp -->
<% if @produtos.present? %>
  <% @produtos.each do |produto| %>
    <% produto.produto_imagens.group_by(&:cod_cor).each do |cod_cor, imagens| %>
      <%= render partial: 'home/shared/whatsapp_modal', locals: { produto: produto, cod_cor: cod_cor, modal_id: "portfolioModal#{produto.cod_produto}_#{cod_cor}" } %>
    <% end %>
  <% end %>
<% end %>